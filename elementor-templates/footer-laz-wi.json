                "html": "<style>\n  :root {\n    --lilac-primary: #54366F;\n    --lilac-dark: #3D2452;\n    --lilac-light: #F5F0FA;\n    --lilac-soft: #D9C9E8;\n    --gold-accent: #C5A46D;\n    --gold-gradient: linear-gradient(135deg, #ECC874 0%, #C59A3F 50%, #9E7422 100%);\n    --font-heading: 'Plus Jakarta Sans', sans-serif;\n    --font-body: 'Plus Jakarta Sans', sans-serif;\n  }\n\n  /* OVERRIDE TOTAL DARI BAWAAN TEMA HELLO ELEMENTOR */\n  footer.site-footer.dynamic-footer,\n  .site-footer.dynamic-footer {\n    max-width: 100% !important;\n    width: 100% !important;\n    margin: 0 !important;\n    box-sizing: border-box !important;\n    font-family: var(--font-body);\n    background: linear-gradient(135deg, #3B1B4F 0%, #4F2D64 60%, #351747 100%);\n    color: #FFFFFF;\n    padding: 48px 32px 30px 32px;\n    font-size: 13.5px;\n    border-top: 3px solid #C5A46D;\n    position: relative;\n    z-index: 10;\n  }\n\n  .footer-content {\n    max-width: 1200px;\n    margin: 0 auto 32px auto;\n    display: grid;\n    grid-template-columns: 1.5fr 1fr 1fr;\n    gap: 36px;\n  }\n\n  .footer-brand h4 {\n    font-size: 20px;\n    font-weight: 800;\n    margin: 0 0 12px 0;\n    color: var(--gold-accent);\n    font-family: var(--font-heading);\n    letter-spacing: 0.5px;\n  }\n\n  .footer-brand p {\n    color: #DDD4E4;\n    line-height: 1.65;\n    font-size: 13.5px;\n    margin: 0;\n  }\n\n  .footer-col h5 {\n    font-size: 15px;\n    font-weight: 700;\n    margin: 0 0 14px 0;\n    color: #FFFFFF;\n    font-family: var(--font-heading);\n  }\n\n  .footer-col ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  .footer-col li {\n    margin-bottom: 10px;\n  }\n\n  .footer-col a {\n    color: #DDD4E4;\n    text-decoration: none;\n    transition: color 0.2s ease;\n  }\n\n  .footer-col a:hover {\n    color: #ECC874;\n  }\n\n  .footer-bottom {\n    max-width: 1200px;\n    margin: 0 auto;\n    border-top: 1px solid rgba(255, 255, 255, 0.15);\n    padding-top: 20px;\n    text-align: center;\n    color: #BBA9CA;\n    font-size: 12.5px;\n  }\n\n  @media (max-width: 768px) {\n    footer.site-footer.dynamic-footer,\n    .site-footer.dynamic-footer {\n      padding: 36px 20px 85px 20px !important;\n    }\n    .footer-content {\n      grid-template-columns: 1fr;\n      gap: 26px;\n      margin-bottom: 24px;\n    }\n  }\n</style>\n\n<footer class=\"site-footer dynamic-footer\" style=\"max-width:100%;width:100%;margin:0;\">\n  <div class=\"footer-content\">\n    <!-- Kolom 1: Profil Organisasi -->\n    <div class=\"footer-brand\">\n      <h4>LAZ WANITA ISLAM</h4>\n      <p>Badan Khusus Organisasi Kemasyarakatan Wanita Islam. Berkhidmat mengangkat harkat perempuan dan ketahanan keluarga berbasis syariat Islam.</p>\n    </div>\n    \n    <!-- Kolom 2: Navigasi Cepat -->\n    <div class=\"footer-col\">\n      <h5>Navigasi</h5>\n      <ul>\n        <li><a href=\"/\">Beranda</a></li>\n        <li><a href=\"/tentang-kami\">Tentang Kami & Sejarah</a></li>\n        <li><a href=\"/program\">Program Pemberdayaan</a></li>\n        <li><a href=\"/tunaikan-zakat\">Tunaikan Zakat & Rekening</a></li>\n      </ul>\n    </div>\n    \n    <!-- Kolom 3: Layanan Donatur Resmi -->\n    <div class=\"footer-col\">\n      <h5>Layanan & Sekretariat</h5>\n      <p style=\"color: #DDD4E4; font-size: 13px; line-height: 1.65; margin: 0;\">\n        Kantor Pusat Wanita Islam<br>\n        Instagram: <a href=\"https://www.instagram.com/laz.wanitaislam\" target=\"_blank\" style=\"color: #DDD4E4; text-decoration: none;\">@laz.wanitaislam</a><br>\n        YouTube: LAZ Wanita Islam Official<br>\n        Email: sapa@laz.wanitaislam.or.id\n      </p>\n    </div>\n  </div>\n  \n  <!-- Copyright Bawah -->\n  <div class=\"footer-bottom\">\n    &copy; 2026 LAZ Wanita Islam. Hak Cipta Dilindungi Undang-Undang.\n  </div>\n</footer>\n"
