              "id": "b787f1d2html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<style>\n    :root {\n      --lilac-primary: #54366F;\n      --lilac-dark: #3D2452;\n      --lilac-light: #F5F0FA;\n      --lilac-soft: #D9C9E8;\n      --gold-accent: #C5A46D;\n      --gold-gradient: linear-gradient(135deg, #E6D2AD 0%, #C5A46D 50%, #9E7D47 100%);\n      --text-dark: #22222B;\n      --text-muted: #666675;\n      --bg-gray: #F8F9FA;\n      --white: #FFFFFF;\n      --border-color: #E6E4EA;\n      --font-heading: 'Playfair Display', serif;\n      --font-body: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body { font-family: var(--font-body); background-color: #181820; color: var(--text-dark); padding: 20px; }\n\n    /* TOOLBAR */\n    .preview-header {\n      max-width: 1240px; margin: 0 auto 20px auto; background: #242430; padding: 14px 24px;\n      border-radius: 14px; display: flex; justify-content: space-between; align-items: center; color: white;\n    }\n    .preview-title { font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px; }\n    .preview-title span { background: var(--lilac-primary); color: white; padding: 3px 10px; border-radius: 6px; font-size: 11px; }\n\n    .nav-page-tabs { display: flex; gap: 8px; }\n    .page-tab-btn {\n      background: #1A1A24; border: 1px solid #3E3E54; color: #CCC; padding: 6px 14px;\n      border-radius: 6px; font-size: 12px; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 6px;\n    }\n    .page-tab-btn.active { background: var(--lilac-primary); border-color: var(--gold-accent); color: white; }\n\n    .view-switcher { display: flex; background: #14141C; padding: 4px; border-radius: 8px; gap: 4px; }\n    .btn-switch {\n      background: transparent; border: none; color: #9A9AA6; padding: 6px 14px; font-size: 12px;\n      font-weight: 600; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 6px;\n    }\n    .btn-switch.active { background: var(--lilac-primary); color: white; }\n\n    /* VIEWPORT */\n    .viewport-wrapper { display: flex; justify-content: center; padding-bottom: 60px; }\n    .device-container { background: white; transition: all 0.3s ease; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.4); }\n    .device-container.desktop-view { width: 100%; max-width: 1200px; border-radius: 12px; overflow: hidden; }\n    .device-container.mobile-view { width: 390px; min-height: 844px; border-radius: 40px; border: 12px solid #2B2B36; overflow: hidden; margin: 20px 0; }\n    \n    .mobile-notch { display: none; width: 140px; height: 24px; background: #2B2B36; position: absolute; top: 0; left: 50%; transform: translateX(-50%); border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; z-index: 1000; }\n    .device-container.mobile-view .mobile-notch { display: block; }\n\n    /* STYLES */\n    .topbar {\n      background: linear-gradient(90deg, #3E1E52 0%, #54366F 50%, #46225B 100%);\n      color: white; padding: 9px 30px; font-size: 12px; display: flex; justify-content: space-between; align-items: center;\n      border-bottom: 1px solid rgba(212, 175, 55, 0.25);\n    }\n    .topbar a { color: #E2D5EC; text-decoration: none; margin-left: 15px; }\n\n    .navbar {\n      display: flex; justify-content: space-between; align-items: center; padding: 16px 30px; background: white;\n      border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 100;\n    }\n    .brand-logo { display: flex; align-items: center; gap: 14px; }\n    .logo-badge {\n      width: 46px; height: 46px; background: linear-gradient(135deg, var(--lilac-primary), var(--lilac-dark));\n      border: 2px solid var(--gold-accent); border-radius: 12px; display: flex; align-items: center; justify-content: center;\n      color: white; font-weight: 800; font-size: 19px; font-family: var(--font-heading);\n    }\n    .brand-text h1 { font-size: 17px; font-weight: 800; color: var(--lilac-dark); line-height: 1.1; font-family: var(--font-heading); }\n    .brand-text span { font-size: 11px; color: var(--text-muted); }\n    .nav-links { display: flex; list-style: none; gap: 24px; align-items: center; }\n    .nav-links a { text-decoration: none; color: var(--text-dark); font-size: 14px; font-weight: 600; }\n    .nav-links a.active { color: var(--lilac-primary); font-weight: 700; }\n    \n    .btn-donasi-header {\n      background: var(--gold-gradient); color: #362203 !important; padding: 10px 22px; border-radius: 20px;\n      font-size: 13px !important; font-weight: 800 !important; box-shadow: 0 4px 15px rgba(197, 154, 63, 0.45);\n      border: 1px solid #C5A46D !important;\n    }\n\n    /* HERO */\n    .page-hero {\n      background: linear-gradient(135deg, #4A2761 0%, #54366F 100%);\n      color: white; padding: 50px 30px; text-align: center;\n    }\n    .page-hero h2 { font-family: var(--font-heading); font-size: 36px; margin-bottom: 10px; font-weight: 700; }\n    .page-hero h2 span { color: #F5D77F; }\n    .page-hero p { font-size: 15px; color: #EBDCF5; max-width: 700px; margin: 0 auto; line-height: 1.6; }\n\n    /* REPORT CONTAINER */\n    .report-container { padding: 50px 30px; max-width: 1000px; margin: 0 auto; }\n    \n    .commit-box {\n      background: #FDF9F0; border-left: 4px solid var(--gold-accent); padding: 20px 24px; border-radius: 0 12px 12px 0;\n      margin-bottom: 36px; font-size: 13px; color: #785612; line-height: 1.7;\n    }\n\n    .report-list { display: flex; flex-direction: column; gap: 16px; }\n\n    .report-item-card {\n      background: white; border: 1px solid var(--border-color); border-radius: 12px; padding: 20px 24px;\n      display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 6px rgba(0,0,0,0.02);\n      transition: all 0.2s;\n    }\n    .report-item-card:hover { border-color: var(--lilac-primary); transform: translateX(3px); }\n\n    .report-left { display: flex; align-items: center; gap: 20px; }\n    .pdf-icon-box {\n      width: 48px; height: 48px; background: #FDE8E8; border-radius: 10px; display: flex; align-items: center;\n      justify-content: center; color: #E02424; font-size: 24px; flex-shrink: 0;\n    }\n    .report-title h4 { font-size: 15px; color: var(--text-dark); margin-bottom: 4px; font-weight: 700; font-family: var(--font-heading); }\n    .report-meta { font-size: 12px; color: var(--text-muted); display: flex; gap: 14px; }\n\n    .btn-download-pdf {\n      background: var(--lilac-light); border: 1px solid var(--lilac-soft); color: var(--lilac-dark);\n      padding: 9px 18px; border-radius: 8px; font-size: 12px; font-weight: 700; text-decoration: none;\n      display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;\n    }\n    .btn-download-pdf:hover { background: var(--lilac-primary); color: white; border-color: var(--lilac-primary); }\n\n    /* FOOTER */\n    .site-footer {\n      background: linear-gradient(135deg, #3B1B4F 0%, #4F2D64 60%, #351747 100%);\n      color: white; padding: 45px 30px 24px 30px; font-size: 13px; border-top: 3px solid #C5A46D;\n    }\n    .footer-content { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 30px; margin-bottom: 30px; }\n    .footer-brand h4 { font-size: 20px; font-weight: 700; margin-bottom: 10px; color: var(--gold-accent); font-family: var(--font-heading); }\n    .footer-brand p { color: #DDD4E4; line-height: 1.6; }\n    .footer-col h5 { font-size: 15px; font-weight: 700; margin-bottom: 12px; color: white; font-family: var(--font-heading); }\n    .footer-col ul { list-style: none; }\n    .footer-col li { margin-bottom: 8px; }\n    .footer-col a { color: #DDD4E4; text-decoration: none; }\n    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.15); padding-top: 16px; text-align: center; color: #BBA9CA; font-size: 12px; }\n\n    .mobile-bottom-bar {\n      display: none; position: sticky; bottom: 0; left: 0; right: 0; background: white;\n      box-shadow: 0 -4px 15px rgba(0,0,0,0.1); padding: 10px 16px; border-top: 1px solid var(--border-color);\n      z-index: 999; justify-content: space-between; gap: 10px;\n    }\n    .btn-mobile-act {\n      flex: 1; padding: 10px; border-radius: 8px; font-size: 13px; font-weight: 700; text-align: center;\n      text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px;\n    }\n    .btn-mobile-donasi { background: var(--gold-gradient); color: #362203; border: 1px solid #C5A46D; font-weight: 800; }\n    .btn-mobile-wa { background: #25D366; color: white; }\n\n    /* MOBILE TWEAKS */\n    .device-container.mobile-view .topbar { display: none; }\n    .device-container.mobile-view .nav-links, .device-container.mobile-view .btn-donasi-header { display: none; }\n    .device-container.mobile-view .navbar { padding: 12px 18px; padding-top: 28px; }\n    .device-container.mobile-view .report-item-card { flex-direction: column; align-items: flex-start; gap: 16px; }\n    .device-container.mobile-view .btn-download-pdf { width: 100%; justify-content: center; }\n    .device-container.mobile-view .footer-content { grid-template-columns: 1fr; gap: 20px; }\n    .device-container.mobile-view .mobile-bottom-bar { display: flex; }\n  </style>\n<header class=\"page-hero\">\n        <h2>Akuntabilitas & <span>Laporan Publik</span></h2>\n        <p>Sebagai wujud transparansi kepada muzaki, mitra, dan publik, seluruh dokumen pertanggungjawaban program dan sidang pleno dapat diakses secara terbuka.</p>\n      </header>\n\n      <!-- REPORT LIST CONTENT -->\n      <main class=\"report-container\">\n        \n        <div class=\"commit-box\">\n          <strong><i class=\"fa-solid fa-shield-halved\"></i> Prinsip Transparansi Pleno 6 Bulanan:</strong><br>\n          LAZ Wanita Islam secara rutin menyelenggarakan Sidang Pleno setiap 6 bulan sekali untuk mempertanggungjawabkan perolehan dana ZIS, capaian program, dan laporan keuangan kepada Pengurus Pusat Wanita Islam serta publik.\n        </div>\n\n        <div class=\"report-list\">\n          \n          <!-- ITEM 1 -->\n          <div class=\"report-item-card\">\n            <div class=\"report-left\">\n              <div class=\"pdf-icon-box\"><i class=\"fa-solid fa-file-pdf\"></i></div>\n              <div class=\"report-title\">\n                <h4>Laporan Pertanggungjawaban Pleno Semester I - 2026</h4>\n                <div class=\"report-meta\">\n                  <span><i class=\"fa-regular fa-calendar\"></i> Juli 2026</span>\n                  <span><i class=\"fa-regular fa-file\"></i> PDF (2.4 MB)</span>\n                  <span><i class=\"fa-solid fa-check-double\" style=\"color: #10B981;\"></i> Dilaporkan ke PP WI</span>\n                </div>\n              </div>\n            </div>\n            <a href=\"#\" class=\"btn-download-pdf\"><i class=\"fa-solid fa-download\"></i> Unduh PDF</a>\n          </div>\n\n          <!-- ITEM 2 -->\n          <div class=\"report-item-card\">\n            <div class=\"report-left\">\n              <div class=\"pdf-icon-box\"><i class=\"fa-solid fa-file-pdf\"></i></div>\n              <div class=\"report-title\">\n                <h4>Laporan Penyaluran Program Modal UMKM Bebas Riba (DIY)</h4>\n                <div class=\"report-meta\">\n                  <span><i class=\"fa-regular fa-calendar\"></i> Mei 2026</span>\n                  <span><i class=\"fa-regular fa-file\"></i> PDF (1.8 MB)</span>\n                  <span><i class=\"fa-solid fa-users\"></i> 35 Mustahik</span>\n                </div>\n              </div>\n            </div>\n            <a href=\"#\" class=\"btn-download-pdf\"><i class=\"fa-solid fa-download\"></i> Unduh PDF</a>\n          </div>\n\n          <!-- ITEM 3 -->\n          <div class=\"report-item-card\">\n            <div class=\"report-left\">\n              <div class=\"pdf-icon-box\"><i class=\"fa-solid fa-file-pdf\"></i></div>\n              <div class=\"report-title\">\n                <h4>Laporan Aksi Tanggap Darurat Bencana & Karhutla</h4>\n                <div class=\"report-meta\">\n                  <span><i class=\"fa-regular fa-calendar\"></i> Maret 2026</span>\n                  <span><i class=\"fa-regular fa-file\"></i> PDF (3.1 MB)</span>\n                  <span><i class=\"fa-solid fa-truck-ramp-box\"></i> Respon Bencana</span>\n                </div>\n              </div>\n            </div>\n            <a href=\"#\" class=\"btn-download-pdf\"><i class=\"fa-solid fa-download\"></i> Unduh PDF</a>\n          </div>\n\n          <!-- ITEM 4 -->\n          <div class=\"report-item-card\">\n            <div class=\"report-left\">\n              <div class=\"pdf-icon-box\"><i class=\"fa-solid fa-file-pdf\"></i></div>\n              <div class=\"report-title\">\n                <h4>Profil Lembaga & Legalitas Yayasan Wanita Islam (Company Profile)</h4>\n                <div class=\"report-meta\">\n                  <span><i class=\"fa-regular fa-calendar\"></i> Edisi Resmi 2026</span>\n                  <span><i class=\"fa-regular fa-file\"></i> PDF (4.5 MB)</span>\n                  <span><i class=\"fa-solid fa-award\"></i> Dokumen Resmi</span>\n                </div>\n              </div>\n            </div>\n            <a href=\"#\" class=\"btn-download-pdf\"><i class=\"fa-solid fa-download\"></i> Unduh PDF</a>\n          </div>\n\n        </div>\n\n      </main>\n\n      "
              }
            }
          ]
        }
      ]
    }
  ]
}