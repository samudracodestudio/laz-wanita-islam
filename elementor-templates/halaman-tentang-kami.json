            {
              "id": "c1188bd2html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<style>\n    :root {\n      --lilac-primary: #54366F;\n      --lilac-dark: #3D2452;\n      --lilac-light: #F5F0FA;\n      --lilac-soft: #D9C9E8;\n      --gold-accent: #C5A46D;\n      --gold-gradient: linear-gradient(135deg, #E6D2AD 0%, #C5A46D 50%, #9E7D47 100%);\n      --text-dark: #22222B;\n      --text-muted: #666675;\n      --bg-gray: #F8F9FA;\n      --white: #FFFFFF;\n      --border-color: #E6E4EA;\n      --font-heading: 'Plus Jakarta Sans', sans-serif;\n      --font-body: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body { font-family: var(--font-body); background-color: #181820; color: var(--text-dark); padding: 20px; }\n\n    /* TOOLBAR CONTROLLER */\n    .preview-header {\n      max-width: 1240px;\n      margin: 0 auto 20px auto;\n      background: #242430;\n      padding: 14px 24px;\n      border-radius: 14px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      color: white;\n    }\n\n    .preview-title { font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px; }\n    .preview-title span { background: var(--lilac-primary); color: white; padding: 3px 10px; border-radius: 6px; font-size: 11px; }\n\n    .nav-page-tabs { display: flex; gap: 8px; }\n    .page-tab-btn {\n      background: #1A1A24;\n      border: 1px solid #3E3E54;\n      color: #CCC;\n      padding: 6px 14px;\n      border-radius: 6px;\n      font-size: 12px;\n      text-decoration: none;\n      font-weight: 600;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      transition: all 0.2s;\n    }\n    .page-tab-btn.active {\n      background: var(--lilac-primary);\n      border-color: var(--gold-accent);\n      color: white;\n    }\n\n    .view-switcher { display: flex; background: #14141C; padding: 4px; border-radius: 8px; gap: 4px; }\n    .btn-switch {\n      background: transparent; border: none; color: #9A9AA6; padding: 6px 14px; font-size: 12px;\n      font-weight: 600; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 6px;\n    }\n    .btn-switch.active { background: var(--lilac-primary); color: white; }\n\n    /* VIEWPORT FRAME */\n    .viewport-wrapper { display: flex; justify-content: center; padding-bottom: 60px; }\n    .device-container { background: white; transition: all 0.3s ease; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.4); }\n    .device-container.desktop-view { width: 100%; max-width: 1200px; border-radius: 12px; overflow: hidden; }\n    .device-container.mobile-view { width: 390px; min-height: 844px; border-radius: 40px; border: 12px solid #2B2B36; overflow: hidden; margin: 20px 0; }\n    \n    .mobile-notch { display: none; width: 140px; height: 24px; background: #2B2B36; position: absolute; top: 0; left: 50%; transform: translateX(-50%); border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; z-index: 1000; }\n    .device-container.mobile-view .mobile-notch { display: block; }\n\n    /* STYLES */\n    .topbar {\n      background: linear-gradient(90deg, #3E1E52 0%, #54366F 50%, #46225B 100%);\n      color: white; padding: 9px 30px; font-size: 12px; display: flex; justify-content: space-between; align-items: center;\n      border-bottom: 1px solid rgba(212, 175, 55, 0.25);\n    }\n    .topbar a { color: #E2D5EC; text-decoration: none; margin-left: 15px; }\n\n    .navbar {\n      display: flex; justify-content: space-between; align-items: center; padding: 16px 30px; background: white;\n      border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 100;\n    }\n    .brand-logo { display: flex; align-items: center; gap: 14px; }\n    .logo-badge {\n      width: 46px; height: 46px; background: linear-gradient(135deg, var(--lilac-primary), var(--lilac-dark));\n      border: 2px solid var(--gold-accent); border-radius: 12px; display: flex; align-items: center; justify-content: center;\n      color: white; font-weight: 800; font-size: 19px; font-family: var(--font-heading);\n    }\n    .brand-text h1 { font-size: 17px; font-weight: 800; color: var(--lilac-dark); line-height: 1.1; font-family: var(--font-heading); }\n    .brand-text span { font-size: 11px; color: var(--text-muted); }\n    .nav-links { display: flex; list-style: none; gap: 24px; align-items: center; }\n    .nav-links a { text-decoration: none; color: var(--text-dark); font-size: 14px; font-weight: 600; }\n    .nav-links a.active { color: var(--lilac-primary); font-weight: 700; }\n    \n    .btn-donasi-header {\n      background: var(--gold-gradient); color: #362203 !important; padding: 10px 22px; border-radius: 20px;\n      font-size: 13px !important; font-weight: 800 !important; box-shadow: 0 4px 15px rgba(197, 154, 63, 0.45);\n      border: 1px solid #C5A46D !important;\n    }\n\n    /* PAGE HEADER BANNER */\n    .page-hero {\n      background: linear-gradient(135deg, #4A2761 0%, #54366F 100%);\n      color: white; padding: 50px 30px; text-align: center; position: relative;\n    }\n    .page-hero h2 { font-family: var(--font-heading); font-size: 36px; margin-bottom: 10px; font-weight: 700; }\n    .page-hero h2 span { color: #F5D77F; }\n    .page-hero p { font-size: 15px; color: #EBDCF5; max-width: 700px; margin: 0 auto; line-height: 1.6; }\n\n    /* CONTENT SECTIONS */\n    .section-content { padding: 50px 30px; }\n    .section-title { font-family: var(--font-heading); font-size: 26px; color: var(--lilac-dark); margin-bottom: 14px; }\n    .section-desc { font-size: 14px; color: var(--text-muted); line-height: 1.7; margin-bottom: 24px; }\n\n    /* MANDATE BOX */\n    .mandate-grid {\n      display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 36px; align-items: center; margin-bottom: 50px;\n    }\n    .mandate-text h3 { font-family: var(--font-heading); font-size: 24px; color: var(--lilac-dark); margin-bottom: 14px; }\n    .mandate-text p { font-size: 14px; color: #4B4B58; line-height: 1.8; margin-bottom: 14px; }\n    \n    .mandate-highlight-card {\n      background: #FDF9F0; border-left: 4px solid var(--gold-accent); padding: 18px 20px; border-radius: 0 12px 12px 0;\n      margin-top: 16px; font-size: 13px; color: #7B5915; line-height: 1.6;\n    }\n\n    .org-relation-card {\n      background: var(--lilac-light); border: 2px dashed #CBB8DC; border-radius: 16px; padding: 30px 24px; text-align: center;\n    }\n    .org-badge {\n      display: inline-block; background: var(--lilac-primary); color: white; font-size: 11px; font-weight: 700;\n      padding: 4px 12px; border-radius: 20px; margin-bottom: 14px;\n    }\n\n    /* VISI MISI */\n    .visi-misi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 50px; }\n    .vm-card {\n      background: white; border: 1px solid var(--border-color); border-radius: 14px; padding: 30px;\n      box-shadow: 0 4px 15px rgba(0,0,0,0.03);\n    }\n    .vm-card h4 { font-family: var(--font-heading); font-size: 20px; color: var(--lilac-dark); margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }\n    .vm-card p, .vm-card li { font-size: 14px; color: #555566; line-height: 1.7; }\n    .vm-card ul { padding-left: 20px; margin-top: 10px; }\n    .vm-card li { margin-bottom: 8px; }\n\n    /* STRUKTUR ORGANISASI */\n    .structure-section { background: var(--bg-gray); padding: 50px 30px; border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); }\n    .structure-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; max-width: 1080px; margin: 30px auto 0 auto; }\n    .struct-card { background: white; border: 1px solid var(--border-color); border-radius: 14px; padding: 24px 16px; text-align: center; }\n    .avatar-ph {\n      width: 90px; height: 90px; border-radius: 50%; background: var(--lilac-light); border: 2px solid var(--gold-accent);\n      margin: 0 auto 14px auto; display: flex; align-items: center; justify-content: center; color: var(--lilac-primary); font-size: 24px;\n    }\n    .struct-name { font-size: 14px; font-weight: 700; font-family: var(--font-heading); margin-bottom: 4px; }\n    .struct-role { font-size: 11px; color: var(--lilac-dark); font-weight: 600; background: var(--lilac-soft); display: inline-block; padding: 3px 10px; border-radius: 10px; }\n\n    /* FOOTER & MOBILE BAR */\n    .site-footer {\n      background: linear-gradient(135deg, #3B1B4F 0%, #4F2D64 60%, #351747 100%);\n      color: white; padding: 45px 30px 24px 30px; font-size: 13px; border-top: 3px solid #C5A46D;\n    }\n    .footer-content { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 30px; margin-bottom: 30px; }\n    .footer-brand h4 { font-size: 20px; font-weight: 700; margin-bottom: 10px; color: var(--gold-accent); font-family: var(--font-heading); }\n    .footer-brand p { color: #DDD4E4; line-height: 1.6; }\n    .footer-col h5 { font-size: 15px; font-weight: 700; margin-bottom: 12px; color: white; font-family: var(--font-heading); }\n    .footer-col ul { list-style: none; }\n    .footer-col li { margin-bottom: 8px; }\n    .footer-col a { color: #DDD4E4; text-decoration: none; }\n    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.15); padding-top: 16px; text-align: center; color: #BBA9CA; font-size: 12px; }\n\n    .mobile-bottom-bar {\n      display: none; position: sticky; bottom: 0; left: 0; right: 0; background: white;\n      box-shadow: 0 -4px 15px rgba(0,0,0,0.1); padding: 10px 16px; border-top: 1px solid var(--border-color);\n      z-index: 999; justify-content: space-between; gap: 10px;\n    }\n    .btn-mobile-act {\n      flex: 1; padding: 10px; border-radius: 8px; font-size: 13px; font-weight: 700; text-align: center;\n      text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px;\n    }\n    .btn-mobile-donasi { background: var(--gold-gradient); color: #362203; border: 1px solid #C5A46D; font-weight: 800; }\n    .btn-mobile-wa { background: #25D366; color: white; }\n\n    /* MOBILE VIEW TWEAKS */\n    .device-container.mobile-view .topbar { display: none; }\n    .device-container.mobile-view .nav-links, .device-container.mobile-view .btn-donasi-header { display: none; }\n    .device-container.mobile-view .navbar { padding: 12px 18px; padding-top: 28px; }\n    .device-container.mobile-view .mandate-grid, .device-container.mobile-view .visi-misi-grid { grid-template-columns: 1fr; gap: 20px; }\n    .device-container.mobile-view .structure-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }\n    .device-container.mobile-view .footer-content { grid-template-columns: 1fr; gap: 20px; }\n    .device-container.mobile-view .mobile-bottom-bar { display: flex; }\n  </style>\n<header class=\"page-hero\">\n        <h2>Mengenal <span>LAZ Wanita Islam</span></h2>\n        <p>Lahir dari komitmen panjang ormas Wanita Islam untuk menghadirkan keadilan sosial, kemandirian ekonomi keluarga dhuafa, dan perlindungan anak berbasis syariat Islam.</p>\n      </header>\n\n      \n      <!-- SECTION SAMBUTAN PIMPINAN (HASIL RAPAT TANGGAL 17) -->\n      <section style=\"background: white; padding: 45px 30px; border-bottom: 1px solid var(--border-color);\">\n        <div style=\"max-width: 1040px; margin: 0 auto;\">\n          <div style=\"text-align: center; margin-bottom: 30px;\">\n            <span style=\"font-size: 11px; font-weight: 700; color: var(--gold-accent); text-transform: uppercase; letter-spacing: 0.5px;\">Kata Sambutan</span>\n            <h3 style=\"font-family: var(--font-heading); font-size: 26px; color: var(--lilac-dark); margin-top: 4px;\">Untaian Niat & Amanah Pimpinan</h3>\n          </div>\n          <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 24px;\">\n            \n            <!-- Sambutan 1: Ketua Umum WI -->\n            <div style=\"background: var(--lilac-light); border: 1px solid var(--lilac-soft); border-radius: 14px; padding: 26px;\">\n              <div style=\"display: flex; align-items: center; gap: 14px; margin-bottom: 14px;\">\n                <div style=\"width: 60px; height: 60px; border-radius: 50%; background: white; border: 2px solid var(--gold-accent); display: flex; align-items: center; justify-content: center; color: var(--lilac-primary); font-size: 20px;\">\n                  <i class=\"fa-solid fa-user-shield\"></i>\n                </div>\n                <div>\n                  <h4 style=\"font-family: var(--font-heading); font-size: 16px; color: var(--lilac-dark);\">[ Nama Ketua Umum WI ]</h4>\n                  <span style=\"font-size: 11px; color: var(--text-muted); font-weight: 600;\">Ketua Umum Pengurus Pusat Wanita Islam</span>\n                </div>\n              </div>\n              <p style=\"font-size: 13px; color: #4B4B58; line-height: 1.7; font-style: italic;\">\n                \"Bismillahirrohmanirrohim. Kehadiran LAZ Wanita Islam adalah manifestasi nyata dari tekad kaum ibu untuk mengokohkan ketahanan keluarga muslim Indonesia. Kami titipkan amanah ini agar setiap rupiah dana ZISWAF yang terhimpun mampu membebaskan keluarga dhuafa dari jerat keterpurukan ekonomi.\"\n              </p>\n            </div>\n\n            <!-- Sambutan 2: Direktur LAZ WI -->\n            <div style=\"background: #FDF9F0; border: 1px solid #F4E8D0; border-radius: 14px; padding: 26px;\">\n              <div style=\"display: flex; align-items: center; gap: 14px; margin-bottom: 14px;\">\n                <div style=\"width: 60px; height: 60px; border-radius: 50%; background: white; border: 2px solid var(--gold-accent); display: flex; align-items: center; justify-content: center; color: var(--gold-accent); font-size: 20px;\">\n                  <i class=\"fa-solid fa-user-check\"></i>\n                </div>\n                <div>\n                  <h4 style=\"font-family: var(--font-heading); font-size: 16px; color: #7B5915;\">[ Nama Direktur LAZ ]</h4>\n                  <span style=\"font-size: 11px; color: var(--text-muted); font-weight: 600;\">Direktur Eksekutif LAZ Wanita Islam</span>\n                </div>\n              </div>\n              <p style=\"font-size: 13px; color: #5C4310; line-height: 1.7; font-style: italic;\">\n                \"Menjaga profesionalisme, transparansi audit, dan kepatuhan syariah adalah komitmen mutlak amil kami. Bersama seluruh donatur dan mitra, kami siap melayani mustahik perempuan dan anak-anak Indonesia dengan program pemberdayaan yang terukur dan bermartabat.\"\n              </p>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      <!-- SECTION 1: MANDAT & HUBUNGAN KELEMBAGAAN -->\n      <section class=\"section-content\">\n        <div class=\"mandate-grid\">\n          <div class=\"mandate-text\">\n            <span style=\"font-size: 11px; font-weight: 700; color: var(--gold-accent); text-transform: uppercase;\">Amanah & Sejarah Pendirian</span>\n            <h3>Dari Gerakan Kaum Ibu Menuju Badan Amil Zakat Khusus</h3>\n            <p>Wanita Islam (WI) telah lama berkiprah di tengah masyarakat melalui berbagai aksi nyata: penanganan bencana alam, pendampingan sekolah darurat, hingga pendampingan sosial ekonomi kaum ibu.</p>\n            <p>Melihat tingginya ancaman kemiskinan yang merapuhkan keluarga inti\u2014termasuk maraknya jeratan pinjaman online berbunga tinggi di kalangan ibu rumah tangga\u2014Wanita Islam memandang perlunya **badan khusus pengelola ZIS** yang memiliki fokus tajam pada ketahanan keluarga.</p>\n            \n            <div class=\"mandate-highlight-card\">\n              <strong>Tata Kelola & Pengawasan Berkala:</strong><br>\n              LAZ beroperasi secara otonom dan profesional di bawah regulasi perzakatan nasional, dengan perencanaan tahunan serta pengawasan ketat yang dipertanggungjawabkan dalam <strong>Sidang Pleno 6 Bulanan</strong> kepada Pengurus Pusat Wanita Islam.\n            </div>\n          </div>\n\n          <div class=\"org-relation-card\">\n            <span class=\"org-badge\"><i class=\"fa-solid fa-sitemap\"></i> Hubungan Kelembagaan</span>\n            <div style=\"font-size: 48px; color: var(--lilac-primary); margin-bottom: 10px;\">\n              <i class=\"fa-solid fa-users-rays\"></i>\n            </div>\n            <h4 style=\"font-size: 16px; color: var(--lilac-dark); margin-bottom: 8px; font-family: var(--font-heading);\">Sinergi Ormas Induk & Badan Khusus</h4>\n            <p style=\"font-size: 12px; color: var(--text-muted); line-height: 1.6;\">\n              Logo dan identitas ormas Wanita Islam melekat erat dalam jiwa LAZ sebagai pengingat amanah perjuangan kaum ibu untuk memuliakan keluarga Indonesia.\n            </p>\n          </div>\n        </div>\n\n        <!-- SECTION 2: VISI & MISI -->\n        <div class=\"visi-misi-grid\">\n          <div class=\"vm-card\">\n            <h4><i class=\"fa-solid fa-eye\" style=\"color: var(--gold-accent);\"></i> Visi Lembaga</h4>\n            <p><strong>\"Keluarga, Perempuan, dan Anak Mandiri, Indonesia Bermartabat.\"</strong></p>\n            <p style=\"margin-top: 10px; font-size: 13px;\">\n              Menjadi lembaga filantropi Islam terdepan yang mengokohkan ketahanan keluarga inti dan memandirikan ekonomi kaum perempuan di seluruh pelosok Indonesia.\n            </p>\n          </div>\n\n          <div class=\"vm-card\">\n            <h4><i class=\"fa-solid fa-bullseye\" style=\"color: var(--gold-accent);\"></i> Misi Utama</h4>\n            <ul>\n              <li>Mengelola dana ZISWAF dan CSR secara amanah, transparan, dan profesional sesuai syariat.</li>\n              <li>Memberdayakan UMKM perempuan guna memutus rantai jeratan pinjol dan rentenir.</li>\n              <li>Tanggap darurat bencana dengan prioritas perlindungan ibu, balita, dan lansia.</li>\n              <li>Membangun fasilitas belajar dan sekolah darurat di wilayah marjinal dan terdampak bencana.</li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <!-- SECTION 3: STRUKTUR PENGURUS & DEWAN SYARIAH (Selasa Final) -->\n      <section class=\"structure-section\" id=\"pengurus\">\n        <div style=\"text-align: center; max-width: 600px; margin: 0 auto;\">\n          <h3 style=\"font-family: var(--font-heading); font-size: 26px; color: var(--lilac-dark); margin-bottom: 8px;\">Struktur Kepengurusan & DPS</h3>\n          <p style=\"font-size: 13px; color: var(--text-muted);\">Diisi oleh tokoh perempuan, akademisi, dan alim ulama terpercaya yang menjaga marwah amanah dana umat.</p>\n        </div>\n\n        <div class=\"structure-grid\">\n          <div class=\"struct-card\">\n            <div class=\"avatar-ph\"><i class=\"fa-solid fa-user-tie\"></i></div>\n            <div class=\"struct-name\">[ Nama Dewan Syariah ]</div>\n            <div class=\"struct-role\">Dewan Pengawas Syariah</div>\n            <p style=\"font-size: 11px; color: var(--text-muted); margin-top: 6px;\">Menjaga kepatuhan syariat seluruh akad dan penyaluran ZIS.</p>\n          </div>\n\n          <div class=\"struct-card\">\n            <div class=\"avatar-ph\"><i class=\"fa-solid fa-user-shield\"></i></div>\n            <div class=\"struct-name\">[ Nama Pimpinan WI ]</div>\n            <div class=\"struct-role\">Dewan Pembina / Pengawas</div>\n            <p style=\"font-size: 11px; color: var(--text-muted); margin-top: 6px;\">Perwakilan Pengurus Pusat Ormas Wanita Islam.</p>\n          </div>\n\n          <div class=\"struct-card\">\n            <div class=\"avatar-ph\"><i class=\"fa-solid fa-user-check\"></i></div>\n            <div class=\"struct-name\">[ Nama Direktur Eksekutif ]</div>\n            <div class=\"struct-role\">Direktur / Ketua LAZ</div>\n            <p style=\"font-size: 11px; color: var(--text-muted); margin-top: 6px;\">Penanggung jawab operasional harian dan program.</p>\n          </div>\n\n          <div class=\"struct-card\">\n            <div class=\"avatar-ph\"><i class=\"fa-solid fa-coins\"></i></div>\n            <div class=\"struct-name\">[ Nama Bendahara ]</div>\n            <div class=\"struct-role\">Direktur Keuangan & Amil</div>\n            <p style=\"font-size: 11px; color: var(--text-muted); margin-top: 6px;\">Mengelola akuntabilitas arus kas dan pelaporan audit.</p>\n          </div>\n        </div>\n      </section>\n\n      "
              }
            }
          ]
        }
      ]
    }
  ]
}