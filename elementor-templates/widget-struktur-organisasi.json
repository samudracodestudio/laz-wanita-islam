            {
              "id": "w_html_bagan_organisasi",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!-- ========================================================\n  STRUKTUR ORGANISASI LAZNAS WANITA ISLAM\n  Desain Resmi Selaras Tema Website (Lilac, Gold & White Luxury)\n  100% Responsif di Desktop, Tablet, dan Smartphone\n======================================================== -->\n\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<style>\n  :root {\n    --lilac-primary: #54366F;\n    --lilac-dark: #3D2452;\n    --lilac-light: #F6F1FA;\n    --lilac-soft: #D9C9E8;\n    --lilac-tint: #ECE5F3;\n    --gold-accent: #C5A46D;\n    --gold-gradient: linear-gradient(135deg, #ECC874 0%, #C59A3F 50%, #9E7422 100%);\n    --gold-glow: 0 4px 15px rgba(197, 154, 63, 0.35);\n    --gold-light: #FDF9F0;\n    --text-dark: #22222B;\n    --text-muted: #666675;\n    --border-color: #E6E2ED;\n    --card-bg: #FFFFFF;\n    --font-heading: 'Plus Jakarta Sans', sans-serif;\n    --font-body: 'Plus Jakarta Sans', sans-serif;\n  }\n\n  .lazwi-org-tree-section {\n    font-family: var(--font-body);\n    color: var(--text-dark);\n    background: linear-gradient(180deg, #FFFFFF 0%, #FAF8FC 50%, #FFFFFF 100%);\n    padding: 60px 16px 80px 16px;\n    box-sizing: border-box;\n    width: 100%;\n    margin: 0 auto;\n  }\n\n  .org-tree-container {\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  /* SECTION HEADER */\n  .org-tree-header {\n    text-align: center;\n    max-width: 760px;\n    margin: 0 auto 40px auto;\n  }\n\n  .org-tree-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--lilac-light);\n    color: var(--lilac-primary);\n    font-size: 12px;\n    font-weight: 700;\n    padding: 6px 16px;\n    border-radius: 20px;\n    border: 1px solid var(--lilac-soft);\n    margin-bottom: 12px;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .org-tree-badge i {\n    color: var(--gold-accent);\n  }\n\n  .org-tree-title {\n    font-family: var(--font-heading);\n    font-size: 32px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0 0 12px 0;\n    line-height: 1.25;\n  }\n\n  .org-tree-title span {\n    color: var(--gold-accent);\n  }\n\n  .org-tree-subtitle {\n    font-size: 14.5px;\n    color: var(--text-muted);\n    line-height: 1.6;\n    margin: 0;\n  }\n\n  /* MAIN TREE BOARD */\n  .org-tree-board {\n    background: #FFFFFF;\n    border: 1px solid var(--border-color);\n    border-radius: 24px;\n    padding: 40px 24px;\n    box-shadow: 0 10px 35px rgba(84, 54, 111, 0.05);\n    position: relative;\n  }\n\n  /* FLOW CONNECTORS (DESKTOP) */\n  .tree-line-down {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    height: 32px;\n    position: relative;\n    margin: 4px 0;\n  }\n\n  .tree-line-down::before {\n    content: \"\";\n    width: 2px;\n    height: 100%;\n    background: linear-gradient(180deg, var(--lilac-soft) 0%, var(--gold-accent) 100%);\n  }\n\n  .tree-line-down::after {\n    content: \"\";\n    position: absolute;\n    bottom: -3px;\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--gold-accent);\n  }\n\n  /* BASE NODE CARD STYLING */\n  .tree-node-card {\n    background: #FFFFFF;\n    border: 1px solid var(--border-color);\n    border-radius: 18px;\n    padding: 22px 20px;\n    box-shadow: 0 4px 15px rgba(84, 54, 111, 0.03);\n    transition: all 0.25s ease;\n    display: flex;\n    flex-direction: column;\n    position: relative;\n  }\n\n  .tree-node-card:hover {\n    transform: translateY(-3px);\n    border-color: var(--lilac-primary);\n    box-shadow: 0 12px 28px rgba(84, 54, 111, 0.1);\n  }\n\n  /* CARD TITLE HEADER */\n  .node-header {\n    text-align: center;\n    padding-bottom: 12px;\n    margin-bottom: 14px;\n    border-bottom: 1px solid var(--border-color);\n  }\n\n  .node-role-tag {\n    font-size: 11px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.8px;\n    padding: 3px 12px;\n    border-radius: 12px;\n    display: inline-block;\n    margin-bottom: 6px;\n  }\n\n  .node-title {\n    font-family: var(--font-heading);\n    font-size: 15px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0;\n    text-transform: uppercase;\n    letter-spacing: 0.3px;\n  }\n\n  /* =========================================\n     TIER 1: PEMBINA & PENGAWAS SYARIAH\n  ========================================= */\n  .tree-tier-1 {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 28px;\n  }\n\n  .tree-tier-1 .tree-node-card {\n    background: linear-gradient(180deg, #FAF8FC 0%, #FFFFFF 100%);\n    border-top: 4px solid var(--lilac-primary);\n  }\n\n  .tree-tier-1 .node-role-tag {\n    background: var(--lilac-light);\n    color: var(--lilac-primary);\n    border: 1px solid var(--lilac-soft);\n  }\n\n  .numbered-member-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n\n  .numbered-member-item {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    background: #FFFFFF;\n    border: 1px solid #ECE7F2;\n    padding: 10px 14px;\n    border-radius: 12px;\n    transition: all 0.2s;\n  }\n\n  .numbered-member-item:hover {\n    border-color: var(--gold-accent);\n    background: var(--gold-light);\n  }\n\n  .num-circle {\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    background: var(--lilac-light);\n    color: var(--lilac-primary);\n    font-size: 11px;\n    font-weight: 800;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    border: 1px solid var(--lilac-soft);\n  }\n\n  .member-name-text {\n    font-size: 13.5px;\n    font-weight: 700;\n    color: var(--text-dark);\n    line-height: 1.35;\n  }\n\n  /* =========================================\n     TIER 2: DIREKTUR EKSEKUTIF (PROMINENT CENTER)\n  ========================================= */\n  .tree-tier-2 {\n    max-width: 580px;\n    margin: 0 auto;\n    width: 100%;\n  }\n\n  .exec-leader-card {\n    background: linear-gradient(135deg, #FAF7FD 0%, #FFFFFF 100%);\n    border: 2px solid var(--gold-accent);\n    border-radius: 20px;\n    padding: 24px 26px;\n    text-align: center;\n    box-shadow: 0 10px 30px rgba(197, 164, 109, 0.18);\n    position: relative;\n  }\n\n  .exec-badge-pill {\n    background: var(--gold-gradient);\n    color: #362203;\n    font-size: 11px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.6px;\n    padding: 4px 14px;\n    border-radius: 20px;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    margin-bottom: 8px;\n    box-shadow: 0 2px 8px rgba(197, 154, 63, 0.3);\n  }\n\n  .exec-director-title {\n    font-family: var(--font-heading);\n    font-size: 14px;\n    font-weight: 800;\n    color: var(--lilac-primary);\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin: 0 0 6px 0;\n  }\n\n  .exec-director-name {\n    font-family: var(--font-heading);\n    font-size: 20px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0;\n  }\n\n  /* =========================================\n     TIER 3: SEKRETARIS & BENDAHARA\n  ========================================= */\n  .tree-tier-3 {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 32px;\n    max-width: 1040px;\n    margin: 0 auto;\n  }\n\n  .tree-tier-3 .tree-node-card {\n    border-top: 3px solid var(--lilac-primary);\n  }\n\n  .tree-tier-3 .node-role-tag {\n    background: var(--lilac-light);\n    color: var(--lilac-primary);\n  }\n\n  /* LEAD & TEAM ENTRIES */\n  .lead-person-box {\n    background: var(--lilac-light);\n    border: 1px solid var(--lilac-soft);\n    border-radius: 12px;\n    padding: 11px 14px;\n    text-align: center;\n    margin-bottom: 12px;\n  }\n\n  .lead-person-box .lead-label {\n    font-size: 10.5px;\n    font-weight: 700;\n    color: var(--lilac-primary);\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    display: block;\n    margin-bottom: 2px;\n  }\n\n  .lead-person-box .lead-name {\n    font-family: var(--font-heading);\n    font-size: 14.5px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    line-height: 1.35;\n  }\n\n  .subteam-members-list {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n    padding-top: 4px;\n  }\n\n  .subteam-item {\n    font-size: 13px;\n    color: #4A4A58;\n    background: #FAF8FC;\n    border: 1px solid #ECE7F2;\n    padding: 8px 12px;\n    border-radius: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    text-align: center;\n  }\n\n  .subteam-item .bullet {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--gold-accent);\n    flex-shrink: 0;\n  }\n\n  /* =========================================\n     TIER 4: 4 DIREKTORAT PELAKSANA\n  ========================================= */\n  .tree-tier-4 {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 18px;\n  }\n\n  .tree-tier-4 .tree-node-card {\n    background: #FFFFFF;\n    border-top: 3px solid var(--gold-accent);\n  }\n\n  .tree-tier-4 .node-header {\n    min-height: 68px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n\n  .tree-tier-4 .node-role-tag {\n    background: var(--gold-light);\n    color: #8A641E;\n    border: 1px solid rgba(197, 164, 109, 0.4);\n    align-self: center;\n  }\n\n  .tree-tier-4 .node-title {\n    font-size: 12.5px;\n    line-height: 1.35;\n  }\n\n  /* RESPONSIVE DESIGN */\n  @media (max-width: 1024px) {\n    .tree-tier-4 {\n      grid-template-columns: repeat(2, 1fr);\n      gap: 20px;\n    }\n  }\n\n  @media (max-width: 768px) {\n    .org-tree-board {\n      padding: 24px 14px;\n    }\n    .tree-tier-1,\n    .tree-tier-3,\n    .tree-tier-4 {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n    .tree-tier-4 .node-header {\n      min-height: auto;\n    }\n    .org-tree-title {\n      font-size: 24px;\n    }\n    .tree-line-down {\n      height: 22px;\n    }\n  }\n</style>\n\n<section class=\"lazwi-org-tree-section\" id=\"bagan-struktur-organisasi\">\n  <div class=\"org-tree-container\">\n\n    <!-- HEADER TITLE -->\n    <div class=\"org-tree-header\">\n      <div class=\"org-tree-badge\">\n        <i class=\"fa-solid fa-sitemap\"></i> Tata Kelola & Struktur Resmi\n      </div>\n      <h3 class=\"org-tree-title\">STRUKTUR ORGANISASI <span>LAZNAS WANITA ISLAM</span></h3>\n      <p class=\"org-tree-subtitle\">\n        Bagan resmi kepengurusan LAZNAS Wanita Islam dalam memastikan tata kelola ZISWAF yang profesional, amanah, dan berkesinambungan bagi kemandirian keluarga dan perempuan Indonesia.\n      </p>\n    </div>\n\n    <!-- MAIN TREE BOARD -->\n    <div class=\"org-tree-board\">\n\n      <!-- ==============================================\n           TIER 1: PEMBINA & PENGAWAS SYARIAH\n      ============================================== -->\n      <div class=\"tree-tier-1\">\n\n        <!-- KOTAK DEWAN PEMBINA -->\n        <div class=\"tree-node-card\">\n          <div class=\"node-header\">\n            <span class=\"node-role-tag\"><i class=\"fa-solid fa-shield-halved\"></i> Pengarah Lembaga</span>\n            <h4 class=\"node-title\">PEMBINA</h4>\n          </div>\n          <ul class=\"numbered-member-list\">\n            <li class=\"numbered-member-item\">\n              <span class=\"num-circle\">1</span>\n              <span class=\"member-name-text\">Prof. DR. Aliyah Rasyid Baswedan, MA</span>\n            </li>\n            <li class=\"numbered-member-item\">\n              <span class=\"num-circle\">2</span>\n              <span class=\"member-name-text\">Hj. Sri Harti Jauhari, S.Ag., MM</span>\n            </li>\n            <li class=\"numbered-member-item\">\n              <span class=\"num-circle\">3</span>\n              <span class=\"member-name-text\">Dr. Hanip Pujiati</span>\n            </li>\n          </ul>\n        </div>\n\n        <!-- KOTAK DEWAN PENGAWAS SYARIAH -->\n        <div class=\"tree-node-card\">\n          <div class=\"node-header\">\n            <span class=\"node-role-tag\"><i class=\"fa-solid fa-scale-balanced\"></i> Kepatuhan Syariah</span>\n            <h4 class=\"node-title\">PENGAWAS SYARIAH</h4>\n          </div>\n          <ul class=\"numbered-member-list\">\n            <li class=\"numbered-member-item\">\n              <span class=\"num-circle\">1</span>\n              <span class=\"member-name-text\">Dra. Hj. Marfuah Musthofa, M.Pd</span>\n            </li>\n            <li class=\"numbered-member-item\">\n              <span class=\"num-circle\">2</span>\n              <span class=\"member-name-text\">Hj. Lubenah, S.Ag., MM</span>\n            </li>\n            <li class=\"numbered-member-item\">\n              <span class=\"num-circle\">3</span>\n              <span class=\"member-name-text\">Hj. Istianah Hamid, A.Md</span>\n            </li>\n          </ul>\n        </div>\n\n      </div>\n\n      <!-- CONNECTOR LINE DOWN -->\n      <div class=\"tree-line-down\"></div>\n\n      <!-- ==============================================\n           TIER 2: DIREKTUR EKSEKUTIF (PROMINENT CENTER)\n      ============================================== -->\n      <div class=\"tree-tier-2\">\n        <div class=\"exec-leader-card\">\n          <span class=\"exec-badge-pill\"><i class=\"fa-solid fa-star\"></i> Pucuk Pimpinan Lembaga</span>\n          <div class=\"exec-director-title\">DIREKTUR EKSEKUTIF</div>\n          <h4 class=\"exec-director-name\">Hj. Nurfajriah Siregar, S.Ag</h4>\n        </div>\n      </div>\n\n      <!-- CONNECTOR LINE DOWN -->\n      <div class=\"tree-line-down\"></div>\n\n      <!-- ==============================================\n           TIER 3: SEKRETARIS & BENDAHARA\n      ============================================== -->\n      <div class=\"tree-tier-3\">\n\n        <!-- KOTAK SEKRETARIS -->\n        <div class=\"tree-node-card\">\n          <div class=\"node-header\">\n            <span class=\"node-role-tag\"><i class=\"fa-solid fa-signature\"></i> Administrasi & Sekretariat</span>\n            <h4 class=\"node-title\">SEKRETARIS</h4>\n          </div>\n          <div class=\"lead-person-box\">\n            <span class=\"lead-label\">Koordinator / Sekretaris:</span>\n            <div class=\"lead-name\">Hj. Maylan Sholha, ST, MM</div>\n          </div>\n          <div class=\"subteam-members-list\">\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Handayani, SE</span>\n            </div>\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Husnul Amalia Sholiha</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- KOTAK BENDAHARA -->\n        <div class=\"tree-node-card\">\n          <div class=\"node-header\">\n            <span class=\"node-role-tag\"><i class=\"fa-solid fa-coins\"></i> Keuangan & Akuntabilitas</span>\n            <h4 class=\"node-title\">BENDAHARA</h4>\n          </div>\n          <div class=\"lead-person-box\">\n            <span class=\"lead-label\">Koordinator / Bendahara:</span>\n            <div class=\"lead-name\">Imawati Farhan, S.Ag</div>\n          </div>\n          <div class=\"subteam-members-list\">\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Sumiyati</span>\n            </div>\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Novianty Widiastuti, SE</span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- CONNECTOR LINE DOWN -->\n      <div class=\"tree-line-down\"></div>\n\n      <!-- ==============================================\n           TIER 4: 4 DIREKTORAT PELAKSANA\n      ============================================== -->\n      <div class=\"tree-tier-4\">\n\n        <!-- DIREKTORAT 1: PENGHIMPUNAN & PENDAYAGUNAAN -->\n        <div class=\"tree-node-card\">\n          <div class=\"node-header\">\n            <span class=\"node-role-tag\"><i class=\"fa-solid fa-hand-holding-dollar\"></i> Fundraising</span>\n            <h4 class=\"node-title\">DIREKTUR PENGHIMPUNAN & PENDAYAGUNAAN</h4>\n          </div>\n          <div class=\"lead-person-box\">\n            <span class=\"lead-label\">Direktur:</span>\n            <div class=\"lead-name\">Kartika Mayasari, SS</div>\n          </div>\n          <div class=\"subteam-members-list\">\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Husnul Amalia Sholiha</span>\n            </div>\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Arini Hasanah Setiati, S.Pd</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- DIREKTORAT 2: PENDISTRIBUSIAN -->\n        <div class=\"tree-node-card\">\n          <div class=\"node-header\">\n            <span class=\"node-role-tag\"><i class=\"fa-solid fa-truck-fast\"></i> Distribusi</span>\n            <h4 class=\"node-title\">DIREKTUR PENDISTRIBUSIAN</h4>\n          </div>\n          <div class=\"lead-person-box\">\n            <span class=\"lead-label\">Direktur:</span>\n            <div class=\"lead-name\">DRA Sri Watini</div>\n          </div>\n          <div class=\"subteam-members-list\">\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Arliana Mumtaza</span>\n            </div>\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Nindianty Widiastuty</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- DIREKTORAT 3: PENDAYAGUNAAN -->\n        <div class=\"tree-node-card\">\n          <div class=\"node-header\">\n            <span class=\"node-role-tag\"><i class=\"fa-solid fa-seedling\"></i> Program</span>\n            <h4 class=\"node-title\">DIREKTUR PENDAYAGUNAAN</h4>\n          </div>\n          <div class=\"lead-person-box\">\n            <span class=\"lead-label\">Direktur:</span>\n            <div class=\"lead-name\">Dr. Nurahmawati</div>\n          </div>\n          <div class=\"subteam-members-list\">\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Farida Aryani, M.Si</span>\n            </div>\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Hj. Nurbayanti, S.Pd., M.Pd</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- DIREKTORAT 4: TATA KELOLA & OPERASIONAL -->\n        <div class=\"tree-node-card\">\n          <div class=\"node-header\">\n            <span class=\"node-role-tag\"><i class=\"fa-solid fa-sliders\"></i> Operasional</span>\n            <h4 class=\"node-title\">DIREKTUR TATA KELOLA & OPERASIONAL</h4>\n          </div>\n          <div class=\"lead-person-box\">\n            <span class=\"lead-label\">Direktur:</span>\n            <div class=\"lead-name\">Nailus Saadah, S.P.</div>\n          </div>\n          <div class=\"subteam-members-list\">\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Rika Kusum</span>\n            </div>\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Nindianty</span>\n            </div>\n            <div class=\"subteam-item\">\n              <span class=\"bullet\"></span>\n              <span>Puji Tri Wahyuni</span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n</section>\n"
              }
            }
          ]
        }
      ]
    }
  ]
}