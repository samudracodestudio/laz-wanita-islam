        "css_classes": "lazwi-struktur-organisasi-section"
      },
      "elements": [
        {
          "id": "col_struktur_lazwi",
          "elType": "column",
          "isInner": false,
          "settings": {
            "_column_size": 100,
            "_inline_size": null
          },
          "elements": [
            {
              "id": "w_html_struktur",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!-- ========================================================\n  WIDGET STRUKTUR ORGANISASI LAZNAS WANITA ISLAM\n  Desain Hierarki Modern, Anggun, Responsif & Kepatuhan Syariah\n======================================================== -->\n\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<style>\n  :root {\n    --lilac-primary: #54366F;\n    --lilac-dark: #3D2452;\n    --lilac-light: #F5F0FA;\n    --lilac-soft: #D9C9E8;\n    --lilac-tint: #ECE5F3;\n    --gold-accent: #C5A46D;\n    --gold-gradient: linear-gradient(135deg, #ECC874 0%, #C59A3F 50%, #9E7422 100%);\n    --gold-glow: 0 4px 15px rgba(197, 154, 63, 0.4);\n    --gold-light: #FDF7E7;\n    --text-dark: #22222B;\n    --text-muted: #666675;\n    --bg-gray: #F8F9FA;\n    --border-color: #E6E4EA;\n    --font-heading: 'Plus Jakarta Sans', sans-serif;\n    --font-body: 'Plus Jakarta Sans', sans-serif;\n  }\n\n  .lazwi-org-section {\n    font-family: var(--font-body);\n    color: var(--text-dark);\n    background: linear-gradient(180deg, #FFFFFF 0%, #FAF8FC 50%, #FFFFFF 100%);\n    padding: 70px 20px 80px 20px;\n    max-width: 100%;\n    margin: 0 auto;\n    box-sizing: border-box;\n    position: relative;\n    overflow: hidden;\n  }\n\n  .lazwi-org-container {\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  /* HEADER */\n  .org-header {\n    text-align: center;\n    max-width: 780px;\n    margin: 0 auto 50px auto;\n  }\n\n  .org-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--lilac-light);\n    color: var(--lilac-primary);\n    font-size: 12.5px;\n    font-weight: 700;\n    padding: 6px 16px;\n    border-radius: 20px;\n    border: 1px solid var(--lilac-soft);\n    margin-bottom: 14px;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .org-title {\n    font-family: var(--font-heading);\n    font-size: 34px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0 0 14px 0;\n    line-height: 1.25;\n  }\n\n  .org-title span {\n    color: var(--gold-accent);\n  }\n\n  .org-subtitle {\n    font-size: 15px;\n    color: var(--text-muted);\n    line-height: 1.6;\n    margin: 0;\n  }\n\n  /* ORGANOGRAM WRAPPER */\n  .organogram-wrapper {\n    display: flex;\n    flex-direction: column;\n    gap: 40px;\n    position: relative;\n  }\n\n  /* TIER CARD BASE */\n  .org-group-card {\n    background: #FFFFFF;\n    border: 1px solid var(--border-color);\n    border-radius: 20px;\n    padding: 30px 26px;\n    box-shadow: 0 8px 25px rgba(84, 54, 111, 0.05);\n    transition: all 0.3s ease;\n    position: relative;\n  }\n\n  .org-group-card:hover {\n    border-color: var(--lilac-soft);\n    box-shadow: 0 12px 35px rgba(84, 54, 111, 0.1);\n  }\n\n  .org-group-title {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    margin-bottom: 24px;\n    padding-bottom: 14px;\n    border-bottom: 1px solid var(--border-color);\n  }\n\n  .org-group-title i {\n    color: var(--gold-accent);\n    font-size: 18px;\n  }\n\n  .org-group-title h4 {\n    font-family: var(--font-heading);\n    font-size: 17px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n  }\n\n  /* MEMBER GRID INSIDE GROUP */\n  .members-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n    gap: 18px;\n  }\n\n  .member-item {\n    background: var(--bg-gray);\n    border: 1px solid #ECEAEF;\n    border-radius: 14px;\n    padding: 16px 14px;\n    text-align: center;\n    transition: all 0.25s ease;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .member-item:hover {\n    background: #FFFFFF;\n    border-color: var(--lilac-primary);\n    transform: translateY(-3px);\n    box-shadow: 0 6px 18px rgba(84, 54, 111, 0.08);\n  }\n\n  .member-avatar {\n    width: 60px;\n    height: 60px;\n    border-radius: 50%;\n    background: var(--lilac-light);\n    border: 2px solid var(--gold-accent);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--lilac-primary);\n    font-size: 20px;\n    margin-bottom: 12px;\n    box-shadow: 0 4px 10px rgba(197, 164, 109, 0.2);\n  }\n\n  .member-name {\n    font-family: var(--font-heading);\n    font-size: 14.5px;\n    font-weight: 700;\n    color: var(--text-dark);\n    margin-bottom: 4px;\n    line-height: 1.35;\n  }\n\n  .member-tag {\n    font-size: 11.5px;\n    font-weight: 600;\n    color: var(--lilac-primary);\n    background: var(--lilac-tint);\n    padding: 3px 10px;\n    border-radius: 12px;\n    display: inline-block;\n  }\n\n  /* =========================================\n     TIER 1: PEMBINA & PENGAWAS SYARIAH\n  ========================================= */\n  .tier-1-governance {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 26px;\n  }\n\n  .tier-1-governance .org-group-card {\n    border-top: 4px solid var(--gold-accent);\n  }\n\n  /* =========================================\n     TIER 2: DIREKTUR EKSEKUTIF (PROMINENT CENTER)\n  ========================================= */\n  .tier-2-executive {\n    max-width: 680px;\n    margin: 0 auto;\n    width: 100%;\n  }\n\n  .executive-hero-card {\n    background: linear-gradient(135deg, #FAF7FD 0%, #FFFFFF 100%);\n    border: 2px solid var(--lilac-soft);\n    border-radius: 22px;\n    padding: 32px 30px;\n    text-align: center;\n    box-shadow: 0 12px 35px rgba(84, 54, 111, 0.09);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .executive-hero-card::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 5px;\n    background: var(--gold-gradient);\n  }\n\n  .exec-avatar {\n    width: 88px;\n    height: 88px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, var(--lilac-primary), var(--lilac-dark));\n    border: 3px solid var(--gold-accent);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #FFFFFF;\n    font-size: 32px;\n    margin: 0 auto 16px auto;\n    box-shadow: 0 6px 20px rgba(84, 54, 111, 0.25);\n  }\n\n  .exec-role-badge {\n    background: var(--gold-gradient);\n    color: #362203;\n    font-size: 12px;\n    font-weight: 800;\n    padding: 5px 16px;\n    border-radius: 20px;\n    display: inline-block;\n    margin-bottom: 10px;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n    box-shadow: var(--gold-glow);\n  }\n\n  .exec-name {\n    font-family: var(--font-heading);\n    font-size: 22px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0 0 6px 0;\n  }\n\n  .exec-desc {\n    font-size: 13.5px;\n    color: var(--text-muted);\n    margin: 0;\n  }\n\n  /* =========================================\n     TIER 3: SEKRETARIS & BENDAHARA\n  ========================================= */\n  .tier-3-support {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 26px;\n  }\n\n  /* =========================================\n     TIER 4: 4 DIREKTORAT OPERASIONAL & PROGRAM\n  ========================================= */\n  .tier-4-directorates {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n    gap: 22px;\n  }\n\n  .directorate-card {\n    background: #FFFFFF;\n    border: 1px solid var(--border-color);\n    border-radius: 18px;\n    padding: 24px 20px;\n    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.03);\n    transition: all 0.3s ease;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .directorate-card:hover {\n    transform: translateY(-4px);\n    border-color: var(--lilac-primary);\n    box-shadow: 0 12px 30px rgba(84, 54, 111, 0.1);\n  }\n\n  .dir-header {\n    margin-bottom: 18px;\n    padding-bottom: 12px;\n    border-bottom: 1px solid var(--border-color);\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .dir-header-icon {\n    width: 38px;\n    height: 38px;\n    border-radius: 10px;\n    background: var(--lilac-light);\n    color: var(--lilac-primary);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 16px;\n    flex-shrink: 0;\n  }\n\n  .dir-header-title {\n    font-family: var(--font-heading);\n    font-size: 13.5px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    line-height: 1.3;\n    text-transform: uppercase;\n  }\n\n  .dir-members-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n\n  .dir-member-entry {\n    background: var(--bg-gray);\n    padding: 10px 12px;\n    border-radius: 10px;\n    border: 1px solid #EBE9F0;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    transition: all 0.2s;\n  }\n\n  .dir-member-entry:hover {\n    background: #FFFFFF;\n    border-color: var(--lilac-soft);\n  }\n\n  .dir-member-bullet {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: var(--gold-accent);\n    flex-shrink: 0;\n  }\n\n  .dir-member-name {\n    font-size: 13px;\n    font-weight: 700;\n    color: var(--text-dark);\n    line-height: 1.35;\n  }\n\n  /* RESPONSIVE BREAKPOINT */\n  @media (max-width: 900px) {\n    .tier-1-governance,\n    .tier-3-support {\n      grid-template-columns: 1fr;\n    }\n    .org-title {\n      font-size: 26px;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .lazwi-org-section {\n      padding: 50px 14px 60px 14px;\n    }\n    .members-grid {\n      grid-template-columns: 1fr;\n    }\n    .tier-4-directorates {\n      grid-template-columns: 1fr;\n    }\n    .org-group-card {\n      padding: 22px 16px;\n    }\n  }\n</style>\n\n<section class=\"lazwi-org-section\" id=\"struktur-organisasi\">\n  <div class=\"lazwi-org-container\">\n\n    <!-- HEADER -->\n    <div class=\"org-header\">\n      <div class=\"org-badge\"><i class=\"fa-solid fa-sitemap\"></i> Tata Kelola Profesional & Amanah</div>\n      <h3 class=\"org-title\">Struktur Organisasi <span>LAZNAS Wanita Islam</span></h3>\n      <p class=\"org-subtitle\">\n        Dikelola secara profesional, akuntabel, dan berintegritas tinggi oleh jajaran tokoh perempuan nasional, akademisi, dan alim ulama terpercaya.\n      </p>\n    </div>\n\n    <!-- ORGANOGRAM FLOW -->\n    <div class=\"organogram-wrapper\">\n\n      <!-- ==========================================\n           TIER 1: PEMBINA & PENGAWAS SYARIAH\n      ========================================== -->\n      <div class=\"tier-1-governance\">\n\n        <!-- DEWAN PEMBINA -->\n        <div class=\"org-group-card\">\n          <div class=\"org-group-title\">\n            <i class=\"fa-solid fa-shield-halved\"></i>\n            <h4>Dewan Pembina</h4>\n          </div>\n          <div class=\"members-grid\">\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-user-graduate\"></i></div>\n              <div class=\"member-name\">Prof. DR. Aliyah Rasyid Baswedan, MA</div>\n              <span class=\"member-tag\">Pembina</span>\n            </div>\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-user-shield\"></i></div>\n              <div class=\"member-name\">Hj. Sri Harti Jauhari, S.Ag., MM</div>\n              <span class=\"member-tag\">Pembina</span>\n            </div>\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-user-check\"></i></div>\n              <div class=\"member-name\">Dr. Hanip Pujiati</div>\n              <span class=\"member-tag\">Pembina</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- DEWAN PENGAWAS SYARIAH -->\n        <div class=\"org-group-card\">\n          <div class=\"org-group-title\">\n            <i class=\"fa-solid fa-scale-balanced\"></i>\n            <h4>Dewan Pengawas Syariah</h4>\n          </div>\n          <div class=\"members-grid\">\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-book-quran\"></i></div>\n              <div class=\"member-name\">Dra. Hj. Marfuah Musthofa, M.Pd</div>\n              <span class=\"member-tag\">Pengawas Syariah</span>\n            </div>\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-book-quran\"></i></div>\n              <div class=\"member-name\">Hj. Lubenah, S.Ag., MM</div>\n              <span class=\"member-tag\">Pengawas Syariah</span>\n            </div>\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-book-quran\"></i></div>\n              <div class=\"member-name\">Hj. Istianah Hamid, A.Md</div>\n              <span class=\"member-tag\">Pengawas Syariah</span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- ==========================================\n           TIER 2: DIREKTUR EKSEKUTIF (PROMINENT CENTER)\n      ========================================== -->\n      <div class=\"tier-2-executive\">\n        <div class=\"executive-hero-card\">\n          <div class=\"exec-avatar\"><i class=\"fa-solid fa-user-tie\"></i></div>\n          <span class=\"exec-role-badge\"><i class=\"fa-solid fa-star\"></i> Pucuk Pimpinan Eksekutif</span>\n          <h4 class=\"exec-name\">Hj. Nurfajriah Siregar, S.Ag</h4>\n          <p class=\"exec-desc\">Direktur Eksekutif LAZNAS Wanita Islam</p>\n        </div>\n      </div>\n\n      <!-- ==========================================\n           TIER 3: SEKRETARIS & BENDAHARA\n      ========================================= -->\n      <div class=\"tier-3-support\">\n\n        <!-- SEKRETARIS -->\n        <div class=\"org-group-card\">\n          <div class=\"org-group-title\">\n            <i class=\"fa-solid fa-signature\"></i>\n            <h4>Sekretaris</h4>\n          </div>\n          <div class=\"members-grid\">\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-user\"></i></div>\n              <div class=\"member-name\">Hj. Maylan Sholha, ST, MM</div>\n              <span class=\"member-tag\">Sekretaris</span>\n            </div>\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-user\"></i></div>\n              <div class=\"member-name\">Handayani, SE</div>\n              <span class=\"member-tag\">Sekretaris</span>\n            </div>\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-user\"></i></div>\n              <div class=\"member-name\">Husnul Amalia Sholiha</div>\n              <span class=\"member-tag\">Sekretaris</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- BENDAHARA -->\n        <div class=\"org-group-card\">\n          <div class=\"org-group-title\">\n            <i class=\"fa-solid fa-coins\"></i>\n            <h4>Bendahara</h4>\n          </div>\n          <div class=\"members-grid\">\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-vault\"></i></div>\n              <div class=\"member-name\">Imawati Farhan, S.Ag</div>\n              <span class=\"member-tag\">Bendahara</span>\n            </div>\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-vault\"></i></div>\n              <div class=\"member-name\">Sumiyati</div>\n              <span class=\"member-tag\">Bendahara</span>\n            </div>\n            <div class=\"member-item\">\n              <div class=\"member-avatar\"><i class=\"fa-solid fa-vault\"></i></div>\n              <div class=\"member-name\">Novianty Widiastuti, SE</div>\n              <span class=\"member-tag\">Bendahara</span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- ==========================================\n           TIER 4: 4 DIREKTORAT OPERASIONAL & PROGRAM\n      ========================================== -->\n      <div class=\"tier-4-directorates\">\n\n        <!-- DIREKTORAT 1: PENGHIMPUNAN & PENDAYAGUNAAN -->\n        <div class=\"directorate-card\">\n          <div class=\"dir-header\">\n            <div class=\"dir-header-icon\"><i class=\"fa-solid fa-hand-holding-dollar\"></i></div>\n            <div class=\"dir-header-title\">Direktur Penghimpunan & Pendayagunaan</div>\n          </div>\n          <ul class=\"dir-members-list\">\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Kartika Mayasari, SS</span>\n            </li>\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Husnul Amalia Sholiha</span>\n            </li>\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Arini Hasanah Setiati, S.Pd</span>\n            </li>\n          </ul>\n        </div>\n\n        <!-- DIREKTORAT 2: PENDISTRIBUSIAN -->\n        <div class=\"directorate-card\">\n          <div class=\"dir-header\">\n            <div class=\"dir-header-icon\"><i class=\"fa-solid fa-truck-ramp-box\"></i></div>\n            <div class=\"dir-header-title\">Direktur Pendistribusian</div>\n          </div>\n          <ul class=\"dir-members-list\">\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Dra. Sri Watini</span>\n            </li>\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Arliana Mumtaza</span>\n            </li>\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Nindianty Widiastuty</span>\n            </li>\n          </ul>\n        </div>\n\n        <!-- DIREKTORAT 3: PENDAYAGUNAAN -->\n        <div class=\"directorate-card\">\n          <div class=\"dir-header\">\n            <div class=\"dir-header-icon\"><i class=\"fa-solid fa-seedling\"></i></div>\n            <div class=\"dir-header-title\">Direktur Pendayagunaan</div>\n          </div>\n          <ul class=\"dir-members-list\">\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Dr. Nurahmawati Farida Aryani, M.Si</span>\n            </li>\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Hj. Nurbayanti, S.Pd., M.Pd</span>\n            </li>\n          </ul>\n        </div>\n\n        <!-- DIREKTORAT 4: TATA KELOLA & OPERASIONAL -->\n        <div class=\"directorate-card\">\n          <div class=\"dir-header\">\n            <div class=\"dir-header-icon\"><i class=\"fa-solid fa-gears\"></i></div>\n            <div class=\"dir-header-title\">Direktur Tata Kelola & Operasional</div>\n          </div>\n          <ul class=\"dir-members-list\">\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Nailus Saadah, S.P.</span>\n            </li>\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Rika Kusum</span>\n            </li>\n            <li class=\"dir-member-entry\">\n              <span class=\"dir-member-bullet\"></span>\n              <span class=\"dir-member-name\">Nindianty Puji Tri Wahyuni</span>\n            </li>\n          </ul>\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n</section>\n"
              }
            }
          ]
        }
      ]
    }
  ]
}