{
  "version": "0.4",
  "title": "Halaman ZIS & Kalkulator LAZ WI",
  "type": "section",
  "content": [
    {
      "id": "f0dbfaa1",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "gap": "no"
      },
      "elements": [
        {
          "id": "f0dbfaa1col",
          "elType": "column",
          "settings": {
            "_column_size": 100
          },
          "elements": [
            {
              "id": "f0dbfaa1html",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<style>\n    :root {\n      --lilac-primary: #54366F;\n      --lilac-dark: #3D2452;\n      --lilac-light: #F5F0FA;\n      --lilac-soft: #D9C9E8;\n      --gold-accent: #C5A46D;\n      --gold-gradient: linear-gradient(135deg, #E6D2AD 0%, #C5A46D 50%, #9E7D47 100%);\n      --text-dark: #22222B;\n      --text-muted: #666675;\n      --bg-gray: #F8F9FA;\n      --white: #FFFFFF;\n      --border-color: #E6E4EA;\n      --font-heading: 'Playfair Display', serif;\n      --font-body: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body { font-family: var(--font-body); background-color: #181820; color: var(--text-dark); padding: 20px; }\n\n    /* TOOLBAR */\n    .preview-header {\n      max-width: 1240px; margin: 0 auto 20px auto; background: #242430; padding: 14px 24px;\n      border-radius: 14px; display: flex; justify-content: space-between; align-items: center; color: white;\n    }\n    .preview-title { font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px; }\n    .preview-title span { background: var(--lilac-primary); color: white; padding: 3px 10px; border-radius: 6px; font-size: 11px; }\n\n    .nav-page-tabs { display: flex; gap: 8px; }\n    .page-tab-btn {\n      background: #1A1A24; border: 1px solid #3E3E54; color: #CCC; padding: 6px 14px;\n      border-radius: 6px; font-size: 12px; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 6px;\n    }\n    .page-tab-btn.active { background: var(--lilac-primary); border-color: var(--gold-accent); color: white; }\n\n    .view-switcher { display: flex; background: #14141C; padding: 4px; border-radius: 8px; gap: 4px; }\n    .btn-switch {\n      background: transparent; border: none; color: #9A9AA6; padding: 6px 14px; font-size: 12px;\n      font-weight: 600; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 6px;\n    }\n    .btn-switch.active { background: var(--lilac-primary); color: white; }\n\n    /* VIEWPORT */\n    .viewport-wrapper { display: flex; justify-content: center; padding-bottom: 60px; }\n    .device-container { background: white; transition: all 0.3s ease; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.4); }\n    .device-container.desktop-view { width: 100%; max-width: 1200px; border-radius: 12px; overflow: hidden; }\n    .device-container.mobile-view { width: 390px; min-height: 844px; border-radius: 40px; border: 12px solid #2B2B36; overflow: hidden; margin: 20px 0; }\n    \n    .mobile-notch { display: none; width: 140px; height: 24px; background: #2B2B36; position: absolute; top: 0; left: 50%; transform: translateX(-50%); border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; z-index: 1000; }\n    .device-container.mobile-view .mobile-notch { display: block; }\n\n    /* STYLES */\n    .topbar {\n      background: linear-gradient(90deg, #3E1E52 0%, #54366F 50%, #46225B 100%);\n      color: white; padding: 9px 30px; font-size: 12px; display: flex; justify-content: space-between; align-items: center;\n      border-bottom: 1px solid rgba(212, 175, 55, 0.25);\n    }\n    .topbar a { color: #E2D5EC; text-decoration: none; margin-left: 15px; }\n\n    .navbar {\n      display: flex; justify-content: space-between; align-items: center; padding: 16px 30px; background: white;\n      border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 100;\n    }\n    .brand-logo { display: flex; align-items: center; gap: 14px; }\n    .logo-badge {\n      width: 46px; height: 46px; background: linear-gradient(135deg, var(--lilac-primary), var(--lilac-dark));\n      border: 2px solid var(--gold-accent); border-radius: 12px; display: flex; align-items: center; justify-content: center;\n      color: white; font-weight: 800; font-size: 19px; font-family: var(--font-heading);\n    }\n    .brand-text h1 { font-size: 17px; font-weight: 800; color: var(--lilac-dark); line-height: 1.1; font-family: var(--font-heading); }\n    .brand-text span { font-size: 11px; color: var(--text-muted); }\n    .nav-links { display: flex; list-style: none; gap: 24px; align-items: center; }\n    .nav-links a { text-decoration: none; color: var(--text-dark); font-size: 14px; font-weight: 600; }\n    .nav-links a.active { color: var(--lilac-primary); font-weight: 700; }\n    \n    .btn-donasi-header {\n      background: var(--gold-gradient); color: #362203 !important; padding: 10px 22px; border-radius: 20px;\n      font-size: 13px !important; font-weight: 800 !important; box-shadow: 0 4px 15px rgba(197, 154, 63, 0.45);\n      border: 1px solid #C5A46D !important;\n    }\n\n    /* HERO */\n    .page-hero {\n      background: linear-gradient(135deg, #4A2761 0%, #54366F 100%);\n      color: white; padding: 50px 30px; text-align: center;\n    }\n    .page-hero h2 { font-family: var(--font-heading); font-size: 36px; margin-bottom: 10px; font-weight: 700; }\n    .page-hero h2 span { color: #F5D77F; }\n    .page-hero p { font-size: 15px; color: #EBDCF5; max-width: 700px; margin: 0 auto; line-height: 1.6; }\n\n    /* DONATION PAGE LAYOUT */\n    .donation-page-container {\n      padding: 50px 30px; max-width: 1040px; margin: 0 auto;\n    }\n\n    .donation-grid-main {\n      display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 36px; align-items: flex-start;\n    }\n\n    .bank-group-title {\n      font-family: var(--font-heading); font-size: 18px; color: var(--lilac-dark); margin-bottom: 14px;\n      display: flex; align-items: center; gap: 8px;\n    }\n\n    .bank-card {\n      background: white; border: 1px solid var(--border-color); border-radius: 12px; padding: 18px 20px;\n      margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;\n      box-shadow: 0 2px 8px rgba(0,0,0,0.02); transition: border-color 0.2s;\n    }\n    .bank-card:hover { border-color: var(--lilac-primary); }\n\n    .bank-info h5 { font-size: 15px; color: var(--lilac-dark); margin-bottom: 4px; font-weight: 700; }\n    .acc-number { font-family: monospace; font-size: 17px; font-weight: 700; color: var(--text-dark); }\n    .acc-name { font-size: 12px; color: var(--text-muted); margin-top: 2px; }\n\n    .btn-copy {\n      background: var(--bg-gray); border: 1px solid #CCC; padding: 8px 14px; border-radius: 6px;\n      font-size: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;\n      transition: all 0.2s;\n    }\n    .btn-copy:hover { background: var(--lilac-soft); border-color: var(--lilac-primary); color: var(--lilac-dark); }\n\n    /* QRIS CARD */\n    .qris-card-wrap {\n      background: #FDFAFF; border: 2px solid var(--lilac-soft); border-radius: 16px; padding: 26px 20px;\n      text-align: center; display: flex; flex-direction: column; align-items: center;\n    }\n    .qris-badge {\n      background: var(--gold-gradient); color: #362203; font-size: 11px; font-weight: 800; padding: 4px 12px;\n      border-radius: 20px; margin-bottom: 12px;\n    }\n    .qris-box-large {\n      width: 220px; height: 220px; background: white; border: 2px dashed #B8A1C9; border-radius: 12px;\n      display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 10px 0 16px 0;\n      color: var(--lilac-dark); font-size: 13px; font-weight: 600;\n    }\n    .qris-note { font-size: 12px; color: var(--text-muted); line-height: 1.5; }\n\n    /* WA CONFIRMATION BOX */\n    .wa-confirm-card {\n      background: #EAF8F0; border: 1px solid #BFEBD3; border-radius: 14px; padding: 20px; margin-top: 26px;\n      display: flex; flex-direction: column; gap: 10px;\n    }\n    .wa-confirm-card h4 { font-size: 14px; color: #1E6641; font-weight: 700; display: flex; align-items: center; gap: 8px; }\n    .wa-confirm-card p { font-size: 12px; color: #377051; line-height: 1.5; }\n    .btn-wa-confirm-large {\n      background: #25D366; color: white; text-decoration: none; padding: 12px; border-radius: 8px;\n      font-weight: 700; font-size: 13px; text-align: center; display: flex; align-items: center; justify-content: center;\n      gap: 8px; box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);\n    }\n\n    /* KALKULATOR ZAKAT INTERAKTIF (ALA DOMPET DHUAFA) */\n    .zakat-calc-card {\n      background: linear-gradient(135deg, #FAF6FD 0%, #FFFFFF 100%);\n      border: 2px solid var(--lilac-soft);\n      border-radius: 16px;\n      padding: 28px 30px;\n      margin-bottom: 40px;\n      box-shadow: 0 4px 20px rgba(123, 82, 148, 0.06);\n    }\n\n    .calc-header-title {\n      font-family: var(--font-heading);\n      font-size: 20px;\n      color: var(--lilac-dark);\n      margin-bottom: 6px;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n\n    .calc-header-desc {\n      font-size: 13px;\n      color: var(--text-muted);\n      margin-bottom: 20px;\n    }\n\n    .calc-tabs {\n      display: flex;\n      gap: 10px;\n      margin-bottom: 20px;\n      border-bottom: 1px solid var(--border-color);\n      padding-bottom: 12px;\n    }\n\n    .calc-tab-btn {\n      background: white;\n      border: 1px solid var(--border-color);\n      padding: 8px 16px;\n      border-radius: 8px;\n      font-size: 13px;\n      font-weight: 700;\n      color: var(--text-muted);\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      transition: all 0.2s;\n    }\n\n    .calc-tab-btn.active {\n      background: var(--lilac-primary);\n      border-color: var(--lilac-primary);\n      color: white;\n    }\n\n    .calc-body-grid {\n      display: grid;\n      grid-template-columns: 1.2fr 0.8fr;\n      gap: 28px;\n      align-items: center;\n    }\n\n    .calc-input-group {\n      margin-bottom: 14px;\n    }\n\n    .calc-label {\n      font-size: 12px;\n      font-weight: 700;\n      color: var(--text-dark);\n      margin-bottom: 6px;\n      display: block;\n    }\n\n    .calc-input-wrapper {\n      position: relative;\n      display: flex;\n      align-items: center;\n    }\n\n    .calc-input-prefix {\n      position: absolute;\n      left: 12px;\n      font-size: 13px;\n      font-weight: 700;\n      color: var(--text-muted);\n    }\n\n    .calc-input {\n      width: 100%;\n      padding: 10px 14px 10px 42px;\n      border: 1.5px solid var(--border-color);\n      border-radius: 8px;\n      font-size: 14px;\n      font-weight: 600;\n      color: var(--text-dark);\n      font-family: var(--font-body);\n      outline: none;\n      transition: border-color 0.2s;\n    }\n\n    .calc-input:focus {\n      border-color: var(--lilac-primary);\n      box-shadow: 0 0 0 3px rgba(123, 82, 148, 0.15);\n    }\n\n    .calc-result-box {\n      background: linear-gradient(135deg, #F8F3FA 0%, #F1E5F7 100%);\n      border: 1.5px solid #D9C3E6;\n      border-radius: 12px;\n      padding: 22px;\n      text-align: center;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .result-badge {\n      font-size: 11px;\n      font-weight: 700;\n      color: var(--lilac-dark);\n      background: rgba(123, 82, 148, 0.12);\n      padding: 3px 10px;\n      border-radius: 12px;\n      margin-bottom: 8px;\n    }\n\n    .result-nominal {\n      font-family: var(--font-heading);\n      font-size: 26px;\n      font-weight: 800;\n      color: var(--lilac-dark);\n      margin-bottom: 4px;\n    }\n\n    .result-note {\n      font-size: 11px;\n      color: var(--text-muted);\n      line-height: 1.4;\n      margin-bottom: 14px;\n    }\n\n    .btn-calc-donasi {\n      background: var(--gold-gradient);\n      color: #362203;\n      text-decoration: none;\n      padding: 9px 18px;\n      border-radius: 8px;\n      font-size: 12px;\n      font-weight: 800;\n      border: 1px solid #C5A46D;\n      box-shadow: 0 2px 8px rgba(197, 154, 63, 0.35);\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    /* PANDUAN RINGKAS */\n    .guide-box {\n      background: white; border: 1px solid var(--border-color); border-radius: 14px; padding: 24px;\n      margin-top: 36px;\n    }\n    .guide-box h4 { font-family: var(--font-heading); font-size: 18px; color: var(--lilac-dark); margin-bottom: 12px; }\n    .guide-box ol { padding-left: 20px; font-size: 13px; color: #555566; line-height: 1.8; }\n\n    /* FOOTER */\n    .site-footer {\n      background: linear-gradient(135deg, #3B1B4F 0%, #4F2D64 60%, #351747 100%);\n      color: white; padding: 45px 30px 24px 30px; font-size: 13px; border-top: 3px solid #C5A46D;\n    }\n    .footer-content { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 30px; margin-bottom: 30px; }\n    .footer-brand h4 { font-size: 20px; font-weight: 700; margin-bottom: 10px; color: var(--gold-accent); font-family: var(--font-heading); }\n    .footer-brand p { color: #DDD4E4; line-height: 1.6; }\n    .footer-col h5 { font-size: 15px; font-weight: 700; margin-bottom: 12px; color: white; font-family: var(--font-heading); }\n    .footer-col ul { list-style: none; }\n    .footer-col li { margin-bottom: 8px; }\n    .footer-col a { color: #DDD4E4; text-decoration: none; }\n    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.15); padding-top: 16px; text-align: center; color: #BBA9CA; font-size: 12px; }\n\n    .mobile-bottom-bar {\n      display: none; position: sticky; bottom: 0; left: 0; right: 0; background: white;\n      box-shadow: 0 -4px 15px rgba(0,0,0,0.1); padding: 10px 16px; border-top: 1px solid var(--border-color);\n      z-index: 999; justify-content: space-between; gap: 10px;\n    }\n    .btn-mobile-act {\n      flex: 1; padding: 10px; border-radius: 8px; font-size: 13px; font-weight: 700; text-align: center;\n      text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px;\n    }\n    .btn-mobile-donasi { background: var(--gold-gradient); color: #362203; border: 1px solid #C5A46D; font-weight: 800; }\n    .btn-mobile-wa { background: #25D366; color: white; }\n\n    /* MOBILE TWEAKS */\n    .device-container.mobile-view .topbar { display: none; }\n    .device-container.mobile-view .nav-links, .device-container.mobile-view .btn-donasi-header { display: none; }\n    .device-container.mobile-view .navbar { padding: 12px 18px; padding-top: 28px; }\n    .device-container.mobile-view .calc-body-grid {\n      grid-template-columns: 1fr;\n      gap: 20px;\n    }\n\n    .device-container.mobile-view .calc-tabs {\n      flex-direction: column;\n      gap: 6px;\n    }\n\n    .device-container.mobile-view .donation-grid-main { grid-template-columns: 1fr; gap: 24px; }\n    .device-container.mobile-view .footer-content { grid-template-columns: 1fr; gap: 20px; }\n    .device-container.mobile-view .mobile-bottom-bar { display: flex; }\n  </style>\n<header class=\"page-hero\">\n        <h2>Tunaikan <span>Zakat, Infak & Kebaikan</span></h2>\n        <p>Bersihkan harta dan raih keberkahan dengan menyalurkan amanah ZISWAF langsung melalui rekening resmi lembaga atas nama LAZ Wanita Islam.</p>\n      </header>\n\n      <!-- DONATION CONTENT -->\n      <main class=\"donation-page-container\">\n        \n        <!-- KALKULATOR ZAKAT INTERAKTIF (BENCHMARK DOMPET DHUAFA) -->\n        <section class=\"zakat-calc-card\">\n          <div class=\"calc-header-title\">\n            <i class=\"fa-solid fa-calculator\" style=\"color: var(--gold-accent);\"></i>\n            Kalkulator Zakat LAZ Wanita Islam\n          </div>\n          <div class=\"calc-header-desc\">\n            Hitung kewajiban zakat Anda secara akurat sesuai standar nisab emas syariat Islam (Kadar 2,5%).\n          </div>\n\n          <!-- TABS PILIHAN JENIS ZAKAT -->\n          <div class=\"calc-tabs\">\n            <button class=\"calc-tab-btn active\" id=\"tabPenghasilan\" onclick=\"switchCalc('penghasilan')\">\n              <i class=\"fa-solid fa-briefcase\"></i> Zakat Penghasilan / Profesi\n            </button>\n            <button class=\"calc-tab-btn\" id=\"tabMaal\" onclick=\"switchCalc('maal')\">\n              <i class=\"fa-solid fa-coins\"></i> Zakat Maal (Tabungan / Harta)\n            </button>\n          </div>\n\n          <!-- BODY KALKULATOR -->\n          <div class=\"calc-body-grid\">\n            <div>\n              <div class=\"calc-input-group\">\n                <label class=\"calc-label\" id=\"labelPendapatan\">Penghasilan / Gaji per Bulan</label>\n                <div class=\"calc-input-wrapper\">\n                  <span class=\"calc-input-prefix\">Rp</span>\n                  <input type=\"text\" class=\"calc-input rupiah-input\" id=\"inputPenghasilan\" placeholder=\"0\" oninput=\"handleRupiahInput(this)\">\n                </div>\n              </div>\n\n              <div class=\"calc-input-group\">\n                <label class=\"calc-label\" id=\"labelTambahan\">Penghasilan Tambahan / Bonus / Lainnya (Opsional)</label>\n                <div class=\"calc-input-wrapper\">\n                  <span class=\"calc-input-prefix\">Rp</span>\n                  <input type=\"text\" class=\"calc-input rupiah-input\" id=\"inputTambahan\" placeholder=\"0\" oninput=\"handleRupiahInput(this)\">\n                </div>\n              </div>\n\n              <div class=\"calc-input-group\">\n                <label class=\"calc-label\" id=\"labelPengeluaran\">Kebutuhan Pokok / Utang Jatuh Tempo (per Bulan)</label>\n                <div class=\"calc-input-wrapper\">\n                  <span class=\"calc-input-prefix\">Rp</span>\n                  <input type=\"text\" class=\"calc-input rupiah-input\" id=\"inputPengeluaran\" placeholder=\"0\" oninput=\"handleRupiahInput(this)\">\n                </div>\n              </div>\n            </div>\n\n            <!-- HASIL HITUNG -->\n            <div class=\"calc-result-box\">\n              <span class=\"result-badge\"><i class=\"fa-solid fa-receipt\"></i> Hasil Perhitungan</span>\n              <div class=\"result-nominal\" id=\"displayZakatNominal\">Rp 0</div>\n              <div class=\"result-note\" id=\"displayNisabNote\">\n                Masukkan nominal penghasilan untuk menghitung kewajiban zakat.\n              </div>\n              <a href=\"#rekeningZakat\" class=\"btn-calc-donasi\">\n                <i class=\"fa-solid fa-hand-holding-heart\"></i> Tunaikan Zakat Ini\n              </a>\n            </div>\n          </div>\n        </section>\n\n        <div class=\"donation-grid-main\" id=\"rekeningZakat\">\n          \n          <!-- SISI KIRI: DAFTAR REKENING BANK BERDASARKAN AKAD -->\n          <div>\n            \n            <!-- REKENING ZAKAT -->\n            <div class=\"bank-group-title\">\n              <i class=\"fa-solid fa-hand-holding-dollar\" style=\"color: var(--gold-accent);\"></i>\n              Rekening Khusus Zakat Maal & Zakat Fitrah\n            </div>\n            \n            <div class=\"bank-card\">\n              <div class=\"bank-info\">\n                <h5>Bank Syariah Indonesia (BSI)</h5>\n                <div class=\"acc-number\">7123-4567-89</div>\n                <div class=\"acc-name\">a.n. LAZ Wanita Islam - Zakat</div>\n              </div>\n              <button class=\"btn-copy\" onclick=\"copyText('7123456789')\"><i class=\"fa-regular fa-copy\"></i> Salin No. Rek</button>\n            </div>\n\n            <div class=\"bank-card\">\n              <div class=\"bank-info\">\n                <h5>Bank Muamalat</h5>\n                <div class=\"acc-number\">301-00-1234-56</div>\n                <div class=\"acc-name\">a.n. LAZ Wanita Islam - Zakat</div>\n              </div>\n              <button class=\"btn-copy\" onclick=\"copyText('30100123456')\"><i class=\"fa-regular fa-copy\"></i> Salin No. Rek</button>\n            </div>\n\n            <!-- REKENING INFAK & KEMANUSIAAN -->\n            <div class=\"bank-group-title\" style=\"margin-top: 30px;\">\n              <i class=\"fa-solid fa-heart-pulse\" style=\"color: var(--gold-accent);\"></i>\n              Rekening Infak, Sedekah, Bencana & CSR\n            </div>\n\n            <div class=\"bank-card\">\n              <div class=\"bank-info\">\n                <h5>Bank Mandiri</h5>\n                <div class=\"acc-number\">137-00-9876-5432</div>\n                <div class=\"acc-name\">a.n. LAZ Wanita Islam - Kemanusiaan</div>\n              </div>\n              <button class=\"btn-copy\" onclick=\"copyText('1370098765432')\"><i class=\"fa-regular fa-copy\"></i> Salin No. Rek</button>\n            </div>\n\n            <div class=\"bank-card\">\n              <div class=\"bank-info\">\n                <h5>Bank Central Asia (BCA)</h5>\n                <div class=\"acc-number\">882-012-3456</div>\n                <div class=\"acc-name\">a.n. Yayasan Wanita Islam</div>\n              </div>\n              <button class=\"btn-copy\" onclick=\"copyText('8820123456')\"><i class=\"fa-regular fa-copy\"></i> Salin No. Rek</button>\n            </div>\n\n            <!-- KARTU KONFIRMASI WHATSAPP -->\n            <div class=\"wa-confirm-card\">\n              <h4><i class=\"fa-brands fa-whatsapp\" style=\"font-size: 18px;\"></i> Konfirmasi Donasi Anda</h4>\n              <p>Agar dana Anda tercatat dan diterbitkan bukti setor zakat resmi, mohon kirimkan bukti transfer ke Amil kami:</p>\n              <a href=\"https://wa.me/?text=Assalamu%27alaikum%20Amil%20LAZ%20Wanita%20Indonesia%2C%20saya%20sudah%20mentransfer%20donasi%20sebesar%20Rp...\" target=\"_blank\" class=\"btn-wa-confirm-large\">\n                <i class=\"fa-brands fa-whatsapp\"></i> Konfirmasi via WhatsApp Sekarang\n              </a>\n            </div>\n\n          </div>\n\n          <!-- SISI KANAN: SCAN QRIS STATIS RESOLUSI BESAR -->\n          <div>\n            <div class=\"qris-card-wrap\">\n              <span class=\"qris-badge\">SCAN QRIS CEPAT & RESMI</span>\n              <h4 style=\"font-size: 16px; color: var(--lilac-dark); font-family: var(--font-heading);\">QRIS LAZ Wanita Islam</h4>\n              \n              <div class=\"qris-box-large\">\n                <i class=\"fa-solid fa-qrcode\" style=\"font-size: 72px; margin-bottom: 12px;\"></i>\n                <span>[ GAMBAR QRIS LEMBAGA ]</span>\n                <span style=\"font-size: 11px; color: var(--text-muted); margin-top: 4px;\">NMID: ID1029384756</span>\n              </div>\n\n              <p class=\"qris-note\">\n                Bisa di-scan menggunakan seluruh aplikasi Mobile Banking (BCA Mobile, Livin Mandiri, BSI Mobile, BRImo) dan dompet digital (GoPay, OVO, ShopeePay, DANA, LinkAja).\n              </p>\n            </div>\n          </div>\n\n        </div>\n\n        <!-- PANDUAN RINGKAS CARA BERZAKAT -->\n        <div class=\"guide-box\">\n          <h4>3 Langkah Mudah Menunaikan Kepedulian</h4>\n          <ol>\n            <li><strong>Pilih Rekening Sesuai Akad:</strong> Gunakan rekening Zakat untuk zakat maal/fitrah, atau rekening Infak/Kemanusiaan untuk sedekah umum dan tanggap bencana.</li>\n            <li><strong>Lakukan Transfer atau Scan QRIS:</strong> Masukkan nominal donasi Anda melalui ATM, m-Banking, atau aplikasi e-Wallet.</li>\n            <li><strong>Konfirmasi Bukti Setor:</strong> Klik tombol konfirmasi WhatsApp untuk mendapatkan konfirmasi akad dan doa dari Amil.</li>\n          </ol>\n        </div>\n\n      </main>\n\n      \n<script>\n    let currentCalcType = 'penghasilan';\n    const NISAB_BULANAN = 6800000; // Nisab bulanan setara 85gr emas / 12 bln\n    const NISAB_TAHUNAN = 81600000; // Nisab tahunan setara 85gr emas\n\n    // Fungsi format rupiah dengan titik pemisah ribuan otomatis\n    function formatNumberRupiah(numStr) {\n      const cleanNum = numStr.replace(/\\D/g, '');\n      if (!cleanNum) return '';\n      return parseInt(cleanNum, 10).toLocaleString('id-ID');\n    }\n\n    function parseRupiah(valStr) {\n      if (!valStr) return 0;\n      const cleanNum = valStr.replace(/\\D/g, '');\n      return parseInt(cleanNum, 10) || 0;\n    }\n\n    function handleRupiahInput(inputElem) {\n      const rawVal = inputElem.value;\n      inputElem.value = formatNumberRupiah(rawVal);\n      calculateZakat();\n    }\n\n    function switchCalc(type) {\n      currentCalcType = type;\n      const tabPenghasilan = document.getElementById('tabPenghasilan');\n      const tabMaal = document.getElementById('tabMaal');\n      const labelPendapatan = document.getElementById('labelPendapatan');\n      const labelPengeluaran = document.getElementById('labelPengeluaran');\n\n      // Kosongkan input agar bersih saat ganti tab\n      document.getElementById('inputPenghasilan').value = '';\n      document.getElementById('inputTambahan').value = '';\n      document.getElementById('inputPengeluaran').value = '';\n\n      if (type === 'penghasilan') {\n        tabPenghasilan.classList.add('active');\n        tabMaal.classList.remove('active');\n        labelPendapatan.innerText = 'Penghasilan / Gaji per Bulan';\n        labelPengeluaran.innerText = 'Kebutuhan Pokok / Utang Jatuh Tempo (per Bulan)';\n      } else {\n        tabMaal.classList.add('active');\n        tabPenghasilan.classList.remove('active');\n        labelPendapatan.innerText = 'Total Tabungan, Emas, Deposito, & Aset Likuid';\n        labelPengeluaran.innerText = 'Hutang / Kewajiban Jatuh Tempo Tahun Ini';\n      }\n      calculateZakat();\n    }\n\n    function calculateZakat() {\n      const p1 = parseRupiah(document.getElementById('inputPenghasilan').value);\n      const p2 = parseRupiah(document.getElementById('inputTambahan').value);\n      const out = parseRupiah(document.getElementById('inputPengeluaran').value);\n\n      const totalHarta = p1 + p2;\n      const bersih = totalHarta - out;\n      let zakat = 0;\n      const displayNominal = document.getElementById('displayZakatNominal');\n      const displayNote = document.getElementById('displayNisabNote');\n\n      const nisab = currentCalcType === 'penghasilan' ? NISAB_BULANAN : NISAB_TAHUNAN;\n\n      if (totalHarta === 0) {\n        displayNominal.innerText = 'Rp 0';\n        displayNote.innerHTML = 'Ketik nominal angka di atas untuk mulai menghitung.';\n        return;\n      }\n\n      if (bersih >= nisab) {\n        zakat = bersih * 0.025;\n        displayNominal.innerText = 'Rp ' + Math.round(zakat).toLocaleString('id-ID');\n        displayNote.innerHTML = '<span style=\"color:#10B981; font-weight:700;\"><i class=\"fa-solid fa-circle-check\"></i> Wajib Zakat</span> (Penghasilan bersih di atas nisab Rp ' + nisab.toLocaleString('id-ID') + ')';\n      } else {\n        displayNominal.innerText = 'Rp 0';\n        displayNote.innerHTML = '<span style=\"color:#F59E0B; font-weight:700;\"><i class=\"fa-solid fa-circle-info\"></i> Belum Wajib Zakat</span> (Di bawah nisab Rp ' + nisab.toLocaleString('id-ID') + ', disarankan infak/sedekah)';\n      }\n    }\n\n    function setMode(mode) {\n      const frame = document.getElementById('deviceFrame');\n      const btnDesktop = document.getElementById('btnDesktop');\n      const btnMobile = document.getElementById('btnMobile');\n\n      if (mode === 'mobile') {\n        frame.className = 'device-container mobile-view';\n        btnMobile.classList.add('active');\n        btnDesktop.classList.remove('active');\n      } else {\n        frame.className = 'device-container desktop-view';\n        btnDesktop.classList.add('active');\n        btnMobile.classList.remove('active');\n      }\n    }\n\n    function copyText(text) {\n      navigator.clipboard.writeText(text);\n      alert('Nomor rekening ' + text + ' berhasil disalin!');\n    }\n\n    // Hitung saat pertama kali load\n    calculateZakat();\n  </script>"
              }
            }
          ]
        }
      ]
    }
