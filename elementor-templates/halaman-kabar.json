            {
              "id": "ad02dd1chtml",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<style>\n    :root {\n      --lilac-primary: #54366F;\n      --lilac-dark: #3D2452;\n      --lilac-light: #F5F0FA;\n      --lilac-soft: #D9C9E8;\n      --gold-accent: #C5A46D;\n      --gold-gradient: linear-gradient(135deg, #E6D2AD 0%, #C5A46D 50%, #9E7D47 100%);\n      --text-dark: #22222B;\n      --text-muted: #666675;\n      --bg-gray: #F8F9FA;\n      --white: #FFFFFF;\n      --border-color: #E6E4EA;\n      --font-heading: 'Playfair Display', serif;\n      --font-body: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body { font-family: var(--font-body); background-color: #181820; color: var(--text-dark); padding: 20px; }\n\n    /* TOOLBAR */\n    .preview-header {\n      max-width: 1240px; margin: 0 auto 20px auto; background: #242430; padding: 14px 24px;\n      border-radius: 14px; display: flex; justify-content: space-between; align-items: center; color: white;\n    }\n    .preview-title { font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px; }\n    .preview-title span { background: var(--lilac-primary); color: white; padding: 3px 10px; border-radius: 6px; font-size: 11px; }\n\n    .nav-page-tabs { display: flex; gap: 6px; flex-wrap: wrap; }\n    .page-tab-btn {\n      background: #1A1A24; border: 1px solid #3E3E54; color: #CCC; padding: 6px 12px;\n      border-radius: 6px; font-size: 12px; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 6px;\n      transition: all 0.2s;\n    }\n    .page-tab-btn.active { background: var(--lilac-primary); border-color: var(--gold-accent); color: white; }\n\n    .view-switcher { display: flex; background: #14141C; padding: 4px; border-radius: 8px; gap: 4px; }\n    .btn-switch {\n      background: transparent; border: none; color: #9A9AA6; padding: 6px 14px; font-size: 12px;\n      font-weight: 600; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 6px;\n    }\n    .btn-switch.active { background: var(--lilac-primary); color: white; }\n\n    /* VIEWPORT */\n    .viewport-wrapper { display: flex; justify-content: center; padding-bottom: 60px; }\n    .device-container { background: white; transition: all 0.3s ease; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.4); }\n    .device-container.desktop-view { width: 100%; max-width: 1200px; border-radius: 12px; overflow: hidden; }\n    .device-container.mobile-view { width: 390px; min-height: 844px; border-radius: 40px; border: 12px solid #2B2B36; overflow: hidden; margin: 20px 0; }\n    \n    .mobile-notch { display: none; width: 140px; height: 24px; background: #2B2B36; position: absolute; top: 0; left: 50%; transform: translateX(-50%); border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; z-index: 1000; }\n    .device-container.mobile-view .mobile-notch { display: block; }\n\n    /* STYLES */\n    .topbar {\n      background: linear-gradient(90deg, #3E1E52 0%, #54366F 50%, #46225B 100%);\n      color: white; padding: 9px 30px; font-size: 12px; display: flex; justify-content: space-between; align-items: center;\n      border-bottom: 1px solid rgba(212, 175, 55, 0.25);\n    }\n    .topbar a { color: #E2D5EC; text-decoration: none; margin-left: 15px; }\n\n    .navbar {\n      display: flex; justify-content: space-between; align-items: center; padding: 16px 30px; background: white;\n      border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 100;\n    }\n    .brand-logo { display: flex; align-items: center; gap: 14px; }\n    .logo-badge {\n      width: 46px; height: 46px; background: linear-gradient(135deg, var(--lilac-primary), var(--lilac-dark));\n      border: 2px solid var(--gold-accent); border-radius: 12px; display: flex; align-items: center; justify-content: center;\n      color: white; font-weight: 800; font-size: 19px; font-family: var(--font-heading);\n    }\n    .brand-text h1 { font-size: 17px; font-weight: 800; color: var(--lilac-dark); line-height: 1.1; font-family: var(--font-heading); }\n    .brand-text span { font-size: 11px; color: var(--text-muted); }\n    .nav-links { display: flex; list-style: none; gap: 24px; align-items: center; }\n    .nav-links a { text-decoration: none; color: var(--text-dark); font-size: 14px; font-weight: 600; }\n    .nav-links a.active { color: var(--lilac-primary); font-weight: 700; }\n    \n    .btn-donasi-header {\n      background: var(--gold-gradient); color: #362203 !important; padding: 10px 22px; border-radius: 20px;\n      font-size: 13px !important; font-weight: 800 !important; box-shadow: 0 4px 15px rgba(197, 154, 63, 0.45);\n      border: 1px solid #C5A46D !important;\n    }\n\n    /* HERO */\n    .page-hero {\n      background: linear-gradient(135deg, #4A2761 0%, #54366F 100%);\n      color: white; padding: 50px 30px; text-align: center;\n    }\n    .page-hero h2 { font-family: var(--font-heading); font-size: 36px; margin-bottom: 10px; font-weight: 700; }\n    .page-hero h2 span { color: #F5D77F; }\n    .page-hero p { font-size: 15px; color: #EBDCF5; max-width: 700px; margin: 0 auto; line-height: 1.6; }\n\n    /* FILTER CATEGORY TABS */\n    .category-filter-bar {\n      display: flex; justify-content: center; gap: 10px; padding: 30px 20px 10px 20px; flex-wrap: wrap;\n    }\n    .btn-cat-filter {\n      background: white; border: 1px solid var(--border-color); color: var(--text-muted); padding: 8px 18px;\n      border-radius: 30px; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s;\n    }\n    .btn-cat-filter.active, .btn-cat-filter:hover {\n      background: var(--lilac-primary); color: white; border-color: var(--lilac-primary);\n    }\n\n    /* NEWS GRID PAGE */\n    .news-page-container { padding: 30px 30px 60px 30px; max-width: 1140px; margin: 0 auto; }\n    \n    .news-grid-page {\n      display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px;\n    }\n\n    .news-card {\n      background: white; border-radius: 14px; overflow: hidden; border: 1px solid var(--border-color);\n      display: flex; flex-direction: column; transition: all 0.25s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.02);\n    }\n    .news-card:hover { transform: translateY(-4px); box-shadow: 0 10px 25px rgba(0,0,0,0.08); border-color: #D3C3E0; }\n\n    .news-img-holder {\n      height: 180px; background: #EDE6F2; border-bottom: 2px dashed #CBB8DC; display: flex;\n      flex-direction: column; align-items: center; justify-content: center; color: var(--lilac-primary);\n      font-size: 12px; gap: 6px; text-align: center; padding: 12px;\n    }\n\n    .news-body { padding: 22px; flex-grow: 1; display: flex; flex-direction: column; }\n    .news-meta { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); margin-bottom: 10px; }\n    .news-meta .category {\n      color: var(--lilac-dark); font-weight: 700; background: var(--lilac-light); padding: 2px 10px; border-radius: 4px;\n    }\n\n    .news-body h4 {\n      font-size: 17px; color: var(--text-dark); margin-bottom: 10px; line-height: 1.4; font-family: var(--font-heading);\n    }\n    .news-body p { font-size: 13px; color: var(--text-muted); line-height: 1.6; margin-bottom: 18px; flex-grow: 1; }\n\n    .news-link {\n      color: var(--lilac-primary); font-size: 12px; font-weight: 700; text-decoration: none;\n      display: inline-flex; align-items: center; gap: 6px;\n    }\n\n    /* PAGINATION */\n    .pagination-bar {\n      display: flex; justify-content: center; gap: 8px; margin-top: 40px;\n    }\n    .page-num {\n      width: 38px; height: 38px; border-radius: 8px; border: 1px solid var(--border-color);\n      background: white; color: var(--text-dark); font-size: 13px; font-weight: 700;\n      display: flex; align-items: center; justify-content: center; text-decoration: none; transition: all 0.2s;\n    }\n    .page-num.active { background: var(--lilac-primary); color: white; border-color: var(--lilac-primary); }\n\n    /* FOOTER */\n    .site-footer {\n      background: linear-gradient(135deg, #3B1B4F 0%, #4F2D64 60%, #351747 100%);\n      color: white; padding: 45px 30px 24px 30px; font-size: 13px; border-top: 3px solid #C5A46D;\n    }\n    .footer-content { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 30px; margin-bottom: 30px; }\n    .footer-brand h4 { font-size: 20px; font-weight: 700; margin-bottom: 10px; color: var(--gold-accent); font-family: var(--font-heading); }\n    .footer-brand p { color: #DDD4E4; line-height: 1.6; }\n    .footer-col h5 { font-size: 15px; font-weight: 700; margin-bottom: 12px; color: white; font-family: var(--font-heading); }\n    .footer-col ul { list-style: none; }\n    .footer-col li { margin-bottom: 8px; }\n    .footer-col a { color: #DDD4E4; text-decoration: none; }\n    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.15); padding-top: 16px; text-align: center; color: #BBA9CA; font-size: 12px; }\n\n    .mobile-bottom-bar {\n      display: none; position: sticky; bottom: 0; left: 0; right: 0; background: white;\n      box-shadow: 0 -4px 15px rgba(0,0,0,0.1); padding: 10px 16px; border-top: 1px solid var(--border-color);\n      z-index: 999; justify-content: space-between; gap: 10px;\n    }\n    .btn-mobile-act {\n      flex: 1; padding: 10px; border-radius: 8px; font-size: 13px; font-weight: 700; text-align: center;\n      text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px;\n    }\n    .btn-mobile-donasi { background: var(--gold-gradient); color: #362203; border: 1px solid #C5A46D; font-weight: 800; }\n    .btn-mobile-wa { background: #25D366; color: white; }\n\n    /* MOBILE TWEAKS */\n    .device-container.mobile-view .topbar { display: none; }\n    .device-container.mobile-view .nav-links, .device-container.mobile-view .btn-donasi-header { display: none; }\n    .device-container.mobile-view .navbar { padding: 12px 18px; padding-top: 28px; }\n    .device-container.mobile-view .news-grid-page { grid-template-columns: 1fr; gap: 18px; }\n    .device-container.mobile-view .footer-content { grid-template-columns: 1fr; gap: 20px; }\n    .device-container.mobile-view .mobile-bottom-bar { display: flex; }\n  </style>\n<header class=\"page-hero\">\n        <h2>Kabar & <span>Cerita Aksi Lapangan</span></h2>\n        <p>Catatan jejak ikhtiar relawan dan amil LAZ Wanita Islam dalam mendampingi keluarga mustahik, merespons bencana, dan memberdayakan kaum ibu.</p>\n      </header>\n\n      <!-- CATEGORY FILTER BUTTONS -->\n      <div class=\"category-filter-bar\">\n        <button class=\"btn-cat-filter active\">Semua Kabar (6)</button>\n        <button class=\"btn-cat-filter\">Pemberdayaan UMKM</button>\n        <button class=\"btn-cat-filter\">Respons Kebencanaan</button>\n        <button class=\"btn-cat-filter\">Pendidikan Anak</button>\n        <button class=\"btn-cat-filter\">Edukasi Syariah & Keluarga</button>\n      </div>\n\n      <!-- MAIN ARTICLES GRID -->\n      <main class=\"news-page-container\">\n        <div class=\"news-grid-page\">\n          \n          <!-- ARTIKEL 1 -->\n          <article class=\"news-card\">\n            <div class=\"news-img-holder\">\n              <i class=\"fa-solid fa-truck-medical\" style=\"font-size: 28px;\"></i>\n              <strong>[ Foto Aksi Tanggap Darurat ]</strong>\n              <span>Pos ramah anak & bantuan logistik keluarga</span>\n            </div>\n            <div class=\"news-body\">\n              <div class=\"news-meta\">\n                <span class=\"category\">Kebencanaan</span>\n                <span>12 November 2026</span>\n              </div>\n              <h4>Respons Cepat Bencana: LAZ WI Dirikan Pos Ramah Ibu & Perlengkapan Bayi</h4>\n              <p>Menjangkau keluarga terdampak bencana dengan fokus perlindungan kesehatan balita, pemulihan gizi, dan tenda darurat keluarga.</p>\n              <a href=\"#\" class=\"news-link\">Baca Selengkapnya <i class=\"fa-solid fa-arrow-right\"></i></a>\n            </div>\n          </article>\n\n          <!-- ARTIKEL 2 -->\n          <article class=\"news-card\">\n            <div class=\"news-img-holder\">\n              <i class=\"fa-solid fa-hand-holding-dollar\" style=\"font-size: 28px;\"></i>\n              <strong>[ Foto Pelatihan UMKM Ibu ]</strong>\n              <span>Ibu-ibu berkumpul menerima modal usaha</span>\n            </div>\n            <div class=\"news-body\">\n              <div class=\"news-meta\">\n                <span class=\"category\">Pemberdayaan UMKM</span>\n                <span>08 November 2026</span>\n              </div>\n              <h4>Bebaskan Ibu dari Jerat Pinjol: Program Modal Bergulir Bergulir di DIY</h4>\n              <p>Sebanyak 35 ibu pelaku usaha mikro di kawasan tertinggal mendapatkan suntikan modal bebas riba dan pendampingan literasi keuangan syariah.</p>\n              <a href=\"#\" class=\"news-link\">Baca Selengkapnya <i class=\"fa-solid fa-arrow-right\"></i></a>\n            </div>\n          </article>\n\n          <!-- ARTIKEL 3 -->\n          <article class=\"news-card\">\n            <div class=\"news-img-holder\">\n              <i class=\"fa-solid fa-book-open-reader\" style=\"font-size: 28px;\"></i>\n              <strong>[ Foto Edukasi Keluarga ]</strong>\n              <span>Kajian parenting syariah & ketahanan keluarga</span>\n            </div>\n            <div class=\"news-body\">\n              <div class=\"news-meta\">\n                <span class=\"category\">Ketahanan Keluarga</span>\n                <span>02 November 2026</span>\n              </div>\n              <h4>Mengapa Ketahanan Keluarga Menjadi Kunci Mengikis Kemiskinan Ekstrem?</h4>\n              <p>Ulasan mendalam ormas Wanita Islam mengenai peran sentral ibu rumah tangga dalam membentengi moral, ekonomi, dan pendidikan generasi penerus.</p>\n              <a href=\"#\" class=\"news-link\">Baca Selengkapnya <i class=\"fa-solid fa-arrow-right\"></i></a>\n            </div>\n          </article>\n\n          <!-- ARTIKEL 4 -->\n          <article class=\"news-card\">\n            <div class=\"news-img-holder\">\n              <i class=\"fa-solid fa-mask-face\" style=\"font-size: 28px;\"></i>\n              <strong>[ Foto Respon Karhutla ]</strong>\n              <span>Distribusi masker medis & tabung oksigen</span>\n            </div>\n            <div class=\"news-body\">\n              <div class=\"news-meta\">\n                <span class=\"category\">Kebencanaan</span>\n                <span>25 Oktober 2026</span>\n              </div>\n              <h4>Aksi Tanggap Asap Karhutla: Distribusi Masker Khusus untuk Balita dan Lansia</h4>\n              <p>Relawan perempuan LAZ WI menyisir pemukiman yang diselimuti kabut asap tebal guna membagikan paket kesehatan pernapasan.</p>\n              <a href=\"#\" class=\"news-link\">Baca Selengkapnya <i class=\"fa-solid fa-arrow-right\"></i></a>\n            </div>\n          </article>\n\n          <!-- ARTIKEL 5 -->\n          <article class=\"news-card\">\n            <div class=\"news-img-holder\">\n              <i class=\"fa-solid fa-graduation-cap\" style=\"font-size: 28px;\"></i>\n              <strong>[ Foto Sekolah Darurat ]</strong>\n              <span>Ruang belajar tenda anak pelosok</span>\n            </div>\n            <div class=\"news-body\">\n              <div class=\"news-meta\">\n                <span class=\"category\">Pendidikan</span>\n                <span>18 Oktober 2026</span>\n              </div>\n              <h4>Menyalakan Harapan: Ruang Belajar Darurat Hadir untuk Anak-Anak Pelosok</h4>\n              <p>Penyediaan ruang kelas darurat lengkap dengan peralatan tulis dan konseling trauma healing pascabencana alam.</p>\n              <a href=\"#\" class=\"news-link\">Baca Selengkapnya <i class=\"fa-solid fa-arrow-right\"></i></a>\n            </div>\n          </article>\n\n          <!-- ARTIKEL 6 -->\n          <article class=\"news-card\">\n            <div class=\"news-img-holder\">\n              <i class=\"fa-solid fa-landmark\" style=\"font-size: 28px;\"></i>\n              <strong>[ Foto Sidang Pleno WI ]</strong>\n              <span>Pengurus Pusat Wanita Islam rapat evaluasi</span>\n            </div>\n            <div class=\"news-body\">\n              <div class=\"news-meta\">\n                <span class=\"category\">Kelembagaan</span>\n                <span>10 Oktober 2026</span>\n              </div>\n              <h4>Pleno Semesteran: LAZ WI Paparkan Laporan Penyaluran ZIS di Hadapan Pimpinan WI</h4>\n              <p>Komitmen akuntabilitas 6 bulanan: seluruh dana zakat dan kemanusiaan dipertanggungjawabkan secara terbuka di depan pengurus ormas induk.</p>\n              <a href=\"#\" class=\"news-link\">Baca Selengkapnya <i class=\"fa-solid fa-arrow-right\"></i></a>\n            </div>\n          </article>\n\n        </div>\n\n        <!-- PAGINATION -->\n        <div class=\"pagination-bar\">\n          <a href=\"#\" class=\"page-num active\">1</a>\n          <a href=\"#\" class=\"page-num\">2</a>\n          <a href=\"#\" class=\"page-num\"><i class=\"fa-solid fa-angle-right\"></i></a>\n        </div>\n      </main>\n\n      "
              }
            }
          ]
        }
      ]
    }
  ]
}