            {
              "id": "w_html_program_page",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!-- ========================================================\n  TEMPLATE RESMI: LAMAN PROGRAM (5 PILAR PROGRAM LAZ WANITA ISLAM)\n  Didesain khusus untuk Elementor WordPress (Full Width / Boxed).\n  \n  PANDUAN GANTI FOTO:\n  Setiap pilar memiliki tag penanda: <!-- [GANTI FOTO PILAR X DISINI] -->\n  Cukup ganti url di atribut src=\"...\" dengan foto dari Media Library WordPress Anda.\n======================================================== -->\n\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<style>\n  :root {\n    --lilac-primary: #54366F;\n    --lilac-dark: #3D2452;\n    --lilac-light: #F5F0FA;\n    --lilac-soft: #D9C9E8;\n    --lilac-tint: #ECE5F3;\n    --gold-accent: #C5A46D;\n    --gold-gradient: linear-gradient(135deg, #ECC874 0%, #C59A3F 50%, #9E7422 100%);\n    --gold-glow: 0 4px 15px rgba(197, 154, 63, 0.4);\n    --gold-light: #FDF7E7;\n    --text-dark: #22222B;\n    --text-muted: #666675;\n    --bg-gray: #F8F9FA;\n    --border-color: #E6E4EA;\n    --font-heading: 'Plus Jakarta Sans', sans-serif;\n    --font-body: 'Plus Jakarta Sans', sans-serif;\n  }\n\n  .lazwi-program-page {\n    font-family: var(--font-body);\n    color: var(--text-dark);\n    background-color: #FFFFFF;\n    max-width: 100%;\n    margin: 0 auto;\n    box-sizing: border-box;\n    padding-bottom: 60px;\n  }\n\n  .lazwi-prog-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 20px;\n    box-sizing: border-box;\n  }\n\n  /* 1. HERO BANNER LAMAN PROGRAM */\n  .prog-hero-banner {\n    background: linear-gradient(135deg, #3D2452 0%, #54366F 60%, #46225B 100%);\n    color: #FFFFFF;\n    border-radius: 24px;\n    padding: 55px 40px;\n    margin: 20px auto 50px auto;\n    position: relative;\n    overflow: hidden;\n    box-shadow: 0 16px 40px rgba(61, 36, 82, 0.18);\n  }\n\n  .prog-hero-banner::after {\n    content: \"\";\n    position: absolute;\n    top: -60px;\n    right: -60px;\n    width: 260px;\n    height: 260px;\n    background: radial-gradient(circle, rgba(197, 164, 109, 0.22) 0%, transparent 70%);\n    border-radius: 50%;\n    pointer-events: none;\n  }\n\n  .prog-breadcrumbs {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 13px;\n    color: #D9C9E8;\n    margin-bottom: 18px;\n  }\n\n  .prog-breadcrumbs a {\n    color: #ECC874;\n    text-decoration: none;\n    font-weight: 600;\n  }\n\n  .prog-breadcrumbs i {\n    font-size: 10px;\n    opacity: 0.7;\n  }\n\n  .prog-hero-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: rgba(255, 255, 255, 0.12);\n    border: 1px solid rgba(197, 164, 109, 0.45);\n    color: #F8F3FC;\n    font-size: 12px;\n    font-weight: 700;\n    padding: 6px 16px;\n    border-radius: 30px;\n    margin-bottom: 18px;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n  }\n\n  .prog-hero-badge i {\n    color: #ECC874;\n  }\n\n  .prog-hero-title {\n    font-family: var(--font-heading);\n    font-size: 38px;\n    font-weight: 800;\n    line-height: 1.25;\n    margin: 0 0 16px 0;\n    color: #FFFFFF;\n    letter-spacing: -0.5px;\n  }\n\n  .prog-hero-title span {\n    background: var(--gold-gradient);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .prog-hero-subtitle {\n    font-size: 16px;\n    line-height: 1.65;\n    color: #E3D9ED;\n    max-width: 820px;\n    margin: 0 0 28px 0;\n  }\n\n  .prog-hero-stats {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 20px;\n    padding-top: 20px;\n    border-top: 1px solid rgba(255, 255, 255, 0.12);\n  }\n\n  .hero-stat-item {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    background: rgba(255, 255, 255, 0.08);\n    padding: 8px 16px;\n    border-radius: 12px;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .hero-stat-item i {\n    color: #ECC874;\n    font-size: 16px;\n  }\n\n  .hero-stat-item span {\n    font-size: 13px;\n    font-weight: 700;\n    color: #FFFFFF;\n  }\n\n  /* 2. DAFTAR DETAIL 5 PILAR PROGRAM */\n  .prog-list-wrapper {\n    display: flex;\n    flex-direction: column;\n    gap: 45px;\n    margin-bottom: 70px;\n  }\n\n  .prog-detail-row {\n    background: #FFFFFF;\n    border: 1px solid var(--border-color);\n    border-radius: 20px;\n    overflow: hidden;\n    display: flex;\n    box-shadow: 0 8px 30px rgba(84, 54, 111, 0.05);\n    transition: all 0.3s ease;\n  }\n\n  .prog-detail-row:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 16px 40px rgba(84, 54, 111, 0.1);\n    border-color: var(--lilac-soft);\n  }\n\n  /* Row bergantian kiri-kanan pada desktop */\n  .prog-detail-row.row-reverse {\n    flex-direction: row-reverse;\n  }\n\n  .prog-img-column {\n    flex: 0 0 46%;\n    position: relative;\n    background: #2D1A3D;\n    min-height: 380px;\n    overflow: hidden;\n  }\n\n  .prog-img-column img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    transition: transform 0.5s ease;\n  }\n\n  .prog-detail-row:hover .prog-img-column img {\n    transform: scale(1.04);\n  }\n\n  .prog-tag-floating {\n    position: absolute;\n    top: 20px;\n    left: 20px;\n    background: rgba(61, 36, 82, 0.88);\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    color: #FFFFFF;\n    font-size: 12px;\n    font-weight: 700;\n    padding: 6px 14px;\n    border-radius: 30px;\n    border: 1px solid rgba(197, 164, 109, 0.6);\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    z-index: 2;\n  }\n\n  .prog-tag-floating i {\n    color: #ECC874;\n  }\n\n  .prog-content-column {\n    flex: 0 0 54%;\n    padding: 38px 40px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    box-sizing: border-box;\n  }\n\n  .prog-pilar-num {\n    font-size: 12px;\n    font-weight: 800;\n    color: var(--gold-accent);\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    margin-bottom: 6px;\n  }\n\n  .prog-detail-title {\n    font-family: var(--font-heading);\n    font-size: 25px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0 0 14px 0;\n    line-height: 1.3;\n  }\n\n  .prog-detail-desc {\n    font-size: 14.5px;\n    line-height: 1.65;\n    color: var(--text-muted);\n    margin: 0 0 22px 0;\n  }\n\n  /* KOTAK FOKUS KEGIATAN */\n  .prog-intervention-box {\n    background: var(--lilac-light);\n    border-radius: 14px;\n    padding: 18px 20px;\n    margin-bottom: 26px;\n    border: 1px solid var(--lilac-soft);\n  }\n\n  .prog-intervention-title {\n    font-size: 12.5px;\n    font-weight: 800;\n    color: var(--lilac-primary);\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 10px;\n    display: flex;\n    align-items: center;\n    gap: 7px;\n  }\n\n  .prog-intervention-title i {\n    color: var(--gold-accent);\n  }\n\n  .prog-intervention-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  .prog-intervention-list li {\n    font-size: 13px;\n    color: #3E3E4E;\n    line-height: 1.55;\n    margin-bottom: 8px;\n    position: relative;\n    padding-left: 20px;\n  }\n\n  .prog-intervention-list li:last-child {\n    margin-bottom: 0;\n  }\n\n  .prog-intervention-list li::before {\n    content: \"\u2713\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: var(--gold-accent);\n    font-weight: 800;\n    font-size: 14px;\n  }\n\n  /* TOMBOL AKSI PILAR */\n  .prog-action-bar {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 14px;\n    margin-top: auto;\n  }\n\n  .btn-prog-donasi {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--gold-gradient);\n    color: #362203 !important;\n    text-decoration: none;\n    font-size: 13.5px;\n    font-weight: 800;\n    padding: 12px 24px;\n    border-radius: 12px;\n    border: 1px solid #C59A3F;\n    box-shadow: var(--gold-glow);\n    transition: all 0.25s ease;\n  }\n\n  .btn-prog-donasi:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 6px 20px rgba(197, 154, 63, 0.55);\n  }\n\n  .btn-prog-consult {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: #FFFFFF;\n    color: var(--lilac-primary) !important;\n    text-decoration: none;\n    font-size: 13px;\n    font-weight: 700;\n    padding: 11px 20px;\n    border-radius: 12px;\n    border: 1px solid var(--lilac-soft);\n    transition: all 0.2s ease;\n  }\n\n  .btn-prog-consult:hover {\n    background: var(--lilac-light);\n    border-color: var(--lilac-primary);\n  }\n\n  /* 3. SEKSI PRINSIP TATA KELOLA & AMANAH (3A) */\n  .prog-trust-banner {\n    background: linear-gradient(135deg, #FAF8FC 0%, #F4EEF8 100%);\n    border: 1px solid var(--lilac-soft);\n    border-radius: 20px;\n    padding: 40px;\n    margin-bottom: 50px;\n    text-align: center;\n  }\n\n  .trust-banner-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--lilac-primary);\n    background: #FFFFFF;\n    padding: 4px 14px;\n    border-radius: 20px;\n    border: 1px solid var(--lilac-soft);\n    margin-bottom: 12px;\n  }\n\n  .trust-banner-title {\n    font-family: var(--font-heading);\n    font-size: 26px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0 0 10px 0;\n  }\n\n  .trust-banner-desc {\n    font-size: 14.5px;\n    color: var(--text-muted);\n    max-width: 720px;\n    margin: 0 auto 30px auto;\n    line-height: 1.6;\n  }\n\n  .trust-grid-3a {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n    max-width: 960px;\n    margin: 0 auto;\n  }\n\n  .trust-3a-card {\n    background: #FFFFFF;\n    border: 1px solid var(--border-color);\n    border-radius: 16px;\n    padding: 24px 20px;\n    text-align: center;\n    transition: all 0.25s ease;\n  }\n\n  .trust-3a-card:hover {\n    border-color: var(--gold-accent);\n    transform: translateY(-4px);\n    box-shadow: 0 10px 24px rgba(84, 54, 111, 0.08);\n  }\n\n  .trust-icon-box {\n    width: 52px;\n    height: 52px;\n    border-radius: 14px;\n    background: var(--lilac-light);\n    color: var(--lilac-primary);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 22px;\n    margin: 0 auto 14px auto;\n    border: 1px solid var(--lilac-soft);\n  }\n\n  .trust-3a-card h4 {\n    font-family: var(--font-heading);\n    font-size: 16px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0 0 6px 0;\n  }\n\n  .trust-3a-card p {\n    font-size: 12.5px;\n    color: var(--text-muted);\n    line-height: 1.5;\n    margin: 0;\n  }\n\n  /* 4. FOOTER CALL-TO-ACTION (CTA) */\n  .prog-bottom-cta {\n    background: linear-gradient(135deg, #3D2452 0%, #54366F 100%);\n    border-radius: 20px;\n    padding: 40px;\n    color: #FFFFFF;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 24px;\n    box-shadow: 0 12px 36px rgba(61, 36, 82, 0.2);\n  }\n\n  .cta-text-side h3 {\n    font-family: var(--font-heading);\n    font-size: 26px;\n    font-weight: 800;\n    color: #FFFFFF;\n    margin: 0 0 8px 0;\n  }\n\n  .cta-text-side p {\n    font-size: 14.5px;\n    color: #E3D9ED;\n    margin: 0;\n    max-width: 600px;\n    line-height: 1.55;\n  }\n\n  .cta-btn-side {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n\n  /* RESPONSIVE BREAKPOINT */\n  @media (max-width: 900px) {\n    .prog-detail-row,\n    .prog-detail-row.row-reverse {\n      flex-direction: column;\n    }\n    .prog-img-column {\n      flex: none;\n      min-height: 240px;\n      height: 240px;\n    }\n    .prog-content-column {\n      flex: none;\n      padding: 26px 20px;\n    }\n    .trust-grid-3a {\n      grid-template-columns: 1fr;\n    }\n    .prog-hero-banner {\n      padding: 36px 20px;\n    }\n    .prog-hero-title {\n      font-size: 28px;\n    }\n    .prog-bottom-cta {\n      flex-direction: column;\n      text-align: center;\n      padding: 30px 20px;\n    }\n    .cta-btn-side {\n      justify-content: center;\n      width: 100%;\n    }\n  }\n</style>\n\n<div class=\"lazwi-program-page\" id=\"laman-program-utama\">\n  <div class=\"lazwi-prog-container\">\n\n    <!-- HERO BANNER -->\n    <header class=\"prog-hero-banner\">\n      <div class=\"prog-breadcrumbs\">\n        <a href=\"index.html\">Beranda</a>\n        <i class=\"fa-solid fa-chevron-right\"></i>\n        <span>Program Pemberdayaan</span>\n      </div>\n      <div class=\"prog-hero-badge\">\n        <i class=\"fa-solid fa-hand-holding-heart\"></i> 5 Pilar Program Utama\n      </div>\n      <h1 class=\"prog-hero-title\">Pemberdayaan Berkelanjutan <span>LAZ Wanita Islam</span></h1>\n      <p class=\"prog-hero-subtitle\">\n        Menyalurkan amanah zakat, infak, sedekah, dan wakaf (ZISWAF) secara profesional, tepat sasaran, dan berkelanjutan untuk mengangkat martabat mustahik perempuan serta mengokohkan ketahanan keluarga prasejahtera di seluruh Indonesia.\n      </p>\n\n      <div class=\"prog-hero-stats\">\n        <div class=\"hero-stat-item\">\n          <i class=\"fa-solid fa-building-circle-check\"></i>\n          <span>10 Cabang Resmi Nasional</span>\n        </div>\n        <div class=\"hero-stat-item\">\n          <i class=\"fa-solid fa-handshake-angle\"></i>\n          <span>100% Syariah & Bebas Riba</span>\n        </div>\n        <div class=\"hero-stat-item\">\n          <i class=\"fa-solid fa-scale-balanced\"></i>\n          <span>Prinsip 3A Resmi BAZNAS</span>\n        </div>\n      </div>\n    </header>\n\n    <!-- DAFTAR DETAIL 5 PILAR PROGRAM -->\n    <section class=\"prog-list-wrapper\">\n\n      <!-- ========================================================\n           PILAR 1: KEMANDIRIAN EKONOMI (UMKM IBU TANGGUH)\n      ======================================================== -->\n      <article class=\"prog-detail-row\" id=\"pilar-ekonomi\">\n        <div class=\"prog-img-column\">\n          <span class=\"prog-tag-floating\"><i class=\"fa-solid fa-store\"></i> Pilar 1</span>\n          <!-- [GANTI FOTO PILAR 1 DISINI] Masukkan link foto dari WP Media Library -->\n          <img src=\"assets/programs/pilar-1-ekonomi.jpg\" alt=\"Pilar 1 - Kemandirian Ekonomi UMKM Ibu Tangguh\">\n        </div>\n        <div class=\"prog-content-column\">\n          <span class=\"prog-pilar-num\">Pilar 1: Kemandirian Ekonomi</span>\n          <h2 class=\"prog-detail-title\">Penguatan Modal Usaha Bebas Riba (Ibu Tangguh)</h2>\n          <p class=\"prog-detail-desc\">\n            Program permodalan bergulir <em>Qardhul Hasan</em> (tanpa bunga dan tanpa biaya tambahan) yang dipadukan dengan pendampingan manajemen keuangan rumah tangga. Dirancang khusus untuk memutus jeratan rentenir keliling dan pinjaman online ilegal yang mengancam keutuhan keluarga prasejahtera.\n          </p>\n\n          <div class=\"prog-intervention-box\">\n            <span class=\"prog-intervention-title\"><i class=\"fa-solid fa-bullseye\"></i> Fokus Intervensi & Kegiatan:</span>\n            <ul class=\"prog-intervention-list\">\n              <li>Suntikan modal alat produksi dan bahan baku usaha mikro rumahan (kuliner, kerajinan, warung).</li>\n              <li>Mentoring pencatatan kas harian & literasi syariah bebas bunga bagi kelompok ibu.</li>\n              <li>Pemberdayaan kelompok usaha bersama berbasis majelis taklim perempuan di wilayah binaan.</li>\n            </ul>\n          </div>\n\n          <div class=\"prog-action-bar\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-prog-donasi\">\n              <i class=\"fa-solid fa-heart\"></i> Dukung Usaha Ibu Tangguh\n            </a>\n            <a href=\"https://wa.me/6281288880101?text=Halo%20LAZ%20Wanita%20Islam,%20saya%20ingin%20konsultasi%20Program%20Ekonomi\" class=\"btn-prog-consult\" target=\"_blank\">\n              <i class=\"fa-brands fa-whatsapp\"></i> Konsultasi Program\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <!-- ========================================================\n           PILAR 2: PENDIDIKAN GENERASI (BEASISWA & SEKOLAH)\n      ======================================================== -->\n      <article class=\"prog-detail-row row-reverse\" id=\"pilar-pendidikan\">\n        <div class=\"prog-img-column\">\n          <span class=\"prog-tag-floating\"><i class=\"fa-solid fa-graduation-cap\"></i> Pilar 2</span>\n          <!-- [GANTI FOTO PILAR 2 DISINI] Masukkan link foto dari WP Media Library -->\n          <img src=\"assets/programs/pilar-2-pendidikan.jpg\" alt=\"Pilar 2 - Pendidikan Generasi & Beasiswa Anak Negeri\">\n        </div>\n        <div class=\"prog-content-column\">\n          <span class=\"prog-pilar-num\">Pilar 2: Pendidikan Generasi</span>\n          <h2 class=\"prog-detail-title\">Ruang Belajar, Sekolah Ramah Anak & Beasiswa</h2>\n          <p class=\"prog-detail-desc\">\n            Memastikan tidak ada anak yang kehilangan hak belajarnya akibat kemiskinan ekstrem atau fasilitas sekolah yang terdampak bencana alam. LAZ Wanita Islam menyediakan ruang kelas darurat, alat tulis, seragam, dan beasiswa yatim dhuafa berkesinambungan.\n          </p>\n\n          <div class=\"prog-intervention-box\">\n            <span class=\"prog-intervention-title\"><i class=\"fa-solid fa-bullseye\"></i> Fokus Intervensi & Kegiatan:</span>\n            <ul class=\"prog-intervention-list\">\n              <li>Beasiswa pendidikan santri, pelajar yatim, dan anak keluarga prasejahtera di pelosok.</li>\n              <li>Pendirian ruang kelas tenda ramah anak & pojok literasi buku bacaan desa.</li>\n              <li>Distribusi paket perlengkapan sekolah lengkap & pendampingan trauma healing pascabencana.</li>\n            </ul>\n          </div>\n\n          <div class=\"prog-action-bar\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-prog-donasi\">\n              <i class=\"fa-solid fa-heart\"></i> Bantu Pendidikan Anak Dhuafa\n            </a>\n            <a href=\"https://wa.me/6281288880101?text=Halo%20LAZ%20Wanita%20Islam,%20saya%20ingin%20konsultasi%20Program%20Pendidikan\" class=\"btn-prog-consult\" target=\"_blank\">\n              <i class=\"fa-brands fa-whatsapp\"></i> Konsultasi Program\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <!-- ========================================================\n           PILAR 3: KESEHATAN IBU & ANAK (BEBAS STUNTING)\n      ======================================================== -->\n      <article class=\"prog-detail-row\" id=\"pilar-kesehatan\">\n        <div class=\"prog-img-column\">\n          <span class=\"prog-tag-floating\"><i class=\"fa-solid fa-stethoscope\"></i> Pilar 3</span>\n          <!-- [GANTI FOTO PILAR 3 DISINI] Masukkan link foto dari WP Media Library -->\n          <img src=\"assets/programs/pilar-3-kesehatan.jpg\" alt=\"Pilar 3 - Kesehatan Ibu, Balita & Cegah Stunting\">\n        </div>\n        <div class=\"prog-content-column\">\n          <span class=\"prog-pilar-num\">Pilar 3: Kesehatan Ibu & Anak</span>\n          <h2 class=\"prog-detail-title\">Gizi Sehat Balita, Ibu Hamil & Pencegahan Stunting</h2>\n          <p class=\"prog-detail-desc\">\n            Intervensi gizi terpadu untuk menyelamatkan 1.000 Hari Pertama Kehidupan (HPK). Berkolaborasi aktif dengan Posyandu binaan guna memantau tumbuh kembang balita, pembagian PMT bernutrisi tinggi, dan pemeriksaan kesehatan berkala bagi ibu hamil prasejahtera.\n          </p>\n\n          <div class=\"prog-intervention-box\">\n            <span class=\"prog-intervention-title\"><i class=\"fa-solid fa-bullseye\"></i> Fokus Intervensi & Kegiatan:</span>\n            <ul class=\"prog-intervention-list\">\n              <li>Paket Pemberian Makanan Tambahan (PMT) nutrisi tinggi untuk balita wasting & stunting.</li>\n              <li>Pemeriksaan kesehatan, vitamin penambah darah, dan suplemen gizi ibu hamil dhuafa.</li>\n              <li>Layanan skrining kesehatan lansia dhuafa serta edukasi sanitasi lingkungan higienis.</li>\n            </ul>\n          </div>\n\n          <div class=\"prog-action-bar\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-prog-donasi\">\n              <i class=\"fa-solid fa-heart\"></i> Donasi Gizi & Kesehatan Ibu\n            </a>\n            <a href=\"https://wa.me/6281288880101?text=Halo%20LAZ%20Wanita%20Islam,%20saya%20ingin%20konsultasi%20Program%20Kesehatan\" class=\"btn-prog-consult\" target=\"_blank\">\n              <i class=\"fa-brands fa-whatsapp\"></i> Konsultasi Program\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <!-- ========================================================\n           PILAR 4: KEMANUSIAAN & BENCANA\n      ======================================================== -->\n      <article class=\"prog-detail-row row-reverse\" id=\"pilar-kemanusiaan\">\n        <div class=\"prog-img-column\">\n          <span class=\"prog-tag-floating\"><i class=\"fa-solid fa-shield-heart\"></i> Pilar 4</span>\n          <!-- [GANTI FOTO PILAR 4 DISINI] Masukkan link foto dari WP Media Library -->\n          <img src=\"assets/programs/pilar-4-kemanusiaan.jpg\" alt=\"Pilar 4 - Kemanusiaan & Tanggap Bencana\">\n        </div>\n        <div class=\"prog-content-column\">\n          <span class=\"prog-pilar-num\">Pilar 4: Kemanusiaan & Kebencanaan</span>\n          <h2 class=\"prog-detail-title\">Tanggap Darurat Bencana & Perlindungan Keluarga</h2>\n          <p class=\"prog-detail-desc\">\n            Menggerakkan jejaring relawan perempuan Wanita Islam di berbagai penjuru nusantara dalam merespons cepat situasi darurat bencana alam dan krisis kemanusiaan, dengan pendekatan sensitif gender ramah ibu hamil, bayi menyusui, dan lansia.\n          </p>\n\n          <div class=\"prog-intervention-box\">\n            <span class=\"prog-intervention-title\"><i class=\"fa-solid fa-bullseye\"></i> Fokus Intervensi & Kegiatan:</span>\n            <ul class=\"prog-intervention-list\">\n              <li>Dapur umum higienis khusus pemenuhan nutrisi balita dan ibu menyusui di posko pengungsian.</li>\n              <li>Distribusi sembako darurat, hygiene kit wanita, popok, dan selimut bersih.</li>\n              <li>Penyaluran tabung oksigen, masker medis, dan tenda ramah keluarga di area terdampak.</li>\n            </ul>\n          </div>\n\n          <div class=\"prog-action-bar\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-prog-donasi\">\n              <i class=\"fa-solid fa-heart\"></i> Bantu Tanggap Bencana\n            </a>\n            <a href=\"https://wa.me/6281288880101?text=Halo%20LAZ%20Wanita%20Islam,%20saya%20ingin%20konsultasi%20Program%20Kemanusiaan\" class=\"btn-prog-consult\" target=\"_blank\">\n              <i class=\"fa-brands fa-whatsapp\"></i> Konsultasi Program\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <!-- ========================================================\n           PILAR 5: DAKWAH & KETAHANAN KELUARGA SAKINAH\n      ======================================================== -->\n      <article class=\"prog-detail-row\" id=\"pilar-dakwah\">\n        <div class=\"prog-img-column\">\n          <span class=\"prog-tag-floating\"><i class=\"fa-solid fa-mosque\"></i> Pilar 5</span>\n          <!-- [GANTI FOTO PILAR 5 DISINI] Masukkan link foto dari WP Media Library -->\n          <img src=\"assets/programs/pilar-5-dakwah-keluarga.jpg\" alt=\"Pilar 5 - Dakwah & Ketahanan Keluarga Sakinah\">\n        </div>\n        <div class=\"prog-content-column\">\n          <span class=\"prog-pilar-num\">Pilar 5: Dakwah & Advokasi</span>\n          <h2 class=\"prog-detail-title\">Ketahanan Keluarga Sakinah & Syiar Islam</h2>\n          <p class=\"prog-detail-desc\">\n            Mengokohkan ketahanan keluarga muslim Indonesia melalui penguatan nilai-nilai keislaman, bimbingan parenting sakinah, pembinaan majelis taklim ibu-ibu desa, serta edukasi dan advokasi perlindungan hak perempuan dan anak dhuafa.\n          </p>\n\n          <div class=\"prog-intervention-box\">\n            <span class=\"prog-intervention-title\"><i class=\"fa-solid fa-bullseye\"></i> Fokus Intervensi & Kegiatan:</span>\n            <ul class=\"prog-intervention-list\">\n              <li>Binaan rutin majelis taklim perempuan & pemberantasan buta aksara Al-Qur'an.</li>\n              <li>Pusat konsultasi parenting Islami & konseling ketahanan rumah tangga sakinah.</li>\n              <li>Advokasi hukum keluarga dan sosialisasi literasi zakat produktif bagi mustahik.</li>\n            </ul>\n          </div>\n\n          <div class=\"prog-action-bar\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-prog-donasi\">\n              <i class=\"fa-solid fa-heart\"></i> Dukung Syiar Keluarga Sakinah\n            </a>\n            <a href=\"https://wa.me/6281288880101?text=Halo%20LAZ%20Wanita%20Islam,%20saya%20ingin%20konsultasi%20Program%20Dakwah\" class=\"btn-prog-consult\" target=\"_blank\">\n              <i class=\"fa-brands fa-whatsapp\"></i> Konsultasi Program\n            </a>\n          </div>\n        </div>\n      </article>\n\n    </section>\n\n    <!-- 3. SEKSI PRINSIP 3A (AMAN SYAR'I, AMAN REGULASI, AMAN NKRI) -->\n    <div class=\"prog-trust-banner\">\n      <div class=\"trust-banner-badge\"><i class=\"fa-solid fa-certificate\"></i> Tata Kelola Kepatuhan</div>\n      <h3 class=\"trust-banner-title\">Prinsip 3A Pengelolaan ZISWAF LAZ Wanita Islam</h3>\n      <p class=\"trust-banner-desc\">\n        Setiap rupiah donasi dan zakat yang diamanahkan dikelola berdasarkan kaidah syariah yang ketat, kepatuhan audit regulasi nasional, dan dedikasi penuh bagi keutuhan NKRI.\n      </p>\n\n      <div class=\"trust-grid-3a\">\n        <div class=\"trust-3a-card\">\n          <div class=\"trust-icon-box\"><i class=\"fa-solid fa-book-quran\"></i></div>\n          <h4>1. Aman Syar'i</h4>\n          <p>Disalurkan sesuai ketentuan asnaf dalam Al-Qur'an dan diawasi langsung oleh Dewan Pengawas Syariah resmi.</p>\n        </div>\n        <div class=\"trust-3a-card\">\n          <div class=\"trust-icon-box\"><i class=\"fa-solid fa-building-shield\"></i></div>\n          <h4>2. Aman Regulasi</h4>\n          <p>Beroperasi memenuhi standar perizinan Kementerian Agama, regulasi BAZNAS, dan diaudit berkala akuntan publik.</p>\n        </div>\n        <div class=\"trust-3a-card\">\n          <div class=\"trust-icon-box\"><i class=\"fa-solid fa-hands-holding-heart\"></i></div>\n          <h4>3. Aman NKRI</h4>\n          <p>Mendukung pengentasan kemiskinan nasional dan memperkokoh ketahanan keluarga di seluruh nusantara.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- 4. BOTTOM CALL-TO-ACTION -->\n    <div class=\"prog-bottom-cta\">\n      <div class=\"cta-text-side\">\n        <h3>Salurkan Zakat & Sedekah Terbaik Anda Hari Ini</h3>\n        <p>Bersama LAZ Wanita Islam, mari berdayakan jutaan ibu tangguh dan wujudkan masa depan cerah anak-anak negeri.</p>\n      </div>\n      <div class=\"cta-btn-side\">\n        <a href=\"tunaikan-zakat.html\" class=\"btn-prog-donasi\" style=\"font-size:14px;padding:14px 28px;\">\n          <i class=\"fa-solid fa-heart\"></i> Tunaikan Zakat Sekarang\n        </a>\n      </div>\n    </div>\n\n  </div>\n</div>\n"
