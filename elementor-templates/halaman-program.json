nDesktop.classList.add('active');\n        btnMobile.classList.remove('active');\n        if (drawer) drawer.style.display = 'none';\n        if (icon) icon.className = 'fa-solid fa-bars';\n      }\n    }\n\n    window.addEventListener('resize', function() {\n      if (window.innerWidth > 768) {\n        var drawer = document.getElementById('mobileNavDrawer');\n        var icon = document.getElementById('mobileNavIcon');\n        if (drawer) drawer.style.display = 'none';\n        if (icon) icon.className = 'fa-solid fa-bars';\n      }\n    });\n  \n    function scrollToTop() {\n      window.scrollTo({ top: 0, behavior: 'smooth' });\n    }\n\n    // LISTENER SCROLL UNTUK TOMBOL BACK TO TOP (OPASITAS MENYESUAIKAN TINGKAT SCROLL)\n    function updateBackToTop() {\n      var btnTop = document.getElementById('mobileBackToTop');\n      if (!btnTop) return;\n      var scrollY = window.scrollY || document.documentElement.scrollTop || 0;\n      btnTop.style.display = 'flex';\n      var opacity = Math.min(1.0, 0.82 + (scrollY / 1500));\n      btnTop.style.opacity = opacity;\n    }\n    window.addEventListener('scroll', updateBackToTop);\n    document.addEventListener('DOMContentLoaded', updateBackToTop);\n    updateBackToTop();\n\n  </script>\n</body>\n</html>"
