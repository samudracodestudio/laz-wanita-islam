              "widgetType": "html",
              "settings": {
                "html": "<style>\n    :root {\n      --lilac-primary: #54366F;\n      --lilac-dark: #3D2452;\n      --lilac-light: #F5F0FA;\n      --lilac-soft: #D9C9E8;\n      --gold-accent: #C5A46D;\n      --gold-gradient: linear-gradient(135deg, #E6D2AD 0%, #C5A46D 50%, #9E7D47 100%);\n      --text-dark: #22222B;\n      --text-muted: #666675;\n      --bg-gray: #F8F9FA;\n      --white: #FFFFFF;\n      --border-color: #E6E4EA;\n      --font-heading: 'Playfair Display', serif;\n      --font-body: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body { font-family: var(--font-body); background-color: #181820; color: var(--text-dark); padding: 20px; }\n\n    /* TOOLBAR */\n    .preview-header {\n      max-width: 1240px; margin: 0 auto 20px auto; background: #242430; padding: 14px 24px;\n      border-radius: 14px; display: flex; justify-content: space-between; align-items: center; color: white;\n    }\n    .preview-title { font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px; }\n    .preview-title span { background: var(--lilac-primary); color: white; padding: 3px 10px; border-radius: 6px; font-size: 11px; }\n\n    .nav-page-tabs { display: flex; gap: 8px; }\n    .page-tab-btn {\n      background: #1A1A24; border: 1px solid #3E3E54; color: #CCC; padding: 6px 14px;\n      border-radius: 6px; font-size: 12px; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 6px;\n    }\n    .page-tab-btn.active { background: var(--lilac-primary); border-color: var(--gold-accent); color: white; }\n\n    .view-switcher { display: flex; background: #14141C; padding: 4px; border-radius: 8px; gap: 4px; }\n    .btn-switch {\n      background: transparent; border: none; color: #9A9AA6; padding: 6px 14px; font-size: 12px;\n      font-weight: 600; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 6px;\n    }\n    .btn-switch.active { background: var(--lilac-primary); color: white; }\n\n    /* VIEWPORT */\n    .viewport-wrapper { display: flex; justify-content: center; padding-bottom: 60px; }\n    .device-container { background: white; transition: all 0.3s ease; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.4); }\n    .device-container.desktop-view { width: 100%; max-width: 1200px; border-radius: 12px; overflow: hidden; }\n    .device-container.mobile-view { width: 390px; min-height: 844px; border-radius: 40px; border: 12px solid #2B2B36; overflow: hidden; margin: 20px 0; }\n    \n    .mobile-notch { display: none; width: 140px; height: 24px; background: #2B2B36; position: absolute; top: 0; left: 50%; transform: translateX(-50%); border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; z-index: 1000; }\n    .device-container.mobile-view .mobile-notch { display: block; }\n\n    /* STYLES */\n    .topbar {\n      background: linear-gradient(90deg, #3E1E52 0%, #54366F 50%, #46225B 100%);\n      color: white; padding: 9px 30px; font-size: 12px; display: flex; justify-content: space-between; align-items: center;\n      border-bottom: 1px solid rgba(212, 175, 55, 0.25);\n    }\n    .topbar a { color: #E2D5EC; text-decoration: none; margin-left: 15px; }\n\n    .navbar {\n      display: flex; justify-content: space-between; align-items: center; padding: 16px 30px; background: white;\n      border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 100;\n    }\n    .brand-logo { display: flex; align-items: center; gap: 14px; }\n    .logo-badge {\n      width: 46px; height: 46px; background: linear-gradient(135deg, var(--lilac-primary), var(--lilac-dark));\n      border: 2px solid var(--gold-accent); border-radius: 12px; display: flex; align-items: center; justify-content: center;\n      color: white; font-weight: 800; font-size: 19px; font-family: var(--font-heading);\n    }\n    .brand-text h1 { font-size: 17px; font-weight: 800; color: var(--lilac-dark); line-height: 1.1; font-family: var(--font-heading); }\n    .brand-text span { font-size: 11px; color: var(--text-muted); }\n    .nav-links { display: flex; list-style: none; gap: 24px; align-items: center; }\n    .nav-links a { text-decoration: none; color: var(--text-dark); font-size: 14px; font-weight: 600; }\n    .nav-links a.active { color: var(--lilac-primary); font-weight: 700; }\n    \n    .btn-donasi-header {\n      background: var(--gold-gradient); color: #362203 !important; padding: 10px 22px; border-radius: 20px;\n      font-size: 13px !important; font-weight: 800 !important; box-shadow: 0 4px 15px rgba(197, 154, 63, 0.45);\n      border: 1px solid #C5A46D !important;\n    }\n\n    /* HERO */\n    .page-hero {\n      background: linear-gradient(135deg, #4A2761 0%, #54366F 100%);\n      color: white; padding: 50px 30px; text-align: center;\n    }\n    .page-hero h2 { font-family: var(--font-heading); font-size: 36px; margin-bottom: 10px; font-weight: 700; }\n    .page-hero h2 span { color: #F5D77F; }\n    .page-hero p { font-size: 15px; color: #EBDCF5; max-width: 700px; margin: 0 auto; line-height: 1.6; }\n\n    /* PROGRAM DETAIL ITEMS */\n    .programs-container { padding: 50px 30px; }\n    \n    .program-detail-card {\n      background: white; border: 1px solid var(--border-color); border-radius: 16px; overflow: hidden;\n      margin-bottom: 36px; display: grid; grid-template-columns: 1fr 1.4fr; box-shadow: 0 4px 20px rgba(0,0,0,0.03);\n    }\n    .program-detail-card:nth-child(even) { grid-template-columns: 1.4fr 1fr; }\n    .program-detail-card:nth-child(even) .program-visual-side { order: 2; }\n    .program-detail-card:nth-child(even) .program-info-side { order: 1; }\n\n    .program-visual-side {\n      background: #EFE9F5; border-right: 1px solid var(--border-color); display: flex; flex-direction: column;\n      align-items: center; justify-content: center; padding: 40px 20px; text-align: center; color: var(--lilac-dark);\n    }\n    .program-detail-card:nth-child(even) .program-visual-side { border-right: none; border-left: 1px solid var(--border-color); }\n\n    .program-info-side { padding: 36px; display: flex; flex-direction: column; justify-content: center; }\n    .program-pill {\n      font-size: 11px; font-weight: 700; color: var(--gold-accent); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.5px;\n    }\n    .program-info-side h3 { font-family: var(--font-heading); font-size: 24px; color: var(--lilac-dark); margin-bottom: 12px; }\n    .program-info-side p { font-size: 14px; color: #555566; line-height: 1.7; margin-bottom: 16px; }\n    \n    .impact-points {\n      background: var(--lilac-light); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px; font-size: 13px; color: #4B3A5A;\n    }\n    .impact-points li { margin-left: 18px; margin-bottom: 6px; }\n\n    .btn-act-program {\n      align-self: flex-start; background: var(--gold-gradient); color: #362203; text-decoration: none;\n      padding: 11px 24px; border-radius: 8px; font-size: 13px; font-weight: 800; border: 1px solid #C5A46D;\n      box-shadow: 0 4px 12px rgba(197, 154, 63, 0.35); display: inline-flex; align-items: center; gap: 8px;\n    }\n\n    /* FOOTER */\n    .site-footer {\n      background: linear-gradient(135deg, #3B1B4F 0%, #4F2D64 60%, #351747 100%);\n      color: white; padding: 45px 30px 24px 30px; font-size: 13px; border-top: 3px solid #C5A46D;\n    }\n    .footer-content { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 30px; margin-bottom: 30px; }\n    .footer-brand h4 { font-size: 20px; font-weight: 700; margin-bottom: 10px; color: var(--gold-accent); font-family: var(--font-heading); }\n    .footer-brand p { color: #DDD4E4; line-height: 1.6; }\n    .footer-col h5 { font-size: 15px; font-weight: 700; margin-bottom: 12px; color: white; font-family: var(--font-heading); }\n    .footer-col ul { list-style: none; }\n    .footer-col li { margin-bottom: 8px; }\n    .footer-col a { color: #DDD4E4; text-decoration: none; }\n    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.15); padding-top: 16px; text-align: center; color: #BBA9CA; font-size: 12px; }\n\n    .mobile-bottom-bar {\n      display: none; position: sticky; bottom: 0; left: 0; right: 0; background: white;\n      box-shadow: 0 -4px 15px rgba(0,0,0,0.1); padding: 10px 16px; border-top: 1px solid var(--border-color);\n      z-index: 999; justify-content: space-between; gap: 10px;\n    }\n    .btn-mobile-act {\n      flex: 1; padding: 10px; border-radius: 8px; font-size: 13px; font-weight: 700; text-align: center;\n      text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px;\n    }\n    .btn-mobile-donasi { background: var(--gold-gradient); color: #362203; border: 1px solid #C5A46D; font-weight: 800; }\n    .btn-mobile-wa { background: #25D366; color: white; }\n\n    /* MOBILE TWEAKS */\n    .device-container.mobile-view .topbar { display: none; }\n    .device-container.mobile-view .nav-links, .device-container.mobile-view .btn-donasi-header { display: none; }\n    .device-container.mobile-view .navbar { padding: 12px 18px; padding-top: 28px; }\n    .device-container.mobile-view .program-detail-card, .device-container.mobile-view .program-detail-card:nth-child(even) { grid-template-columns: 1fr; }\n    .device-container.mobile-view .program-detail-card:nth-child(even) .program-visual-side { order: 0; border-left: none; border-bottom: 1px solid var(--border-color); }\n    .device-container.mobile-view .program-visual-side { border-right: none; border-bottom: 1px solid var(--border-color); padding: 24px 16px; }\n    .device-container.mobile-view .program-info-side { padding: 24px 18px; }\n    .device-container.mobile-view .footer-content { grid-template-columns: 1fr; gap: 20px; }\n    .device-container.mobile-view .mobile-bottom-bar { display: flex; }\n  </style>\n<header class=\"page-hero\">\n        <h2>3 Pilar Program <span>LAZ Wanita Islam</span></h2>\n        <p>Disalurkan secara tepat sasaran, terukur, dan berkelanjutan untuk mengangkat martabat mustahik perempuan dan ketahanan keluarga di wilayah tertinggal.</p>\n      </header>\n\n      <!-- DETAIL PROGRAM -->\n      <main class=\"programs-container\">\n        \n        <!-- PROGRAM 1: UMKM PEREMPUAN -->\n        <article class=\"program-detail-card\">\n          <div class=\"program-visual-side\">\n            <i class=\"fa-solid fa-store\" style=\"font-size: 54px; margin-bottom: 12px; color: var(--lilac-primary);\"></i>\n            <strong style=\"font-size: 15px; font-family: var(--font-heading);\">[ Foto Ibu Pelaku Usaha Binaan ]</strong>\n            <span style=\"font-size: 12px; color: var(--text-muted); margin-top: 4px;\">Dokumentasi asli pendampingan warung makan / kerajinan ibu-ibu di DIY</span>\n          </div>\n          <div class=\"program-info-side\">\n            <span class=\"program-pill\">Pilar 1: Kemandirian Ekonomi</span>\n            <h3>Penguatan Modal Usaha Bebas Riba (Ibu Tangguh)</h3>\n            <p>\n              Program permodalan bergulir qardhul hasan (tanpa bunga) dan pelatihan manajemen keuangan rumah tangga yang dirancang khusus untuk memutus jeratan rentenir keliling dan pinjaman online ilegal yang mengancam keutuhan keluarga miskin.\n            </p>\n            <div class=\"impact-points\">\n              <strong>Fokus Intervensi:</strong>\n              <ul>\n                <li>Suntikan modal alat dan bahan baku usaha mikro rumahan.</li>\n                <li>Mentoring pencatatan kas harian & literasi syariah bebas bunga.</li>\n                <li>Pemberdayaan kelompok usaha bersama berbasis majelis taklim perempuan.</li>\n              </ul>\n            </div>\n            <a href=\"tunaikan-zakat.html\" class=\"btn-act-program\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Ulurkan Bantuan untuk Program Ini</a>\n          </div>\n        </article>\n\n        <!-- PROGRAM 2: TANGGAP BENCANA & KARHUTLA -->\n        <article class=\"program-detail-card\">\n          <div class=\"program-visual-side\">\n            <i class=\"fa-solid fa-fire-flame-curved\" style=\"font-size: 54px; margin-bottom: 12px; color: var(--lilac-primary);\"></i>\n            <strong style=\"font-size: 15px; font-family: var(--font-heading);\">[ Foto Posko Kemanusiaan ]</strong>\n            <span style=\"font-size: 12px; color: var(--text-muted); margin-top: 4px;\">Dokumentasi aksi lapangan bencana di Aceh & respons tanggap karhutla</span>\n          </div>\n          <div class=\"program-info-side\">\n            <span class=\"program-pill\">Pilar 2: Tanggap Darurat & Sosial</span>\n            <h3>Respons Cepat Kemanusiaan, Kebencanaan & Karhutla</h3>\n            <p>\n              Memanfaatkan rekam jejak panjang relawan Wanita Islam dalam merespons bencana alam di berbagai titik (seperti penanganan banjir, gempa, hingga kabut asap karhutla) dengan pendekatan ramah ibu dan anak.\n            </p>\n            <div class=\"impact-points\">\n              <strong>Fokus Intervensi:</strong>\n              <ul>\n                <li>Dapur umum higienis khusus nutrisi balita, ibu hamil, dan lansia.</li>\n                <li>Penyaluran hygiene kit wanita dan perlengkapan bayi darurat.</li>\n                <li>Bantuan oksigen & masker medis di kawasan terdampak kebakaran hutan.</li>\n              </ul>\n            </div>\n            <a href=\"tunaikan-zakat.html\" class=\"btn-act-program\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Ulurkan Bantuan untuk Program Ini</a>\n          </div>\n        </article>\n\n        <!-- PROGRAM 3: PENDIDIKAN & SEKOLAH DARURAT -->\n        <article class=\"program-detail-card\">\n          <div class=\"program-visual-side\">\n            <i class=\"fa-solid fa-school\" style=\"font-size: 54px; margin-bottom: 12px; color: var(--lilac-primary);\"></i>\n            <strong style=\"font-size: 15px; font-family: var(--font-heading);\">[ Foto Ruang Belajar Anak ]</strong>\n            <span style=\"font-size: 12px; color: var(--text-muted); margin-top: 4px;\">Dokumentasi sekolah darurat & senyum anak-anak penerima beasiswa</span>\n          </div>\n          <div class=\"program-info-side\">\n            <span class=\"program-pill\">Pilar 3: Pendidikan Generasi</span>\n            <h3>Ruang Belajar & Sekolah Darurat Ramah Anak</h3>\n            <p>\n              Memastikan tidak ada anak yang kehilangan hak belajarnya akibat kemiskinan ekstrem atau fasilitas sekolah yang hancur pascabencana. Lembaga menyediakan ruang kelas tenda, alat tulis, dan beasiswa yatim dhuafa.\n            </p>\n            <div class=\"impact-points\">\n              <strong>Fokus Intervensi:</strong>\n              <ul>\n                <li>Pendirian tenda sekolah darurat dan pojok baca ceria anak.</li>\n                <li>Bantuan paket seragam, tas, dan alat tulis untuk anak pedalaman.</li>\n                <li>Pendampingan trauma healing pascabencana oleh konselor perempuan.</li>\n              </ul>\n            </div>\n            <a href=\"tunaikan-zakat.html\" class=\"btn-act-program\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Ulurkan Bantuan untuk Program Ini</a>\n          </div>\n        </article>\n\n      </main>\n\n      "
              }
            }
          ]
        }
      ]
    }
  ]
}