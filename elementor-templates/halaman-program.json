              "id": "c092ea4dhtml",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Program Pemberdayaan - LAZ Wanita Islam</title>\n  \n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n  \n  <style>\n    :root {\n      --lilac-primary: #54366F;\n      --lilac-dark: #3D2452;\n      --lilac-light: #F5F0FA;\n      --lilac-soft: #D9C9E8;\n      --gold-accent: #C5A46D;\n      --gold-gradient: linear-gradient(135deg, #E6D2AD 0%, #C5A46D 50%, #9E7D47 100%);\n      --text-dark: #22222B;\n      --text-muted: #666675;\n      --bg-gray: #F8F9FA;\n      --white: #FFFFFF;\n      --border-color: #E6E4EA;\n      --font-heading: 'Plus Jakarta Sans', sans-serif;\n      --font-body: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body { font-family: var(--font-body); background-color: #181820; color: var(--text-dark); padding: 20px; }\n\n    /* TOOLBAR */\n    .preview-header {\n      max-width: 1240px; margin: 0 auto 20px auto; background: #242430; padding: 14px 24px;\n      border-radius: 14px; display: flex; justify-content: space-between; align-items: center; color: white;\n    }\n    .preview-title { font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px; }\n    .preview-title span { background: var(--lilac-primary); color: white; padding: 3px 10px; border-radius: 6px; font-size: 11px; }\n\n    .nav-page-tabs { display: flex; gap: 8px; }\n    .page-tab-btn {\n      background: #1A1A24; border: 1px solid #3E3E54; color: #CCC; padding: 6px 14px;\n      border-radius: 6px; font-size: 12px; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 6px;\n    }\n    .page-tab-btn.active { background: var(--lilac-primary); border-color: var(--gold-accent); color: white; }\n\n    .view-switcher { display: flex; background: #14141C; padding: 4px; border-radius: 8px; gap: 4px; }\n    .btn-switch {\n      background: transparent; border: none; color: #9A9AA6; padding: 6px 14px; font-size: 12px;\n      font-weight: 600; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 6px;\n    }\n    .btn-switch.active { background: var(--lilac-primary); color: white; }\n\n    /* VIEWPORT */\n    .viewport-wrapper { display: flex; justify-content: center; padding-bottom: 60px; }\n    .device-container { background: white; transition: all 0.3s ease; position: relative; box-shadow: 0 10px 40px rgba(0,0,0,0.4); }\n    .device-container.desktop-view { width: 100%; max-width: 1200px; border-radius: 12px; overflow: hidden; }\n    .device-container.mobile-view { width: 390px; min-height: 844px; border-radius: 40px; border: 12px solid #2B2B36; overflow: hidden; margin: 20px 0; }\n    \n    .mobile-notch { display: none; width: 140px; height: 24px; background: #2B2B36; position: absolute; top: 0; left: 50%; transform: translateX(-50%); border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; z-index: 1000; }\n    .device-container.mobile-view .mobile-notch { display: block; }\n\n    /* STYLES */\n    .topbar {\n      background: linear-gradient(90deg, #3E1E52 0%, #54366F 50%, #46225B 100%);\n      color: white; padding: 9px 30px; font-size: 12px; display: flex; justify-content: space-between; align-items: center;\n      border-bottom: 1px solid rgba(212, 175, 55, 0.25);\n    }\n    .topbar a { color: #E2D5EC; text-decoration: none; margin-left: 15px; }\n\n    .navbar {\n      display: flex; justify-content: space-between; align-items: center; padding: 16px 30px; background: white;\n      border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 100;\n    }\n    .brand-logo { display: flex; align-items: center; gap: 14px; }\n    .logo-badge {\n      width: 46px; height: 46px; background: linear-gradient(135deg, var(--lilac-primary), var(--lilac-dark));\n      border: 2px solid var(--gold-accent); border-radius: 12px; display: flex; align-items: center; justify-content: center;\n      color: white; font-weight: 800; font-size: 19px; font-family: var(--font-heading);\n    }\n    .brand-text h1 { font-size: 17px; font-weight: 800; color: var(--lilac-dark); line-height: 1.1; font-family: var(--font-heading); }\n    .brand-text span { font-size: 11px; color: var(--text-muted); }\n    .nav-links { display: flex; list-style: none; gap: 24px; align-items: center; }\n    .nav-links a { text-decoration: none; color: var(--text-dark); font-size: 14px; font-weight: 600; }\n    .nav-links a.active { color: var(--lilac-primary); font-weight: 700; }\n    \n    .btn-donasi-header {\n      background: var(--gold-gradient); color: #362203 !important; padding: 10px 22px; border-radius: 20px;\n      font-size: 13px !important; font-weight: 800 !important; box-shadow: 0 4px 15px rgba(197, 154, 63, 0.45);\n      border: 1px solid #C5A46D !important;\n    }\n\n    /* HERO */\n    .page-hero {\n      background: linear-gradient(135deg, #4A2761 0%, #54366F 100%);\n      color: white; padding: 50px 30px; text-align: center;\n    }\n    .page-hero h2 { font-family: var(--font-heading); font-size: 36px; margin-bottom: 10px; font-weight: 700; }\n    .page-hero h2 span { color: #F5D77F; }\n    .page-hero p { font-size: 15px; color: #EBDCF5; max-width: 700px; margin: 0 auto; line-height: 1.6; }\n\n    /* PROGRAM DETAIL ITEMS */\n    .programs-container { padding: 50px 30px; }\n    \n    .program-detail-card {\n      background: white; border: 1px solid var(--border-color); border-radius: 16px; overflow: hidden;\n      margin-bottom: 36px; display: grid; grid-template-columns: 1fr 1.4fr; box-shadow: 0 4px 20px rgba(0,0,0,0.03);\n    }\n    .program-detail-card:nth-child(even) { grid-template-columns: 1.4fr 1fr; }\n    .program-detail-card:nth-child(even) .program-visual-side { order: 2; }\n    .program-detail-card:nth-child(even) .program-info-side { order: 1; }\n\n    .program-visual-side {\n      background: #EFE9F5; border-right: 1px solid var(--border-color); display: flex; flex-direction: column;\n      align-items: center; justify-content: center; padding: 40px 20px; text-align: center; color: var(--lilac-dark);\n    }\n    .program-detail-card:nth-child(even) .program-visual-side { border-right: none; border-left: 1px solid var(--border-color); }\n\n    .program-info-side { padding: 36px; display: flex; flex-direction: column; justify-content: center; }\n    .program-pill {\n      font-size: 11px; font-weight: 700; color: var(--gold-accent); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.5px;\n    }\n    .program-info-side h3 { font-family: var(--font-heading); font-size: 24px; color: var(--lilac-dark); margin-bottom: 12px; }\n    .program-info-side p { font-size: 14px; color: #555566; line-height: 1.7; margin-bottom: 16px; }\n    \n    .impact-points {\n      background: var(--lilac-light); border-radius: 10px; padding: 14px 18px; margin-bottom: 20px; font-size: 13px; color: #4B3A5A;\n    }\n    .impact-points li { margin-left: 18px; margin-bottom: 6px; }\n\n    .btn-act-program {\n      align-self: flex-start; background: var(--gold-gradient); color: #362203; text-decoration: none;\n      padding: 11px 24px; border-radius: 8px; font-size: 13px; font-weight: 800; border: 1px solid #C5A46D;\n      box-shadow: 0 4px 12px rgba(197, 154, 63, 0.35); display: inline-flex; align-items: center; gap: 8px;\n    }\n\n    /* FOOTER */\n    footer.site-footer.dynamic-footer, .site-footer {\n      background: linear-gradient(135deg, #3B1B4F 0%, #4F2D64 60%, #351747 100%);\n      color: white; padding: 45px 30px 24px 30px; font-size: 13px; border-top: 3px solid #C5A46D;\n    }\n    .footer-content { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 30px; margin-bottom: 30px; }\n    .footer-brand h4 { font-size: 20px; font-weight: 700; margin-bottom: 10px; color: var(--gold-accent); font-family: var(--font-heading); }\n    .footer-brand p { color: #DDD4E4; line-height: 1.6; }\n    .footer-col h5 { font-size: 15px; font-weight: 700; margin-bottom: 12px; color: white; font-family: var(--font-heading); }\n    .footer-col ul { list-style: none; }\n    .footer-col li { margin-bottom: 8px; }\n    .footer-col a { color: #DDD4E4; text-decoration: none; }\n    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.15); padding-top: 16px; text-align: center; color: #BBA9CA; font-size: 12px; }\n\n    /* STICKY BOTTOM BAR & BACK-TO-TOP (PERSIS BENCHMARK DOMPET DHUAFA) */\n    .mobile-bottom-bar {\n      display: none;\n      position: sticky;\n      bottom: 0;\n      left: 0;\n      right: 0;\n      background: #FFFFFF;\n      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);\n      padding: 6px 16px 10px 16px;\n      border-top: 1px solid rgba(0, 0, 0, 0.06);\n      z-index: 999;\n      align-items: center;\n      justify-content: space-between;\n      overflow: visible;\n    }\n\n        /* TOMBOL SCROLL TO TOP ALA DOMPET DHUAFA (SEJAJAR CENTER DI ATAS TAB BERANDA) */\n    .mobile-back-to-top {\n      position: absolute;\n      bottom: calc(100% + 6px);\n      left: 50%;\n      transform: translateX(-50%);\n      width: 44px;\n      height: 32px;\n      background: linear-gradient(180deg, #6A448C 0%, var(--lilac-primary) 100%);\n      border-top-left-radius: 12px;\n      border-top-right-radius: 12px;\n      border-bottom-left-radius: 0;\n      border-bottom-right-radius: 0;\n      border: 1.5px solid rgba(255, 255, 255, 0.7);\n      border-bottom: none;\n      color: #FFFFFF;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 15px;\n      cursor: pointer;\n      opacity: 0.85;\n      transition: opacity 0.3s ease, transform 0.2s ease;\n      box-shadow: 0 -4px 12px rgba(84, 54, 111, 0.25);\n      z-index: 998;\n    }\n    .mobile-back-to-top:hover,\n    .mobile-back-to-top:active {\n      opacity: 1 !important;\n      transform: translateX(-50%) translateY(-2px);\n    }\n\n    .btn-mobile-nav-tab {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      text-decoration: none;\n      color: #4A4A58;\n      font-size: 11.5px;\n      font-weight: 600;\n      gap: 3px;\n      padding: 4px 10px;\n      min-width: 60px;\n      transition: all 0.2s ease;\n    }\n    .btn-mobile-nav-tab i {\n      font-size: 21px;\n      color: var(--lilac-primary);\n      transition: transform 0.2s ease;\n    }\n    .btn-mobile-nav-tab.tab-layanan i {\n      color: #16A34A;\n    }\n    .btn-mobile-nav-tab:active i {\n      transform: scale(1.15);\n    }\n\n    /* TOMBOL TUNAIKAN TENGAH (FLOATING ELEVATED) */\n    .btn-mobile-donasi-center {\n      height: 48px;\n      padding: 0 24px;\n      margin-top: -18px;\n      background: linear-gradient(135deg, #ECC874 0%, #C59A3F 50%, #9E7422 100%);\n      color: #2A1700 !important;\n      font-weight: 800;\n      font-size: 14.5px;\n      letter-spacing: 0.2px;\n      border-radius: 25px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      text-decoration: none;\n      box-shadow: 0 8px 22px rgba(197, 154, 63, 0.48), 0 2px 6px rgba(0,0,0,0.08);\n      border: 2.5px solid #FFFFFF;\n      transition: transform 0.2s ease, box-shadow 0.2s ease;\n    }\n    .btn-mobile-donasi-center:hover {\n      box-shadow: 0 10px 25px rgba(197, 154, 63, 0.58);\n      transform: translateY(-2px);\n    }\n    .btn-mobile-donasi-center:active {\n      transform: translateY(0);\n    }\n\n    .mobile-right-actions {\n      display: none;\n      align-items: center;\n      gap: 10px;\n    }\n    .mobile-btn-donasi-header {\n      background: var(--gold-gradient);\n      color: #362203 !important;\n      padding: 7px 14px;\n      border-radius: 18px;\n      font-size: 12px !important;\n      font-weight: 800 !important;\n      text-decoration: none;\n      display: inline-flex;\n      align-items: center;\n      gap: 5px;\n      border: 1px solid #C5A46D;\n      box-shadow: 0 2px 8px rgba(197, 164, 109, 0.35);\n    }\n    .hamburger-btn {\n      background: transparent;\n      border: 1px solid var(--border-color);\n      padding: 7px 11px;\n      border-radius: 8px;\n      font-size: 16px;\n      color: var(--lilac-primary);\n      cursor: pointer;\n    }\n\n    .mobile-drawer-menu {\n      display: none;\n      background: #FFFFFF;\n      border-top: 1px solid var(--border-color);\n      padding: 16px 20px;\n      box-shadow: 0 10px 25px rgba(0,0,0,0.08);\n    }\n    .mobile-drawer-menu.active {\n      display: block;\n      animation: slideDown 0.3s ease;\n    }\n    .mobile-drawer-links {\n      list-style: none;\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      margin-bottom: 14px;\n    }\n    .mobile-drawer-links a {\n      text-decoration: none;\n      color: var(--text-dark);\n      font-size: 14px;\n      font-weight: 600;\n      display: flex;\n      align-items: center;\n      padding: 8px 0;\n      border-bottom: 1px solid #F3F4F6;\n    }\n    .mobile-drawer-links a:hover { color: var(--lilac-primary); }\n\n    /* MOBILE TWEAKS */\n    .device-container.mobile-view .topbar { display: none; }\n    .device-container.mobile-view .nav-links, .device-container.mobile-view .btn-donasi-header { display: none; }\n    .device-container.mobile-view .mobile-right-actions { display: flex !important; }\n    .device-container.mobile-view .navbar { padding: 10px 16px !important; justify-content: space-between !important; flex-direction: row !important; }\n    .device-container.mobile-view .program-detail-card, .device-container.mobile-view .program-detail-card:nth-child(even) { grid-template-columns: 1fr; }\n    .device-container.mobile-view .program-detail-card:nth-child(even) .program-visual-side { order: 0; border-left: none; border-bottom: 1px solid var(--border-color); }\n    .device-container.mobile-view .program-visual-side { border-right: none; border-bottom: 1px solid var(--border-color); padding: 24px 16px; }\n    .device-container.mobile-view .program-info-side { padding: 24px 18px; }\n    .device-container.mobile-view .footer-content { grid-template-columns: 1fr; gap: 20px; }\n    .device-container.mobile-view .mobile-bottom-bar { display: flex; }\n\n    /* MEDIA QUERY RESPONSIVE REAL DEVICE (SMARTPHONE) */\n    @media (max-width: 768px) {\n      body { padding: 0 !important; }\n      .preview-header { display: none !important; }\n      .viewport-wrapper { padding: 0 !important; }\n      .device-container { border-radius: 0 !important; border: none !important; box-shadow: none !important; max-width: 100% !important; width: 100% !important; }\n      .topbar { display: none !important; }\n      .navbar { padding: 10px 16px !important; justify-content: space-between !important; flex-direction: row !important; position: sticky !important; top: 0 !important; z-index: 1000 !important; }\n      .nav-links, .btn-donasi-header { display: none !important; }\n      .mobile-right-actions { display: flex !important; }\n      .page-hero { padding: 30px 16px !important; }\n      .page-hero h2 { font-size: 26px !important; }\n      .programs-container { padding: 20px 16px !important; }\n      .program-detail-card, .program-detail-card:nth-child(even) { grid-template-columns: 1fr !important; }\n      .program-visual-side { border-right: none !important; border-bottom: 1px solid var(--border-color) !important; padding: 20px 16px !important; }\n      .program-detail-card:nth-child(even) .program-visual-side { order: 0 !important; border-left: none !important; border-bottom: 1px solid var(--border-color) !important; }\n      .footer-content { grid-template-columns: 1fr !important; gap: 20px !important; }\n      .mobile-bottom-bar { display: flex !important; }\n    }\n  </style>\n</head>\n<body>\n\n  <!-- TOOLBAR -->\n  <div class=\"preview-header\">\n    <div class=\"preview-title\">\n      <i class=\"fa-solid fa-hand-holding-heart\" style=\"color: var(--gold-accent);\"></i>\n      <span>HALAMAN 3</span> Program Pemberdayaan & Aksi Nyata\n    </div>\n    \n    <div class=\"nav-page-tabs\">\n      <a href=\"index.html\" class=\"page-tab-btn\"><i class=\"fa-solid fa-home\"></i> Beranda</a>\n      <a href=\"tentang-kami.html\" class=\"page-tab-btn\"><i class=\"fa-solid fa-landmark\"></i> Tentang Kami</a>\n      <a href=\"program.html\" class=\"page-tab-btn active\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Program</a>\n      <a href=\"tunaikan-zakat.html\" class=\"page-tab-btn\"><i class=\"fa-solid fa-qrcode\"></i> ZIS & Rekening</a>\n      </div>\n\n    <div class=\"view-switcher\">\n      <button class=\"btn-switch active\" id=\"btnDesktop\" onclick=\"setMode('desktop')\"><i class=\"fa-solid fa-laptop\"></i> Desktop</button>\n      <button class=\"btn-switch\" id=\"btnMobile\" onclick=\"setMode('mobile')\"><i class=\"fa-solid fa-mobile-screen\"></i> HP</button>\n    </div>\n  </div>\n\n  <!-- CONTAINER PREVIEW -->\n  <div class=\"viewport-wrapper\">\n    <div class=\"device-container desktop-view\" id=\"deviceFrame\">\n      <div class=\"mobile-notch\"></div>\n\n      <!-- TOPBAR -->\n      <div class=\"topbar\">\n        <div><i class=\"fa-solid fa-award\" style=\"color: var(--gold-accent);\"></i> Badan Khusus Ormas Wanita Islam | Menjaga Amanah, Menguatkan Keluarga</div>\n        <div>\n          <a href=\"https://www.instagram.com/laz.wanitaislam\" target=\"_blank\"><i class=\"fa-brands fa-instagram\"></i> @laz.wanitaislam</a>\n          <a href=\"https://youtube.com/\" target=\"_blank\"><i class=\"fa-brands fa-youtube\"></i> YouTube</a>\n          <a href=\"mailto:sapa@laz.wanitaislam.or.id\"><i class=\"fa-regular fa-envelope\"></i> sapa@laz.wanitaislam.or.id</a>\n        </div>\n      </div>\n\n      <!-- NAVBAR -->\n      <nav class=\"navbar\">\n        <div class=\"brand-logo\">\n          <a href=\"index.html\">\n            <img src=\"https://laz.wanitaislam.or.id/wp-content/uploads/2026/11/logo-lazwi-fa02-web.webp\" alt=\"Logo LAZ Wanita Islam\" style=\"height: 48px; width: auto; display: block;\">\n          </a>\n        </div>\n        <ul class=\"nav-links\">\n          <li><a href=\"index.html\">Beranda</a></li>\n          <li><a href=\"tentang-kami.html\">Tentang Kami</a></li>\n          <li><a href=\"program.html\" class=\"active\">Program</a></li>\n          <li><a href=\"kabar.html\">Kabar & Cerita</a></li>\n          <li><a href=\"tunaikan-zakat.html\" class=\"btn-donasi-header\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Tunaikan Zakat & Kebaikan</a></li>\n        </ul>\n\n        <!-- ELEMEN KHUSUS HP (ALA DOMPET DHUAFA) -->\n        <div class=\"mobile-right-actions\">\n          <a href=\"tunaikan-zakat.html\" class=\"mobile-btn-donasi-header\">\n            <i class=\"fa-solid fa-heart\"></i> Tunaikan\n          </a>\n          <button class=\"hamburger-btn\" onclick=\"toggleMobileNav()\" aria-label=\"Menu\">\n            <i class=\"fa-solid fa-bars\" id=\"mobileNavIcon\"></i>\n          </button>\n        </div>\n      </nav>\n\n      <!-- DRAWER MENU MOBILE -->\n      <div class=\"mobile-drawer-menu\" id=\"mobileNavDrawer\">\n        <ul class=\"mobile-drawer-links\">\n          <li><a href=\"index.html\"><i class=\"fa-solid fa-house\" style=\"width: 24px; color: var(--gold-accent);\"></i> Beranda</a></li>\n          <li><a href=\"tentang-kami.html\"><i class=\"fa-solid fa-landmark\" style=\"width: 24px; color: var(--gold-accent);\"></i> Tentang Kami</a></li>\n          <li><a href=\"program.html\"><i class=\"fa-solid fa-hand-holding-heart\" style=\"width: 24px; color: var(--gold-accent);\"></i> Program Pemberdayaan</a></li>\n          <li><a href=\"kabar.html\"><i class=\"fa-solid fa-newspaper\" style=\"width: 24px; color: var(--gold-accent);\"></i> Kabar & Cerita</a></li>\n        </ul>\n\n        <!-- LAYANAN DONATUR PERSIS DOMPET DHUAFA -->\n        <div style=\"margin-top: 24px; padding: 20px 0 8px 0; border-top: 1px solid #ECECEC; font-family: 'Plus Jakarta Sans', sans-serif;\">\n          <div style=\"font-size: 16px; font-weight: 700; color: #22222B; margin-bottom: 16px; letter-spacing: -0.2px;\">Layanan Donatur</div>\n          <div style=\"display: flex; flex-direction: column; gap: 15px; font-size: 15px; color: #2C2C35; font-weight: 500;\">\n            \n            <a href=\"https://wa.me/\" target=\"_blank\" style=\"color: #2C2C35; text-decoration: none; display: flex; align-items: center; gap: 14px;\">\n              <i class=\"fa-brands fa-whatsapp\" style=\"color: #16A34A; font-size: 20px; width: 22px; text-align: center;\"></i>\n              <span>WhatsApp: Layanan Donatur</span>\n            </a>\n\n            <a href=\"mailto:sapa@laz.wanitaislam.or.id\" style=\"color: #2C2C35; text-decoration: none; display: flex; align-items: center; gap: 14px;\">\n              <i class=\"fa-regular fa-envelope\" style=\"color: #16A34A; font-size: 18px; width: 22px; text-align: center;\"></i>\n              <span>sapa@laz.wanitaislam.or.id</span>\n            </a>\n\n            <a href=\"https://www.instagram.com/laz.wanitaislam\" target=\"_blank\" style=\"color: #2C2C35; text-decoration: none; display: flex; align-items: center; gap: 14px;\">\n              <i class=\"fa-brands fa-instagram\" style=\"color: #16A34A; font-size: 20px; width: 22px; text-align: center;\"></i>\n              <span>Instagram: @laz.wanitaislam</span>\n            </a>\n\n            <a href=\"tunaikan-zakat.html#rekeningZakat\"  style=\"color: #2C2C35; text-decoration: none; display: flex; align-items: center; gap: 14px;\">\n              <i class=\"fa-solid fa-wallet\" style=\"color: #16A34A; font-size: 18px; width: 22px; text-align: center;\"></i>\n              <span>Rekening Donasi</span>\n            </a>\n\n          </div>\n        </div>\n      </div>\n\n      <!-- PAGE HERO -->\n      <header class=\"page-hero\">\n        <h2>5 Pilar Program Utama <span>LAZ Wanita Islam</span></h2>\n        <p>Disalurkan secara tepat sasaran, terukur, dan berkelanjutan untuk mengangkat martabat mustahik perempuan dan ketahanan keluarga di wilayah tertinggal.</p>\n      </header>\n\n      <!-- DETAIL PROGRAM -->\n      <main class=\"programs-container\">\n        \n        <!-- PILAR 1: KEMANDIRIAN EKONOMI (UMKM IBU TANGGUH) -->\n        <article class=\"program-detail-card\">\n          <div class=\"program-visual-side\" style=\"padding:0;overflow:hidden;background:#241434;\">\n            <img src=\"assets/programs/pilar-1-ekonomi.jpg\" alt=\"Pilar 1 - Kemandirian Ekonomi UMKM Ibu Tangguh\" style=\"width:100%;height:100%;min-height:280px;object-fit:cover;\">\n          </div>\n          <div class=\"program-info-side\">\n            <span class=\"program-pill\">Pilar 1: Kemandirian Ekonomi</span>\n            <h3>Penguatan Modal Usaha Bebas Riba (Ibu Tangguh)</h3>\n            <p>\n              Program permodalan bergulir qardhul hasan (tanpa bunga) dan inkubasi usaha mikro rumahan yang dirancang khusus untuk memutus jeratan rentenir keliling dan pinjaman online ilegal yang mengancam keutuhan keluarga miskin.\n            </p>\n            <div class=\"impact-points\">\n              <strong>Fokus Intervensi:</strong>\n              <ul>\n                <li>Suntikan modal alat produksi dan bahan baku usaha mikro rumahan.</li>\n                <li>Mentoring pencatatan kas harian & literasi syariah bebas bunga.</li>\n                <li>Pemberdayaan kelompok usaha bersama berbasis majelis taklim perempuan.</li>\n              </ul>\n            </div>\n            <a href=\"tunaikan-zakat.html\" class=\"btn-act-program\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Ulurkan Bantuan untuk Program Ini</a>\n          </div>\n        </article>\n\n        <!-- PILAR 2: PENDIDIKAN GENERASI -->\n        <article class=\"program-detail-card\">\n          <div class=\"program-visual-side\" style=\"padding:0;overflow:hidden;background:#241434;\">\n            <img src=\"assets/programs/pilar-2-pendidikan.jpg\" alt=\"Pilar 2 - Pendidikan Generasi & Beasiswa Dhuafa\" style=\"width:100%;height:100%;min-height:280px;object-fit:cover;\">\n          </div>\n          <div class=\"program-info-side\">\n            <span class=\"program-pill\">Pilar 2: Pendidikan Generasi</span>\n            <h3>Ruang Belajar, Sekolah Ramah Anak & Beasiswa</h3>\n            <p>\n              Memastikan tidak ada anak yang kehilangan hak belajarnya akibat kemiskinan ekstrem atau bencana alam. LAZWI menghadirkan beasiswa yatim dhuafa, sekolah darurat, perlengkapan belajar, dan pendampingan karakter Islami.\n            </p>\n            <div class=\"impact-points\">\n              <strong>Fokus Intervensi:</strong>\n              <ul>\n                <li>Beasiswa pendidikan santri, pelajar yatim, dan dhuafa di wilayah 3T.</li>\n                <li>Pendirian ruang kelas tenda ramah anak & pojok literasi desa.</li>\n                <li>Distribusi paket perlengkapan sekolah lengkap & pendampingan trauma healing.</li>\n              </ul>\n            </div>\n            <a href=\"tunaikan-zakat.html\" class=\"btn-act-program\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Ulurkan Bantuan untuk Program Ini</a>\n          </div>\n        </article>\n\n        <!-- PILAR 3: KESEHATAN IBU & ANAK -->\n        <article class=\"program-detail-card\">\n          <div class=\"program-visual-side\" style=\"padding:0;overflow:hidden;background:#241434;\">\n            <img src=\"assets/programs/pilar-3-kesehatan.jpg\" alt=\"Pilar 3 - Kesehatan Ibu, Balita & Bebas Stunting\" style=\"width:100%;height:100%;min-height:280px;object-fit:cover;\">\n          </div>\n          <div class=\"program-info-side\">\n            <span class=\"program-pill\">Pilar 3: Kesehatan Ibu & Anak</span>\n            <h3>Gizi Sehat Balita, Ibu Hamil & Bebas Stunting</h3>\n            <p>\n              Intervensi gizi terpadu untuk menyelamatkan 1.000 Hari Pertama Kehidupan (HPK). Bekerja sama dengan Posyandu binaan untuk memantau tumbuh kembang balita, memberi asupan PMT bergizi, dan skrining medis ibu hamil prasejahtera.\n            </p>\n            <div class=\"impact-points\">\n              <strong>Fokus Intervensi:</strong>\n              <ul>\n                <li>Paket Pemberian Makanan Tambahan (PMT) nutrisi tinggi untuk balita wasting & stunting.</li>\n                <li>Pemeriksaan kesehatan, vitamin penambah darah, dan suplemen ibu hamil dhuafa.</li>\n                <li>Layanan skrining kesehatan lansia dhuafa dan penyuluhan sanitasi keluarga sehat.</li>\n              </ul>\n            </div>\n            <a href=\"tunaikan-zakat.html\" class=\"btn-act-program\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Ulurkan Bantuan untuk Program Ini</a>\n          </div>\n        </article>\n\n        <!-- PILAR 4: TANGGAP BENCANA & KEMANUSIAAN -->\n        <article class=\"program-detail-card\">\n          <div class=\"program-visual-side\" style=\"padding:0;overflow:hidden;background:#241434;\">\n            <img src=\"assets/programs/pilar-4-kemanusiaan.jpg\" alt=\"Pilar 4 - Kemanusiaan & Tanggap Bencana\" style=\"width:100%;height:100%;min-height:280px;object-fit:cover;\">\n          </div>\n          <div class=\"program-info-side\">\n            <span class=\"program-pill\">Pilar 4: Kemanusiaan & Bencana</span>\n            <h3>Respons Cepat Kemanusiaan, Kebencanaan & Karhutla</h3>\n            <p>\n              Memanfaatkan jejaring relawan perempuan Wanita Islam di seluruh Indonesia dalam merespons tanggap darurat bencana alam dengan pendekatan ramah ibu menyusui, balita, dan lansia.\n            </p>\n            <div class=\"impact-points\">\n              <strong>Fokus Intervensi:</strong>\n              <ul>\n                <li>Dapur umum higienis khusus pemenuhan nutrisi balita dan ibu menyusui di posko pengungsian.</li>\n                <li>Distribusi paket sembako, hygiene kit perempuan, dan popok/susu formula darurat.</li>\n                <li>Penyaluran tabung oksigen, masker medis, dan posko udara bersih karhutla.</li>\n              </ul>\n            </div>\n            <a href=\"tunaikan-zakat.html\" class=\"btn-act-program\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Ulurkan Bantuan untuk Program Ini</a>\n          </div>\n        </article>\n\n        <!-- PILAR 5: DAKWAH & KETAHANAN KELUARGA SAKINAH -->\n        <article class=\"program-detail-card\">\n          <div class=\"program-visual-side\" style=\"padding:0;overflow:hidden;background:#241434;\">\n            <img src=\"assets/programs/pilar-5-dakwah-keluarga.jpg\" alt=\"Pilar 5 - Dakwah & Ketahanan Keluarga Sakinah\" style=\"width:100%;height:100%;min-height:280px;object-fit:cover;\">\n          </div>\n          <div class=\"program-info-side\">\n            <span class=\"program-pill\">Pilar 5: Dakwah & Advokasi</span>\n            <h3>Ketahanan Keluarga Sakinah & Syiar Islam</h3>\n            <p>\n              Membangun fondasi spiritual umat melalui pembinaan majelis taklim perempuan, konseling keluarga sakinah, parenting Islami, advokasi hak-hak perempuan dan anak, serta perluasan literasi ZISWAF.\n            </p>\n            <div class=\"impact-points\">\n              <strong>Fokus Intervensi:</strong>\n              <ul>\n                <li>Binaan rutin majelis taklim ibu-ibu pedesaan dan pengentasan buta aksara Al-Qur'an.</li>\n                <li>Pusat konsultasi & mediasi ketahanan keluarga sakinah mawaddah warahmah.</li>\n                <li>Advokasi perlindungan hak perempuan dhuafa dan edukasi zakat produktif.</li>\n              </ul>\n            </div>\n            <a href=\"tunaikan-zakat.html\" class=\"btn-act-program\"><i class=\"fa-solid fa-hand-holding-heart\"></i> Ulurkan Bantuan untuk Program Ini</a>\n          </div>\n        </article>\n\n      </main>\n\n      <!-- FOOTER -->\n      <footer class=\"site-footer dynamic-footer\" style=\"max-width:100%;width:100%;margin:0;\">\n        <div class=\"footer-content\">\n          <div class=\"footer-brand\">\n            <h4>LAZ WANITA ISLAM</h4>\n            <p>Badan Khusus Organisasi Kemasyarakatan Wanita Islam. Berkhidmat mengangkat harkat perempuan dan ketahanan keluarga berbasis syariat Islam.</p>\n          </div>\n          <div class=\"footer-col\">\n            <h5>Navigasi</h5>\n            <ul>\n              <li><a href=\"index.html\">Beranda</a></li>\n              <li><a href=\"tentang-kami.html\">Tentang Kami & Sejarah</a></li>\n              <li><a href=\"program.html\">Program Pemberdayaan</a></li>\n              </ul>\n          </div>\n          <div class=\"footer-col\">\n            <h5>Layanan & Sekretariat</h5>\n            <p style=\"color: #DDD4E4; font-size: 13px; line-height: 1.6;\">\n              Kantor Pusat Wanita Islam<br>\n              Instagram: <a href=\"https://www.instagram.com/laz.wanitaislam\" target=\"_blank\" style=\"color: #E2D5EC; text-decoration: none;\">@laz.wanitaislam</a><br>YouTube: LAZ Wanita Islam Official<br>\n              Email: sapa@laz.wanitaislam.or.id\n            </p>\n          </div>\n        </div>\n        <div class=\"footer-bottom\">\n          &copy; 2026 LAZ Wanita Islam. Hak Cipta Dilindungi Undang-Undang.\n        </div>\n      </footer>\n\n      <!-- MOBILE BOTTOM BAR PERSIS DOMPET DHUAFA (BERANDA - TUNAIKAN TENGAH - LAYANAN + BACK TO TOP SEJAJAR) -->\n      <div class=\"mobile-bottom-bar\">\n        <!-- 1. KIRI: BERANDA & TOMBOL BACK TO TOP PERSIS SEJAJAR CENTER -->\n        <div style=\"position: relative; display: flex; flex-direction: column; align-items: center;\">\n          <