            {
              "id": "w_html_5pilar",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<!-- ========================================================\n  WIDGET 5 PILAR PROGRAM LAZ WANITA ISLAM (ELEMENTOR READY)\n  PANDUAN GANTI FOTO:\n  1. Upload foto Anda ke menu WordPress: Media > Tambah Baru.\n  2. Salin link berkas foto tersebut (misal: https://laz.wanitaislam.or.id/wp-content/uploads/...jpg).\n  3. Cari teks \"GANTI FOTO PILAR\" di bawah ini, lalu tempelkan link Anda di dalam atribut src=\"...\".\n  Rekomendasi ukuran foto: 1200 x 800 piksel (Rasio 3:2 atau 16:9), format JPG/WebP (maks 300KB).\n======================================================== -->\n\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<style>\n  :root {\n    --lilac-primary: #54366F;\n    --lilac-dark: #3D2452;\n    --lilac-light: #F5F0FA;\n    --lilac-soft: #D9C9E8;\n    --gold-accent: #C5A46D;\n    --gold-gradient: linear-gradient(135deg, #ECC874 0%, #C59A3F 50%, #9E7422 100%);\n    --gold-glow: 0 4px 15px rgba(197, 154, 63, 0.4);\n    --gold-light: #FDF7E7;\n    --text-dark: #22222B;\n    --text-muted: #666675;\n    --bg-gray: #F8F9FA;\n    --border-color: #E6E4EA;\n    --font-heading: 'Plus Jakarta Sans', sans-serif;\n    --font-body: 'Plus Jakarta Sans', sans-serif;\n  }\n\n  .program-section-widget {\n    font-family: var(--font-body);\n    color: var(--text-dark);\n    background: #FFFFFF;\n    padding: 60px 20px 80px 20px;\n    max-width: 100%;\n    margin: 0 auto;\n    box-sizing: border-box;\n  }\n\n  .program-widget-container {\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  /* HEADER SECTION */\n  .program-widget-header {\n    text-align: center;\n    max-width: 760px;\n    margin: 0 auto 45px auto;\n  }\n\n  .program-widget-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--lilac-light);\n    color: var(--lilac-primary);\n    font-size: 12.5px;\n    font-weight: 700;\n    padding: 6px 16px;\n    border-radius: 20px;\n    border: 1px solid var(--lilac-soft);\n    margin-bottom: 14px;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .program-widget-title {\n    font-family: var(--font-heading);\n    font-size: 34px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0 0 14px 0;\n    line-height: 1.25;\n  }\n\n  .program-widget-title span {\n    color: var(--gold-accent);\n  }\n\n  .program-widget-subtitle {\n    font-size: 15px;\n    color: var(--text-muted);\n    line-height: 1.6;\n    margin: 0;\n  }\n\n  /* GRID 5 PILAR */\n  .program-widget-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));\n    gap: 28px;\n  }\n\n  .pilar-card {\n    background: #FFFFFF;\n    border: 1px solid var(--border-color);\n    border-radius: 18px;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    transition: all 0.3s ease;\n    box-shadow: 0 4px 20px rgba(84, 54, 111, 0.04);\n  }\n\n  .pilar-card:hover {\n    transform: translateY(-6px);\n    border-color: var(--lilac-primary);\n    box-shadow: 0 16px 36px rgba(84, 54, 111, 0.12);\n  }\n\n  /* SLOT GAMBAR / MEDIA FOTO */\n  .pilar-img-container {\n    width: 100%;\n    height: 220px;\n    background: linear-gradient(135deg, #3D2452 0%, #54366F 100%);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .pilar-img-container img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    transition: transform 0.4s ease;\n  }\n\n  .pilar-card:hover .pilar-img-container img {\n    transform: scale(1.06);\n  }\n\n  .pilar-badge-tag {\n    position: absolute;\n    top: 14px;\n    left: 14px;\n    background: rgba(84, 54, 111, 0.88);\n    backdrop-filter: blur(8px);\n    -webkit-backdrop-filter: blur(8px);\n    color: #FFFFFF;\n    font-size: 11.5px;\n    font-weight: 700;\n    padding: 5px 12px;\n    border-radius: 20px;\n    border: 1px solid rgba(197, 164, 109, 0.5);\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    z-index: 2;\n  }\n\n  .pilar-body {\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    flex-grow: 1;\n  }\n\n  .pilar-name {\n    font-family: var(--font-heading);\n    font-size: 19px;\n    font-weight: 800;\n    color: var(--lilac-dark);\n    margin: 0 0 10px 0;\n    line-height: 1.35;\n  }\n\n  .pilar-desc {\n    font-size: 13.5px;\n    color: var(--text-muted);\n    line-height: 1.6;\n    margin: 0 0 18px 0;\n  }\n\n  /* POIN INTERVENSI / KEUNGGULAN */\n  .pilar-points {\n    background: var(--lilac-light);\n    border-radius: 12px;\n    padding: 14px 16px;\n    margin-bottom: 22px;\n    border: 1px solid var(--lilac-soft);\n  }\n\n  .pilar-points-title {\n    font-size: 12px;\n    font-weight: 800;\n    color: var(--lilac-primary);\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 8px;\n    display: block;\n  }\n\n  .pilar-points ul {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n\n  .pilar-points li {\n    font-size: 12.5px;\n    color: #4A4A5A;\n    line-height: 1.5;\n    margin-bottom: 6px;\n    position: relative;\n    padding-left: 18px;\n  }\n\n  .pilar-points li:last-child {\n    margin-bottom: 0;\n  }\n\n  .pilar-points li::before {\n    content: \"\u2713\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: var(--gold-accent);\n    font-weight: 800;\n    font-size: 13px;\n  }\n\n  /* TOMBOL DONASI / AKSI */\n  .pilar-footer {\n    margin-top: auto;\n    padding-top: 14px;\n    border-top: 1px solid var(--border-color);\n  }\n\n  .btn-pilar-action {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    width: 100%;\n    padding: 11px 18px;\n    border-radius: 10px;\n    background: var(--lilac-primary);\n    color: #FFFFFF;\n    text-decoration: none;\n    font-size: 13px;\n    font-weight: 700;\n    transition: all 0.25s ease;\n    box-shadow: 0 4px 12px rgba(84, 54, 111, 0.2);\n  }\n\n  .btn-pilar-action:hover {\n    background: var(--lilac-dark);\n    box-shadow: 0 6px 18px rgba(84, 54, 111, 0.35);\n    color: #FFFFFF;\n  }\n\n  .btn-pilar-action i {\n    color: var(--gold-accent);\n  }\n\n  @media (max-width: 768px) {\n    .program-widget-title { font-size: 26px; }\n    .program-widget-grid { grid-template-columns: 1fr; }\n    .pilar-img-container { height: 200px; }\n  }\n</style>\n\n<section class=\"program-section-widget\" id=\"program-unggulan\">\n  <div class=\"program-widget-container\">\n    \n    <!-- HEADER -->\n    <div class=\"program-widget-header\">\n      <div class=\"program-widget-badge\">\n        <i class=\"fa-solid fa-hand-holding-heart\"></i> Program Berkelanjutan\n      </div>\n      <h3 class=\"program-widget-title\">5 Pilar Program <span>LAZ Wanita Islam</span></h3>\n      <p class=\"program-widget-subtitle\">\n        Menyalurkan amanah zakat, infak, sedekah, dan wakaf (ZISWAF) secara profesional, tepat sasaran, dan berkelanjutan untuk mengangkat martabat mustahik perempuan serta mengokohkan ketahanan keluarga di seluruh Indonesia.\n      </p>\n    </div>\n\n    <!-- GRID 5 PILAR PROGRAM -->\n    <div class=\"program-widget-grid\">\n\n      <!-- ==========================================\n           PILAR 1: KEMANDIRIAN EKONOMI\n      ========================================== -->\n      <article class=\"pilar-card\">\n        <div class=\"pilar-img-container\">\n          <span class=\"pilar-badge-tag\"><i class=\"fa-solid fa-store\"></i> Pilar 1: Ekonomi</span>\n          <!-- [GANTI FOTO PILAR 1 DISINI] -->\n          <img src=\"assets/programs/pilar-1-ekonomi.jpg\" alt=\"Pilar 1 - Kemandirian Ekonomi UMKM Ibu Tangguh\">\n        </div>\n        <div class=\"pilar-body\">\n          <h4 class=\"pilar-name\">Kemandirian Ekonomi & UMKM Ibu Tangguh</h4>\n          <p class=\"pilar-desc\">\n            Suntikan modal bergulir qardhul hasan (bebas bunga & bebas riba) serta pendampingan usaha mikro rumahan untuk memutus jeratan rentenir keliling dan pinjol ilegal.\n          </p>\n          <div class=\"pilar-points\">\n            <span class=\"pilar-points-title\">Fokus Intervensi:</span>\n            <ul>\n              <li>Permodalan alat usaha & bahan baku UMKM ibu binaan.</li>\n              <li>Pelatihan literasi keuangan syariah & manajemen kas rumah tangga.</li>\n              <li>Kelompok usaha bersama berbasis majelis taklim perempuan.</li>\n            </ul>\n          </div>\n          <div class=\"pilar-footer\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-pilar-action\">\n              <i class=\"fa-solid fa-heart\"></i> Dukung Usaha Ibu Tangguh\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <!-- ==========================================\n           PILAR 2: PENDIDIKAN GENERASI\n      ========================================== -->\n      <article class=\"pilar-card\">\n        <div class=\"pilar-img-container\">\n          <span class=\"pilar-badge-tag\"><i class=\"fa-solid fa-graduation-cap\"></i> Pilar 2: Pendidikan</span>\n          <!-- [GANTI FOTO PILAR 2 DISINI] -->\n          <img src=\"assets/programs/pilar-2-pendidikan.jpg\" alt=\"Pilar 2 - Pendidikan Generasi & Beasiswa Dhuafa\">\n        </div>\n        <div class=\"pilar-body\">\n          <h4 class=\"pilar-name\">Pendidikan Generasi & Beasiswa Anak Negeri</h4>\n          <p class=\"pilar-desc\">\n            Memastikan tidak ada anak mustahik yang terputus pendidikannya. Menyediakan beasiswa yatim dhuafa, ruang belajar ramah anak, dan sekolah darurat pascabencana.\n          </p>\n          <div class=\"pilar-points\">\n            <span class=\"pilar-points-title\">Fokus Intervensi:</span>\n            <ul>\n              <li>Beasiswa SPP & uang saku santri/pelajar yatim dhuafa.</li>\n              <li>Pendirian sekolah darurat tenda & pojok baca ceria di pelosok.</li>\n              <li>Distribusi paket perlengkapan sekolah lengkap & seragam baru.</li>\n            </ul>\n          </div>\n          <div class=\"pilar-footer\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-pilar-action\">\n              <i class=\"fa-solid fa-heart\"></i> Bantu Pendidikan Anak Dhuafa\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <!-- ==========================================\n           PILAR 3: KESEHATAN IBU & ANAK\n      ========================================== -->\n      <article class=\"pilar-card\">\n        <div class=\"pilar-img-container\">\n          <span class=\"pilar-badge-tag\"><i class=\"fa-solid fa-stethoscope\"></i> Pilar 3: Kesehatan</span>\n          <!-- [GANTI FOTO PILAR 3 DISINI] -->\n          <img src=\"assets/programs/pilar-3-kesehatan.jpg\" alt=\"Pilar 3 - Kesehatan Ibu & Balita Cegah Stunting\">\n        </div>\n        <div class=\"pilar-body\">\n          <h4 class=\"pilar-name\">Kesehatan Ibu, Balita & Pencegahan Stunting</h4>\n          <p class=\"pilar-desc\">\n            Intervensi nutrisi terpadu pada 1.000 Hari Pertama Kehidupan (HPK). Menjangkau balita wasting/stunting, pemeriksaan gizi ibu hamil, dan layanan kesehatan gratis dhuafa.\n          </p>\n          <div class=\"pilar-points\">\n            <span class=\"pilar-points-title\">Fokus Intervensi:</span>\n            <ul>\n              <li>Pemberian Makanan Tambahan (PMT) nutrisi tinggi balita.</li>\n              <li>Pemeriksaan USG & paket vitamin penambah darah ibu hamil.</li>\n              <li>Skrining medis lansia dhuafa & sosialisasi sanitasi higienis.</li>\n            </ul>\n          </div>\n          <div class=\"pilar-footer\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-pilar-action\">\n              <i class=\"fa-solid fa-heart\"></i> Donasi Nutrisi Ibu & Balita\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <!-- ==========================================\n           PILAR 4: KEMANUSIAAN & BENCANA\n      ========================================== -->\n      <article class=\"pilar-card\">\n        <div class=\"pilar-img-container\">\n          <span class=\"pilar-badge-tag\"><i class=\"fa-solid fa-shield-heart\"></i> Pilar 4: Kemanusiaan</span>\n          <!-- [GANTI FOTO PILAR 4 DISINI] -->\n          <img src=\"assets/programs/pilar-4-kemanusiaan.jpg\" alt=\"Pilar 4 - Kemanusiaan & Tanggap Darurat Bencana\">\n        </div>\n        <div class=\"pilar-body\">\n          <h4 class=\"pilar-name\">Tanggap Bencana & Perlindungan Keluarga</h4>\n          <p class=\"pilar-desc\">\n            Aksi cepat tanggap darurat bencana alam, kebakaran hutan, dan krisis sosial dengan pendekatan humanis ramah kebutuhan spesifik perempuan, bayi, serta lansia.\n          </p>\n          <div class=\"pilar-points\">\n            <span class=\"pilar-points-title\">Fokus Intervensi:</span>\n            <ul>\n              <li>Dapur umum higienis khusus gizi balita & ibu menyusui di posko.</li>\n              <li>Distribusi hygiene kit perempuan, popok, susu, dan sembako darurat.</li>\n              <li>Bantuan tabung oksigen, masker medis, dan posko karhutla.</li>\n            </ul>\n          </div>\n          <div class=\"pilar-footer\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-pilar-action\">\n              <i class=\"fa-solid fa-heart\"></i> Salurkan Bantuan Kemanusiaan\n            </a>\n          </div>\n        </div>\n      </article>\n\n      <!-- ==========================================\n           PILAR 5: DAKWAH & KETAHANAN KELUARGA\n      ========================================== -->\n      <article class=\"pilar-card\">\n        <div class=\"pilar-img-container\">\n          <span class=\"pilar-badge-tag\"><i class=\"fa-solid fa-mosque\"></i> Pilar 5: Dakwah & Advokasi</span>\n          <!-- [GANTI FOTO PILAR 5 DISINI] -->\n          <img src=\"assets/programs/pilar-5-dakwah-keluarga.jpg\" alt=\"Pilar 5 - Dakwah & Ketahanan Keluarga Sakinah\">\n        </div>\n        <div class=\"pilar-body\">\n          <h4 class=\"pilar-name\">Ketahanan Keluarga Sakinah & Syiar Islam</h4>\n          <p class=\"pilar-desc\">\n            Membangun keluarga sakinah, mawaddah, warahmah melalui penguatan spiritual ibu, pembinaan majelis taklim terpencil, konseling keluarga Islami, dan advokasi perempuan.\n          </p>\n          <div class=\"pilar-points\">\n            <span class=\"pilar-points-title\">Fokus Intervensi:</span>\n            <ul>\n              <li>Binaan majelis taklim ibu-ibu & pemberantasan buta aksara Qur'an.</li>\n              <li>Pusat konseling parenting Islami & mediasi ketahanan rumah tangga.</li>\n              <li>Advokasi hak hukum perempuan dhuafa & sosialisasi zakat produktif.</li>\n            </ul>\n          </div>\n          <div class=\"pilar-footer\">\n            <a href=\"tunaikan-zakat.html\" class=\"btn-pilar-action\">\n              <i class=\"fa-solid fa-heart\"></i> Dukung Dakwah & Keluarga Sakinah\n            </a>\n          </div>\n        </div>\n      </article>\n\n    </div>\n\n  </div>\n</section>\n"
              }
            }
          ]
        }
      ]
    }
  ]
}